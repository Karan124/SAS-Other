    lines += ["Red Flags:"]
    for r in auto_data.get("red_flags", []):
        lines.append(f"  {r}")

    lines += ["", "MANUAL / MANUAL-AUTOMATED POPULATION DESIGN PRINCIPLES:"]
    man_data = CT_PRINCIPLES.get(ct_ref, FALLBACK_PRINCIPLES).get(
        "manual", FALLBACK_PRINCIPLES["manual"])
    for p in man_data.get("principles", []):
        lines.append(f"  {p}")
    lines += ["Red Flags:"]
    for r in man_data.get("red_flags", []):
        lines.append(f"  {r}")

    lines += ["", f"CONTROLS TO ASSESS ({n}):", ""]

    for _, row in sub_controls.iterrows():
        lines.append("─" * 60)
        lines.append(str(row.get("llm_payload_text", "") or
                         f"Control_ID: {row['Control_ID']}"))
        lines.append("")

    lines += [
        "─" * 60, "",
        "RESPONSE FORMAT — return this JSON exactly. No markdown.",
        "",
        '{',
        '  "scope_id": "<scope_id>",',
        '  "batch_key": "<batch_key>",',
        '  "pass": 1,',
        '  "control_assessments": [',
        '    {',
        '      "control_id": "<Control_ID>",',
        '      "control_name": "<CTRL_NAME>",',
        '      "control_nature": "<Preventative|Detective|other value from Nature / CTRL_NATRE field>",',
        '      "control_type": "<Automated|Manual|Manual-Automated — from Type / CTRL_TYP field>",',
        '      "population": "<Automated|Manual>",',
        '      "objective_alignment": "<High|Moderate|Low — how directly does the control perform the CT activity>",',
        '      "nature_alignment": "<Aligned|Partially Aligned|Not Aligned — vs expected CT nature>",',
        '      "design_strength": "<Strong|Moderate|Basic|Limited>",',
        '      "design_principles_evaluation": [',
        '        {"principle": "1", "met": "<Met|Partially Met|Not Met|Not Evidenced>", "note": "..."}',
        '      ],',
        '      "red_flags_identified": ["<red flag text if present>"],',
        '      "n_linked_products": <integer from linkage metrics>,',
        '      "n_linked_apps": <integer from linkage metrics>,',
        '      "n_linked_processes": <integer from linkage metrics>,',
        '      "rationale": "<2-3 sentences citing specific evidence>"',
        '    }',
        '  ]',
        '}',
        "",
        f'Use scope_id: "{scope_id}" and batch_key: "{batch_key}".',
    ]
    return "\n".join(lines)


