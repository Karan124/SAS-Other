def build_within_product_prompt(scope_id: str,
                                batch_key: str,
                                n_total_controls: int,
                                sub_controls: pd.DataFrame,
                                scope_meta: dict) -> str:
    product  = scope_meta.get("Product", "")
    pay_cat  = scope_meta.get("Payment Category", "")
    stage    = scope_meta.get("Consolidated Stage", "")
    ct_ref   = scope_meta.get("ct_ref_norm", "") or scope_meta.get("Expected CT Reference", "")
    exp_ctrl = scope_meta.get("Expected Control", "")
    n        = len(sub_controls)

    sub_note = ""
    if n < n_total_controls:
        sub_note = (
            f"\nNOTE: This is a sub-batch of {n} controls from a larger group of "
            f"{n_total_controls} controls sharing this scope. Assess for duplicates "
            f"and fragmentation within this sub-batch only."
        )

    lines = [
        "SCOPE CONTEXT",
        f"Scope type      : Within-Product Assessment",
        f"Scope ID        : {scope_id}",
        f"Product         : {product}",
        f"Payment Category: {pay_cat}",
        f"Lifecycle Stage : {stage}",
        f"Expected CT Ref : {ct_ref}",
        f"Expected Control: {exp_ctrl}",
        sub_note,
        "",
        f"CONTROLS TO ASSESS ({n} controls):",
        "",
    ]

    for _, row in sub_controls.iterrows():
        lines.append("─" * 60)
        lines.append(build_short_control_text(row))
        lines.append("")

    lines += [
        "─" * 60,
        "",
        "TASK — WITHIN-PRODUCT ASSESSMENT",
        "All controls above share the same Product, Payment Category,",
        "Lifecycle Stage, and Expected CT Reference.",
        "Compare each control against all others in this sub-batch.",
        "Assess for Redundant Controls, Process-Split Fragmentation, and",
        "Common Control Opportunities. Focus on underlying control objective,",
        "activity, and risk outcome — not surface wording differences.",
        "",
        CLASSIFICATION_DEFINITIONS,
        "",
        RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_key: "{batch_key}" in your response.',
    ]
    return "\n".join(lines)


def build_cross_product_prompt(scope_id: str,
                               batch_key: str,
                               n_total_controls: int,
                               sub_controls: pd.DataFrame,
                               ct_ref: str) -> str:
    n        = len(sub_controls)
    products = sub_controls["Product"].dropna().unique().tolist() \
               if "Product" in sub_controls.columns else []

    sub_note = ""
    if n < n_total_controls:
        sub_note = (
            f"\nNOTE: This is a sub-batch of {n} controls from a larger group of "
            f"{n_total_controls} controls in this CT Reference group. Assess for "
            f"duplicates and common control opportunities within this sub-batch only."
        )

    lines = [
        "SCOPE CONTEXT",
        f"Scope type      : Cross-Product Assessment",
        f"Scope ID        : {scope_id}",
        f"CT Reference    : {ct_ref}",
        f"Products covered: {', '.join(products[:10])}",
        sub_note,
        "",
        f"CONTROLS TO ASSESS ({n} controls across multiple products):",
        "",
    ]

    for _, row in sub_controls.iterrows():
        lines.append("─" * 60)
        lines.append(build_short_control_text(row))
        lines.append("")

    lines += [
        "─" * 60,
        "",
        "TASK — CROSS-PRODUCT ASSESSMENT WITHIN CONTROL OBJECTIVE GROUP",
        "These controls share the same CT Reference (Control Objective Group)",
        "but come from different products and may be owned by different",
        "business areas. Do NOT compare controls across different Control",
        "Objective Groups.",
        "Assess for: Redundant Controls across products, Process-Split",
        "Fragmentation, and Common Control Opportunities where similar controls",
        "operate independently across products and could be consolidated.",
        "Focus on underlying objective, activity, and risk outcome — not",
        "wording, ownership, system, or product differences.",
        "",
        CLASSIFICATION_DEFINITIONS,
        "",
        RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_key: "{batch_key}" in your response.',
    ]
    return "\n".join(lines)


