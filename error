def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force",    action="store_true",
                        help="Clear checkpoints and reprocess everything.")
    parser.add_argument("--wp-only",  action="store_true",
                        help="Within-product scopes only.")
    parser.add_argument("--cp-only",  action="store_true",
                        help="Cross-product scopes only.")
    parser.add_argument("--wp-range", nargs=2, type=int,
                        metavar=("START", "END"),
                        help="Process only WP scopes[START:END]. e.g. --wp-range 0 107")
    parser.add_argument("--cp-range", nargs=2, type=int,
                        metavar=("START", "END"),
                        help="Process only CP scopes[START:END].")
    parser.add_argument("--suffix",   default="",
                        help="Checkpoint file suffix for parallel runs. e.g. --suffix _p2")
    args = parser.parse_args()

    log = get_logger()
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 3: LLM Assessment")
    log.info(f"  Model           : {LLM_MODEL} (low reasoning)")
    log.info(f"  Sub-batch size  : {SUB_BATCH_SIZE} controls per call")
    log.info(f"  Client strategy : fresh connection per attempt")
    log.info(f"  Started         : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    for f in [EXPANDED_PARQUET, SCOPE_WP_PARQUET, SCOPE_CP_PARQUET,
              CAND_WP_PARQUET, CAND_CP_PARQUET, RUN_CONFIG]:
        if not f.exists():
            log.error(f"Required input not found: {f.name}. "
                      f"Run Scripts 1 and 2 first.")
            sys.exit(1)

    with open(RUN_CONFIG) as f:
        config = json.load(f)

    run_wp = config.get("run_within_product", True) and not args.cp_only
    run_cp = config.get("run_cross_product",  True) and not args.wp_only

    # Checkpoint paths — suffix enables parallel runs writing separate files
    ck_wp = OUTPUT_DIR / f"llm_checkpoint_within_product{args.suffix}.jsonl"
    ck_cp = OUTPUT_DIR / f"llm_checkpoint_cross_product{args.suffix}.jsonl"

    if args.force:
        for ck in [ck_wp, ck_cp]:
            if ck.exists():
                ck.unlink()
                log.info(f"Checkpoint cleared: {ck.name}")

    log.info("Loading data...")
    expanded = pd.read_parquet(EXPANDED_PARQUET, engine="pyarrow")
    log.info(f"  Expanded rows: {len(expanded):,}")

    # Warm up — verify connectivity before starting the main loop
    log.info("Verifying connectivity (test client)...")
    try:
        _ = make_client()
        log.info("  Connectivity OK.")
    except Exception as e:
        log.error(f"  Cannot create client: {e}")
        sys.exit(1)

    total_cost = 0.0

    if run_wp:
        log.info("\nProcessing within-product scopes...")
        scope_wp = pd.read_parquet(SCOPE_WP_PARQUET, engine="pyarrow")
        pairs_wp = pd.read_parquet(CAND_WP_PARQUET, engine="pyarrow")
        done_wp  = load_checkpoint(ck_wp)
        log.info(f"  Total WP scopes : {len(scope_wp):,} | "
                 f"Done keys in checkpoint: {len(done_wp):,}")
        if args.wp_range:
            s, e = args.wp_range
            scope_wp = scope_wp.iloc[s:e].reset_index(drop=True)
            log.info(f"  Sliced to scopes {s}:{e} ({len(scope_wp):,} scopes)")
        cost = process_scopes("within_product", scope_wp, pairs_wp,
                              expanded, ck_wp, done_wp, log)
        total_cost += cost

    if run_cp:
        log.info("\nProcessing cross-product scopes...")
        scope_cp = pd.read_parquet(SCOPE_CP_PARQUET, engine="pyarrow")
        pairs_cp = pd.read_parquet(CAND_CP_PARQUET, engine="pyarrow")
        done_cp  = load_checkpoint(ck_cp)
        log.info(f"  Total CP scopes : {len(scope_cp):,} | "
                 f"Done keys in checkpoint: {len(done_cp):,}")
        if args.cp_range:
            s, e = args.cp_range
            scope_cp = scope_cp.iloc[s:e].reset_index(drop=True)
            log.info(f"  Sliced to scopes {s}:{e} ({len(scope_cp):,} scopes)")
        cost = process_scopes("cross_product", scope_cp, pairs_cp,
                              expanded, ck_cp, done_cp, log)
        total_cost += cost

    config[f"step3{args.suffix}_completed_at"]   = datetime.now().isoformat()
    config[f"step3{args.suffix}_total_cost_aud"] = round(total_cost, 2)
    config[f"step3{args.suffix}_sub_batch_size"] = SUB_BATCH_SIZE
    with open(RUN_CONFIG, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)

    log.info("=" * 70)
    log.info(f"  Step 3 complete. Total cost: A${total_cost:.2f}")
    log.info("  Run 04_postprocess_outputs.py next.")
    log.info("=" * 70)


if __name__ == "__main__":
    main()
