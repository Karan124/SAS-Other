def write_excel(ct_results, output_path, log):
    wb = Workbook()
    wb.remove(wb.active)  # remove default sheet

    # Colours
    BLUE_FILL   = PatternFill("solid", fgColor="1F4E79")
    GREEN_FILL  = PatternFill("solid", fgColor="375623")
    ORANGE_FILL = PatternFill("solid", fgColor="BF5B20")
    GREY_FILL   = PatternFill("solid", fgColor="D6DCE4")
    LIGHT_BLUE  = PatternFill("solid", fgColor="DEEAF1")
    LIGHT_GREEN = PatternFill("solid", fgColor="E2EFDA")
    WHITE_FONT  = Font(bold=True, color="FFFFFF")
    BOLD        = Font(bold=True)
    WRAP        = Alignment(wrap_text=True, vertical="top")
    CENTER      = Alignment(horizontal="center", vertical="top")
    THIN        = Border(
        left=Side(style="thin"), right=Side(style="thin"),
        top=Side(style="thin"), bottom=Side(style="thin")
    )

    def hdr(ws, row, col, text, fill=BLUE_FILL, font=WHITE_FONT):
        c = ws.cell(row=row, column=col, value=text)
        c.fill = fill; c.font = font; c.alignment = CENTER
        c.border = THIN
        return c

    def cell(ws, row, col, text, fill=None, bold=False, wrap=True):
        c = ws.cell(row=row, column=col, value=str(text) if text is not None else "")
        if fill: c.fill = fill
        if bold: c.font = BOLD
        c.alignment = WRAP if wrap else Alignment(vertical="top")
        c.border = THIN
        return c

    def ds_emoji(ds):
        return DESIGN_STRENGTH_EMOJI.get(str(ds), str(ds))

    summary_rows = []

    for ct_data in sorted(ct_results, key=lambda x: x["ct_ref"]):
        ct_ref = ct_data["ct_ref"]
        ws     = wb.create_sheet(title=ct_ref[:31])
        row    = 1

        # ── Title ─────────────────────────────────────────────────────────────
        ws.merge_cells(start_row=row, start_column=1,
                       end_row=row, end_column=13)
        c = ws.cell(row=row, column=1,
                    value=f"CONTROL OBJECTIVE GROUP: {ct_ref}")
        c.font = Font(bold=True, size=14, color="1F4E79")
        c.alignment = Alignment(horizontal="left")
        ws.row_dimensions[row].height = 25
        row += 1

        c2 = ws.cell(row=row, column=1,
                     value=f"Total controls assessed: {ct_data['n_controls']}")
        c2.font = Font(italic=True, color="595959")
        row += 2

        # ── Best of Breed Summary ─────────────────────────────────────────────
        ws.merge_cells(start_row=row, start_column=1,
                       end_row=row, end_column=10)
        c = ws.cell(row=row, column=1, value="BEST-OF-BREED SUMMARY")
        c.font = Font(bold=True, size=12, color="FFFFFF")
        c.fill = GREEN_FILL
        c.alignment = CENTER
        ws.row_dimensions[row].height = 18
        row += 1

        for label, bob in [
            ("Automated Population", ct_data.get("auto_bob")),
            ("Manual / Manual-Automated Population", ct_data.get("man_bob")),
        ]:
            hdr(ws, row, 1, label, GREY_FILL, BOLD)
            for col in range(2, 11):
                ws.cell(row=row, column=col).fill = GREY_FILL
            ws.merge_cells(start_row=row, start_column=1,
                           end_row=row, end_column=10)
            row += 1

            if bob:
                hdr(ws, row, 1, "Control ID", LIGHT_BLUE, BOLD)
                hdr(ws, row, 2, "Control Nature", LIGHT_BLUE, BOLD)
                hdr(ws, row, 3, "Design Strength", LIGHT_BLUE, BOLD)
                hdr(ws, row, 4, "Coverage", LIGHT_BLUE, BOLD)
                hdr(ws, row, 5, "Rationale", LIGHT_BLUE, BOLD)
                ws.merge_cells(start_row=row, start_column=5,
                               end_row=row, end_column=10)
                row += 1
                cell(ws, row, 1, bob.get("control_id",""))
                cell(ws, row, 2, bob.get("control_nature",""))
                cell(ws, row, 3, ds_emoji(bob.get("design_strength","")))
                cell(ws, row, 4, bob.get("coverage_summary",""))
                cell(ws, row, 5, bob.get("rationale",""))
                ws.merge_cells(start_row=row, start_column=5,
                               end_row=row, end_column=10)
                ws.row_dimensions[row].height = 60
            else:
                ws.cell(row=row, column=1,
                        value="No controls in this population")
            row += 2

        # ── Ranked Controls ───────────────────────────────────────────────────
        for pop_label, ranked, fill in [
            ("AUTOMATED POPULATION — RANKED CONTROLS", ct_data["auto_ranked"], LIGHT_BLUE),
            ("MANUAL / MANUAL-AUTOMATED POPULATION — RANKED CONTROLS",
             ct_data["man_ranked"], LIGHT_GREEN),
        ]:
            if not ranked:
                continue

            ws.merge_cells(start_row=row, start_column=1,
                           end_row=row, end_column=10)
            c = ws.cell(row=row, column=1, value=pop_label)
            c.font = Font(bold=True, size=11, color="FFFFFF")
            c.fill = BLUE_FILL
            c.alignment = CENTER
            ws.row_dimensions[row].height = 18
            row += 1

            cols = ["Rank","Control ID","Control Name","Control Type",
                    "Control Nature","Obj. Alignment","Nature Alignment",
                    "Design Strength","Coverage","Best of Breed?",
                    "Ranking Rationale","Rationale","Effectiveness Ratings"]
            for ci, col_name in enumerate(cols, 1):
                hdr(ws, row, ci, col_name, GREY_FILL, BOLD)
            row += 1

            for r in ranked:
                ds       = ds_emoji(r.get("design_strength",""))
                is_bob   = "✓ Best of Breed" if r.get("is_best_of_breed") else ""
                rtgs     = (f"Assess: {r.get('ctrl_assess_rtng','')} | "
                            f"OE: {r.get('ctrl_oe_rtng','')} | "
                            f"DE: {r.get('ctrl_de_rtng','')}")
                ctrl_type  = r.get("control_type","") or r.get("control_nature","")
                obj_align  = r.get("objective_alignment","")
                nat_align  = r.get("nature_alignment","")
                row_fill   = fill if r.get("is_best_of_breed") else None

                cell(ws, row, 1,  r.get("rank",""),         row_fill)
                cell(ws, row, 2,  r.get("control_id",""),   row_fill, bold=True)
                cell(ws, row, 3,  r.get("control_name",""), row_fill)
                cell(ws, row, 4,  ctrl_type,                row_fill)
                cell(ws, row, 5,  r.get("control_nature",""), row_fill)
                cell(ws, row, 6,  obj_align,                row_fill)
                cell(ws, row, 7,  nat_align,                row_fill)
                cell(ws, row, 8,  ds,                       row_fill)
                cell(ws, row, 9,  r.get("coverage_summary",""), row_fill)
                cell(ws, row, 10, is_bob,                   row_fill, bold=bool(is_bob))
                cell(ws, row, 11, r.get("ranking_rationale",""), row_fill)
                cell(ws, row, 12, r.get("rationale",""),    row_fill)
                cell(ws, row, 13, rtgs,                     row_fill)
                ws.row_dimensions[row].height = 80
                row += 1

            row += 1

        # ── Design Principles Detail ──────────────────────────────────────────
        design_principle_columns = set()
        overall_comments_columns = set()
        for population, label, ranked in [
            ("Automated", "AUTOMATED", ct_data["auto_ranked"]),
            ("Manual", "MANUAL / MANUAL-AUTOMATED", ct_data["man_ranked"]),
        ]:
            controls = [
                control for control in ranked
                if control.get("design_principles_evaluation")
            ]
            if not controls:
                continue

            principle_headers = []
            principle_columns = {}
            for control in controls:
                for dp in control["design_principles_evaluation"]:
                    principle = str(dp.get("principle", "")).strip()
                    principle_name = CT4_DESIGN_PRINCIPLES.get(
                        population, {}
                    ).get(principle, principle)
                    if principle_name and principle_name not in principle_columns:
                        principle_columns[principle_name] = len(principle_headers) + 2
                        principle_headers.append(principle_name)

            end_column = len(principle_headers) + 2
            ws.merge_cells(start_row=row, start_column=1,
                           end_row=row, end_column=end_column)
            c = ws.cell(
                row=row, column=1,
                value=f"DESIGN PRINCIPLES EVALUATION DETAIL — {label}"
            )
            c.font = Font(bold=True, size=11, color="FFFFFF")
            c.fill = ORANGE_FILL
            c.alignment = CENTER
            row += 1

            hdr(ws, row, 1, "Control ID", GREY_FILL, BOLD)
            for principle_name, column in principle_columns.items():
                hdr(ws, row, column, principle_name, GREY_FILL, BOLD)
            hdr(ws, row, end_column, "Overall Comments", GREY_FILL, BOLD)
            design_principle_columns.update(principle_columns.values())
            overall_comments_columns.add(end_column)
            row += 1

            for control in controls:
                cell(ws, row, 1, control.get("control_id", ""), bold=True)
                comments = []
                for dp in control["design_principles_evaluation"]:
                    principle = str(dp.get("principle", "")).strip()
                    principle_name = CT4_DESIGN_PRINCIPLES.get(
                        population, {}
                    ).get(principle, principle)
                    column = principle_columns.get(principle_name)
                    if column:
                        cell(ws, row, column, dp.get("met", ""))
                    note = str(dp.get("note", "")).strip()
                    if note:
                        comments.append(f"{principle_name}: {note}")
                red_flags = control.get("red_flags_identified") or []
                if red_flags:
                    comments.append(f"Red flags: {'; '.join(red_flags)}")
                cell(ws, row, end_column, "\n".join(comments))
                ws.row_dimensions[row].height = 90
                row += 1
            row += 1

        # ── Fragmentation ─────────────────────────────────────────────────────
        if ct_data["fragmentation"]:
            ws.merge_cells(start_row=row, start_column=1,
                           end_row=row, end_column=7)
            c = ws.cell(row=row, column=1, value="FRAGMENTATION FINDINGS")
            c.font = Font(bold=True, size=11, color="FFFFFF")
            c.fill = ORANGE_FILL
            c.alignment = CENTER
            row += 1

            for ci, col_name in enumerate(
                ["Group ID","Type","Control IDs","Rationale",
                 "End-to-End Description","Confidence"], 1):
                hdr(ws, row, ci, col_name, GREY_FILL, BOLD)
            row += 1

            for fg in ct_data["fragmentation"]:
                cell(ws, row, 1, fg.get("group_id",""))
                cell(ws, row, 2, fg.get("type",""))
                cell(ws, row, 3, "; ".join(fg.get("control_ids") or []))
                cell(ws, row, 4, fg.get("rationale",""))
                cell(ws, row, 5, fg.get("end_to_end_description",""))
                cell(ws, row, 6, fg.get("confidence",""))
                ws.row_dimensions[row].height = 80
                row += 1
            row += 1

        # ── Redundancy ────────────────────────────────────────────────────────
        if ct_data["redundancy"]:
            ws.merge_cells(start_row=row, start_column=1,
                           end_row=row, end_column=5)
            c = ws.cell(row=row, column=1, value="REDUNDANCY FINDINGS")
            c.font = Font(bold=True, size=11, color="FFFFFF")
            c.fill = BLUE_FILL
            c.alignment = CENTER
            row += 1

            for ci, col_name in enumerate(
                ["Control ID","Covered By Control IDs",
                 "Rationale","Confidence"], 1):
                hdr(ws, row, ci, col_name, GREY_FILL, BOLD)
            row += 1

            for rd in ct_data["redundancy"]:
                cell(ws, row, 1, rd.get("control_id",""))
                cell(ws, row, 2,
                     "; ".join(rd.get("covered_by_control_ids") or []))
                cell(ws, row, 3, rd.get("rationale",""))
                cell(ws, row, 4, rd.get("confidence",""))
                ws.row_dimensions[row].height = 60
                row += 1

        # Set column widths
        col_widths = [6,16,28,18,18,16,18,18,28,14,35,35,22]
        for i, w in enumerate(col_widths, 1):
            ws.column_dimensions[get_column_letter(i)].width = w
        for column in design_principle_columns:
            ws.column_dimensions[get_column_letter(column)].width = 24
        for column in overall_comments_columns:
            ws.column_dimensions[get_column_letter(column)].width = 45

        # Summary row
        summary_rows.append({
            "CT Group":           ct_ref,
            "Controls Assessed":  ct_data["n_controls"],
            "Auto Best-of-Breed": ct_data.get("auto_bob",{}).get("control_id","") if ct_data.get("auto_bob") else "",
            "Manual Best-of-Breed": ct_data.get("man_bob",{}).get("control_id","") if ct_data.get("man_bob") else "",
            "Fragmentation Groups": len(ct_data["fragmentation"]),
            "Redundant Controls":   len(ct_data["redundancy"]),
        })

    # ── Summary sheet ─────────────────────────────────────────────────────────
    if summary_rows:
        ws_sum = wb.create_sheet(title="Summary", index=0)
        ws_sum.sheet_view.showGridLines = False
        ws_sum.merge_cells("A1:F1")
        c = ws_sum.cell(row=1, column=1,
                        value="CONTROL RATIONALISATION — DIMENSION 2 SUMMARY")
        c.font = Font(bold=True, size=14, color="1F4E79")
        c.alignment = Alignment(horizontal="left")

        headers = list(summary_rows[0].keys())
        for ci, h in enumerate(headers, 1):
            hdr(ws_sum, 2, ci, h)
        for ri, row_data in enumerate(summary_rows, 3):
            for ci, key in enumerate(headers, 1):
                cell(ws_sum, ri, ci, row_data[key])

        for i, w in enumerate([12,20,25,25,22,22], 1):
            ws_sum.column_dimensions[get_column_letter(i)].width = w

    wb.save(output_path)
    log.info(f"Saved: {output_path.name} "
             f"({len(wb.sheetnames)} sheets)")

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--suffix", default="",
                        help="Process checkpoints with this suffix. "
                             "e.g. --suffix _sample")
    args = parser.parse_args()

    log = setup_logging()
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 4 (Dimension 2: Gold Controls)")
    log.info(f"  Started: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    if not HAS_OPENPYXL:
        log.error("openpyxl not installed. Run: pip install openpyxl")
        sys.exit(1)
    if not EXPANDED.exists():
        log.error("expanded_ct_control_mapping.parquet not found.")
        sys.exit(1)

    # Checkpoint files to read
    if args.suffix:
        p1_files = [f"llm_checkpoint_ct_pass1{args.suffix}.jsonl"]
        p2_files = [f"llm_checkpoint_ct_pass2{args.suffix}.jsonl"]
    else:
        p1_files = ALL_P1_FILES
        p2_files = ALL_P2_FILES

    output_path = OUTPUT_DIR / f"ct_assessment{args.suffix}.xlsx"

    # Load expanded parquet for control details
    log.info("Loading control details...")
    expanded = pd.read_parquet(EXPANDED, engine="pyarrow")
    ctrl_lookup = (
        expanded.drop_duplicates(subset=["Control_ID"], keep="first")
        .set_index("Control_ID")
        .to_dict("index")
    )
    log.info(f"  {len(ctrl_lookup):,} unique controls loaded")

    # Load checkpoints
    log.info("Loading checkpoints...")
    p1_data = load_pass1(p1_files, log)
    p2_data = load_pass2(p2_files, log)

    if not p2_data:
        log.error("No Pass 2 results found. Ensure Script 3 completed.")
        sys.exit(1)

    # Build per-CT data
    log.info("Building CT assessment data...")
    ct_results = []
    for scope_id, p2_rec in p2_data.items():
        ct_data = build_ct_data(scope_id, p1_data, p2_data, ctrl_lookup)
        ct_results.append(ct_data)
        log.info(f"  {scope_id}: "
                 f"auto={len(ct_data['auto_ranked'])} ranked, "
                 f"manual={len(ct_data['man_ranked'])} ranked, "
                 f"frag={len(ct_data['fragmentation'])}, "
                 f"redundant={len(ct_data['redundancy'])}")

    # Write Excel
    log.info(f"\nWriting Excel: {output_path.name}")
    write_excel(ct_results, output_path, log)

    log.info("=" * 70)
    log.info(f"  Step 4 complete.")
    log.info(f"  Output: {output_path}")
    log.info("=" * 70)

if __name__ == "__main__":
    main()
