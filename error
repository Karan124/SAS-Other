def get_principles_text(ct_ref, population):
    """Return formatted design principles for a CT group and population."""
    ct_data  = CT_PRINCIPLES.get(ct_ref, FALLBACK_PRINCIPLES)
    pop_data = ct_data.get(population, ct_data.get("manual", {}))
    principles = pop_data.get("principles", [])
    red_flags  = pop_data.get("red_flags", [])
    obj  = ct_data.get("objective", "")
    nat  = ct_data.get("expected_nature", "")

    lines = [
        f"CONTROL OBJECTIVE: {ct_ref}",
        f"Objective: {obj}",
        f"Expected Control Nature: {nat}",
        "",
        f"BEST CONTROL DESIGN PRINCIPLES ({population.upper()} POPULATION):",
    ]
    for p in principles:
        lines.append(f"  {p}")
    lines += ["", "RED FLAGS (Weak Design):"]
    for r in red_flags:
        lines.append(f"  {r}")
    return "\n".join(lines)


