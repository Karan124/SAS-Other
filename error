import json
import logging
import sys
from datetime import datetime
from pathlib import Path

import pandas as pd

# ─────────────────────────────────────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────────────────────────────────────

OUTPUT_DIR   = Path(r"C:\Users\M061400\ai-test\big_table\duplicates\product\output")
EXPANDED     = OUTPUT_DIR / "expanded_product_control_mapping.parquet"
OUTPUT_WB1   = OUTPUT_DIR / "within_product_assessment.xlsx"
OUTPUT_WB2   = OUTPUT_DIR / "assessment_summary.xlsx"

# Classification priority — higher index = more substantive finding
CLASSIFICATION_PRIORITY = {
    "Redundant":                    5,
    "Process-Split Fragmentation":  4,
    "Common Control Opportunity":   3,
    "Unclear":                      2,
    "Retain":                       1,
    "":                             0,
}

ALL_CHECKPOINT_FILES = [
    "llm_checkpoint_within_product.jsonl",
    "llm_checkpoint_within_product_sample.jsonl",
    "llm_checkpoint_within_product_p1.jsonl",
    "llm_checkpoint_within_product_p2.jsonl",
    "llm_checkpoint_within_product_p3.jsonl",
    "llm_checkpoint_within_product_p4.jsonl",
]

# ─────────────────────────────────────────────────────────────────────────────
#  LOGGING
# ─────────────────────────────────────────────────────────────────────────────

def setup_logging():
    logger = logging.getLogger("ctrl_rat_post")
    if logger.handlers:
        return logger
    fh = logging.FileHandler(OUTPUT_DIR / "processing_log.txt",
                             encoding="utf-8")
    ch = logging.StreamHandler(sys.stdout)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s",
                            datefmt="%Y-%m-%d %H:%M:%S")
    fh.setFormatter(fmt); ch.setFormatter(fmt)
    fh.setLevel(logging.DEBUG); ch.setLevel(logging.INFO)
    logger.addHandler(fh); logger.addHandler(ch)
    logger.setLevel(logging.DEBUG)
    return logger

# ─────────────────────────────────────────────────────────────────────────────
#  LOAD CHECKPOINTS
# ─────────────────────────────────────────────────────────────────────────────

def load_checkpoints(checkpoint_files, log):
    """
    Read all checkpoint files and return a flat list of assessment records.
    Each record contains scope_id, product, and the full assessment dict.
    """
    records = []
    n_files = n_errors = n_skipped = 0

    for fname in checkpoint_files:
        path = OUTPUT_DIR / fname
        if not path.exists():
            continue
        n_files += 1
        log.info(f"  Reading: {fname}")

        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    n_errors += 1
                    continue

                if rec.get("skipped"):
                    n_skipped += 1
                    continue
                if rec.get("error"):
                    n_errors += 1
                    continue

                scope_id  = rec.get("scope_id", "")
                batch_key = rec.get("batch_key", "")
                product   = rec.get("product", "")
                if not product:
                    parts   = scope_id.split("|")
                    product = parts[1] if len(parts) >= 2 else ""

                for a in rec.get("assessments", []):
                    ctrl_id = a.get("control_id", "")
                    if not ctrl_id:
                        continue
                    records.append({
                        "scope_id":  scope_id,
                        "product":   product,
                        "batch_key": batch_key,
                        "source":    fname,
                        **a,
                    })

    log.info(f"  Files read: {n_files} | "
             f"Errors/skipped: {n_errors}/{n_skipped} | "
             f"Raw assessment rows: {len(records):,}")
    return records

# ─────────────────────────────────────────────────────────────────────────────
#  DEDUPLICATE
# ─────────────────────────────────────────────────────────────────────────────

def deduplicate(records, log):
    """
    Where the same control appears in multiple sub-batches, keep the most
    substantive classification using CLASSIFICATION_PRIORITY.
    Deduplication key: (scope_id, control_id).
    """
    best: dict[tuple, dict] = {}

    for rec in records:
        key  = (rec["scope_id"], rec.get("control_id", ""))
        clf  = rec.get("classification", "")
        pri  = CLASSIFICATION_PRIORITY.get(clf, 0)

        if key not in best:
            best[key] = rec
        else:
            existing_pri = CLASSIFICATION_PRIORITY.get(
                best[key].get("classification", ""), 0)
            if pri > existing_pri:
                best[key] = rec
            elif pri == existing_pri and clf not in ("Retain", ""):
                # Same priority — keep the one with higher confidence
                conf_rank = {"High": 3, "Medium": 2, "Low": 1, "": 0}
                if (conf_rank.get(rec.get("confidence",""), 0) >
                        conf_rank.get(best[key].get("confidence",""), 0)):
                    best[key] = rec

    deduped = list(best.values())
    n_deduped = len(records) - len(deduped)
    if n_deduped:
        log.info(f"  Deduplicated {n_deduped:,} duplicate assessment rows")
    log.info(f"  Final unique assessments: {len(deduped):,}")
    return deduped

# ─────────────────────────────────────────────────────────────────────────────
#  COVERAGE CHECK
# ─────────────────────────────────────────────────────────────────────────────

def check_coverage(deduped, expanded_df, log):
    """
    Compare assessed controls against all controls in the expanded parquet.
    Return a DataFrame flagging any controls with no assessment.
    """
    assessed = {(r["scope_id"], r.get("control_id","")) for r in deduped}

    missing_rows = []
    for _, row in expanded_df.iterrows():
        key = (row["scope_id"], row["Control_ID"])
        if key not in assessed:
            missing_rows.append({
                "scope_id":   row["scope_id"],
                "Product":    row["Product"],
                "Control_ID": row["Control_ID"],
                "CTRL_NAME":  row.get("CTRL_NAME", ""),
                "issue":      "No assessment in any checkpoint",
            })

    if missing_rows:
        log.warning(f"  {len(missing_rows):,} controls with no assessment found")
    else:
        log.info("  Coverage check: all controls have at least one assessment ✓")

    return pd.DataFrame(missing_rows)

# ─────────────────────────────────────────────────────────────────────────────
#  BUILD OUTPUT DATAFRAME
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
#  GROUP ID RECONCILIATION
#  Within each scope, two sub-batches can independently assign the same
#  group ID (e.g. both assign P-1) to genuinely different groups.
#  This function detects independent groups using union-find and renumbers
#  them sequentially: P-1, P-2 ... CC-1, CC-2 ... R-1, R-2 ...
# ─────────────────────────────────────────────────────────────────────────────

def _find(parent, x):
    if parent[x] != x:
        parent[x] = _find(parent, parent[x])
    return parent[x]


def _union(parent, x, y):
    px, py = _find(parent, x), _find(parent, y)
    if px != py:
        parent[px] = py


def reconcile_group_ids(df: pd.DataFrame) -> pd.DataFrame:
    """
    For each product scope, identify truly independent rationalisation groups
    using union-find on the Grouped Control IDs column, then renumber them
    sequentially within their classification type.

    Input groups: two sub-batches might both produce P-1 for unrelated groups.
    Output groups: first independent group = P-1, second = P-2, etc.
    """
    prefixes = {
        "Redundant":                   "R",
        "Process-Split Fragmentation": "P",
        "Common Control Opportunity":  "CC",
    }

    result_parts = []

    for scope_id, scope_df in df.groupby("Scope ID", sort=False):
        scope_df = scope_df.copy().reset_index(drop=True)

        for clf_type, prefix in prefixes.items():
            mask    = scope_df["Classification"] == clf_type
            indices = scope_df.index[mask].tolist()
            if not indices:
                continue

            ctrl_ids = scope_df.loc[indices, "Control ID"].tolist()
            parent   = {cid: cid for cid in ctrl_ids}

            # Union controls that list each other in their group column
            for idx in indices:
                row      = scope_df.loc[idx]
                cid      = row["Control ID"]
                grp_str  = str(row.get("Grouped Control IDs", "") or "")
                if not grp_str.strip():
                    # Fall back to classification_group_key peers
                    key     = row.get("Classification Group Key", "")
                    peers   = scope_df.loc[
                        (scope_df["Classification"] == clf_type) &
                        (scope_df["Classification Group Key"] == key),
                        "Control ID"
                    ].tolist()
                    grp_str = "; ".join(peers)

                members = [m.strip() for m in grp_str.split(";") if m.strip()]
                for m in members:
                    if m in parent:
                        _union(parent, cid, m)

            # Find connected components
            components: dict[str, list] = {}
            for cid in ctrl_ids:
                root = _find(parent, cid)
                components.setdefault(root, []).append(cid)

            # Sort components for deterministic numbering
            sorted_roots = sorted(
                components.keys(),
                key=lambda r: min(components[r])
            )
            id_map = {
                root: f"{prefix}-{i+1}"
                for i, root in enumerate(sorted_roots)
            }

            # Apply renumbered group IDs
            for idx in indices:
                cid  = scope_df.loc[idx, "Control ID"]
                root = _find(parent, cid)
                scope_df.loc[idx, "Classification Group Key"] = id_map.get(
                    root, f"{prefix}-1")

        result_parts.append(scope_df)

    if not result_parts:
        return df
    return pd.concat(result_parts, ignore_index=True)

def build_output_df(deduped, expanded_df, log):
    """
    Build the main output DataFrame: one row per control with all
    assessment fields, enriched with control details from the parquet.
    """
    # Build ctrl_lookup from expanded parquet
    ctrl_lookup = (
        expanded_df
        .drop_duplicates(subset=["Control_ID"], keep="first")
        .set_index("Control_ID")
        .to_dict("index")
    )

    rows = []
    for rec in deduped:
        ctrl_id = rec.get("control_id", "")
        ctx     = ctrl_lookup.get(ctrl_id, {})
        product = rec.get("product", "") or ctx.get("Product", "")

        rows.append({
            "Product":                     product,
            "Control ID":                  ctrl_id,
            "Control Name":                (rec.get("control_name","")
                                            or ctx.get("CTRL_NAME","")),
            "Control Objective":           (rec.get("control_objective","")
                                            or ctx.get("Control Objective","")),
            "Classification":              rec.get("classification",""),
            "Classification Group Key":    rec.get("classification_group_key",""),
            "Fragmented Group ID":         rec.get("fragmented_group_id",""),
            "Dual Classified":             rec.get("dual_classified", False),
            "Redundant By Control IDs":    "; ".join(
                                           rec.get("redundant_by_control_ids") or []),
            "Grouped Control IDs":         "; ".join(
                                           rec.get("fragmented_control_id_group") or []),
            "Rationale":                   rec.get("rationale",""),
            "Confidence":                  rec.get("confidence",""),
            "Scope ID":                    rec.get("scope_id",""),
            "Source Batch":                rec.get("batch_key",""),
            "Source File":                 rec.get("source",""),
        })

    df = pd.DataFrame(rows)
    df = df.sort_values(
        ["Product","Classification","Classification Group Key","Control ID"]
    ).reset_index(drop=True)
    log.info(f"  Output rows: {len(df):,}")
    return df

# ─────────────────────────────────────────────────────────────────────────────
#  BUILD SUMMARY
# ─────────────────────────────────────────────────────────────────────────────

def build_summary(df, coverage_df, log):
    clf = df["Classification"].value_counts()

    summary_rows = [
        ("── RUN SUMMARY ─────────────────────────────────────────────", ""),
        ("Total controls assessed",              len(df)),
        ("Products covered",                     df["Product"].nunique()),
        ("Controls with no assessment (gaps)",   len(coverage_df)),
        ("── CLASSIFICATIONS ─────────────────────────────────────────", ""),
        ("Redundant",
         int(clf.get("Redundant", 0))),
        ("Process-Split Fragmentation",
         int(clf.get("Process-Split Fragmentation", 0))),
        ("Common Control Opportunity",
         int(clf.get("Common Control Opportunity", 0))),
        ("Retain",
         int(clf.get("Retain", 0))),
        ("Unclear",
         int(clf.get("Unclear", 0))),
        ("── FINDINGS TOTAL ───────────────────────────────────────────", ""),
        ("Controls with a finding (R+PSF+CCO)",
         int(df["Classification"].isin([
             "Redundant","Process-Split Fragmentation",
             "Common Control Opportunity"]).sum())),
    ]
    summary_df = pd.DataFrame(summary_rows, columns=["Metric","Value"])

    # Per-product breakdown
    by_product = (
        df.groupby("Product")
        .agg(
            total              =("Control ID",     "count"),
            redundant          =("Classification",
                                 lambda x: (x=="Redundant").sum()),
            process_split      =("Classification",
                                 lambda x: (x=="Process-Split Fragmentation").sum()),
            common_ctrl_opp    =("Classification",
                                 lambda x: (x=="Common Control Opportunity").sum()),
            retain             =("Classification",
                                 lambda x: (x=="Retain").sum()),
            unclear            =("Classification",
                                 lambda x: (x=="Unclear").sum()),
        )
        .reset_index()
        .sort_values("total", ascending=False)
    )

    # Grouped findings: all controls sharing a group key within a scope
    findings = df[df["Classification"].isin([
        "Redundant","Process-Split Fragmentation","Common Control Opportunity"
    ])].copy()

    groups = pd.DataFrame()
    if not findings.empty:
        groups = (
            findings.groupby(["Product","Classification","Classification Group Key"])
            .agg(
                controls_in_group = ("Control ID", "count"),
                control_ids       = ("Control ID",
                                     lambda x: "; ".join(x.tolist())),
                confidence        = ("Confidence", "first"),
                rationale         = ("Rationale",  "first"),
            )
            .reset_index()
            .sort_values(["Product","Classification","Classification Group Key"])
        )

    return summary_df, by_product, groups

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--suffix", default="",
                        help="Only process checkpoint with this suffix. "
                             "e.g. --suffix _sample")
    args = parser.parse_args()

    log = setup_logging()
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 4: Post-processing")
    log.info("  Dimension 1: Product-level cluster assessment")
    log.info(f"  Started: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    if not EXPANDED.exists():
        log.error("expanded_product_control_mapping.parquet not found. "
                  "Run Scripts 1 and 2 first.")
        sys.exit(1)

    # Determine which checkpoint files to read
    if args.suffix:
        checkpoint_files = [f"llm_checkpoint_within_product{args.suffix}.jsonl"]
        log.info(f"Suffix filter: {checkpoint_files[0]}")
        output_wb1 = OUTPUT_DIR / f"within_product_assessment{args.suffix}.xlsx"
        output_wb2 = OUTPUT_DIR / f"assessment_summary{args.suffix}.xlsx"
    else:
        checkpoint_files = ALL_CHECKPOINT_FILES
        output_wb1 = OUTPUT_WB1
        output_wb2 = OUTPUT_WB2

    # Load expanded parquet
    log.info("Loading expanded dataset...")
    expanded_df = pd.read_parquet(EXPANDED, engine="pyarrow")
    log.info(f"  {len(expanded_df):,} rows | "
             f"{expanded_df['scope_id'].nunique():,} scopes | "
             f"{expanded_df['Control_ID'].nunique():,} unique controls")

    # Load and merge checkpoints
    log.info("\nLoading checkpoint files...")
    raw_records = load_checkpoints(checkpoint_files, log)

    if not raw_records:
        log.error("No assessment records found. Run Script 3 first.")
        sys.exit(1)

    # Deduplicate
    log.info("\nDeduplicating assessments...")
    deduped = deduplicate(raw_records, log)

    # Coverage check
    log.info("\nChecking coverage...")
    coverage_df = check_coverage(deduped, expanded_df, log)

    # Build output
    log.info("\nBuilding output...")
    df          = build_output_df(deduped, expanded_df, log)
    summary_df, by_product_df, groups_df = build_summary(df, coverage_df, log)

    findings_df = df[df["Classification"].isin([
        "Redundant","Process-Split Fragmentation","Common Control Opportunity"
    ])].copy()

    # ── Workbook 1: Main assessment output ───────────────────────────────────
    log.info(f"\nWriting: {output_wb1.name}")
    with pd.ExcelWriter(output_wb1, engine="openpyxl") as w:
        df.to_excel(           w, index=False, sheet_name="all_assessments")
        findings_df.to_excel(  w, index=False, sheet_name="findings_only")
        if not groups_df.empty:
            groups_df.to_excel(w, index=False, sheet_name="finding_groups")
        if not coverage_df.empty:
            coverage_df.to_excel(w, index=False, sheet_name="coverage_gaps")

    # ── Workbook 2: Summary statistics ───────────────────────────────────────
    log.info(f"Writing: {output_wb2.name}")
    with pd.ExcelWriter(output_wb2, engine="openpyxl") as w:
        summary_df.to_excel(   w, index=False, sheet_name="summary")
        by_product_df.to_excel(w, index=False, sheet_name="by_product")

    # Print summary to console
    log.info("\n" + "=" * 70)
    log.info("  RESULTS SUMMARY")
    log.info("=" * 70)
    for _, r in summary_df.iterrows():
        if not str(r["Metric"]).startswith("──"):
            log.info(f"  {r['Metric']}: {r['Value']}")

    log.info("\n  Output files:")
    log.info(f"    {output_wb1.name}")
    log.info(f"      - all_assessments  : {len(df):,} controls")
    log.info(f"      - findings_only    : {len(findings_df):,} controls")
    if not groups_df.empty:
        log.info(f"      - finding_groups   : {len(groups_df):,} groups")
    if not coverage_df.empty:
        log.info(f"      - coverage_gaps    : {len(coverage_df):,} controls")
    log.info(f"    {output_wb2.name}")
    log.info(f"      - summary")
    log.info(f"      - by_product       : {by_product_df['Product'].nunique():,} products")
    log.info("=" * 70)
    log.info("  Step 4 complete.")
    log.info("=" * 70)

if __name__ == "__main__":
    main()
