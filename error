def build_within_product_prompt(scope_id, batch_key, n_total,
                                sub_controls, scope_meta):
    n = len(sub_controls)
    sub_note = (
        f"\nNOTE: Sub-batch of {n} from {n_total} controls in this scope. "
        f"Assess duplicates within this sub-batch only."
        if n < n_total else ""
    )
    lines = [
        "SCOPE CONTEXT",
        f"Type            : Within-Product Assessment",
        f"Scope ID        : {scope_id}",
        f"Product         : {scope_meta.get('Product','')}",
        f"Payment Category: {scope_meta.get('Payment Category','')}",
        f"Lifecycle Stage : {scope_meta.get('Consolidated Stage','')}",
        f"CT Reference    : {scope_meta.get('ct_ref_norm','')}",
        f"Expected Control: {scope_meta.get('Expected Control','')}",
        sub_note, "",
        f"CONTROLS TO ASSESS ({n}):", "",
    ]
    for _, row in sub_controls.iterrows():
        lines += ["─"*60, build_short_control_text(row), ""]
    lines += [
        "─"*60, "",
        "TASK — WITHIN-PRODUCT ASSESSMENT",
        "All controls share the same Product, Payment Category, Lifecycle",
        "Stage, and CT Reference. Compare each against all others.",
        "Assess for Redundant Controls, Process-Split Fragmentation,",
        "Common Control Opportunities. Focus on underlying objective,",
        "activity, and risk outcome — not surface wording differences.", "",
        CLASSIFICATION_DEFINITIONS, "",
        RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_key: "{batch_key}".',
    ]
    return "\n".join(lines)


def build_cross_product_prompt(scope_id, batch_key, n_total,
                               sub_controls, ct_ref):
    n = len(sub_controls)
    products = (sub_controls["Product"].dropna().unique().tolist()
                if "Product" in sub_controls.columns else [])
    sub_note = (
        f"\nNOTE: Sub-batch of {n} from {n_total} controls. "
        f"Assess within this sub-batch only."
        if n < n_total else ""
    )
    lines = [
        "SCOPE CONTEXT",
        f"Type         : Cross-Product Assessment",
        f"Scope ID     : {scope_id}",
        f"CT Reference : {ct_ref}",
        f"Products     : {', '.join(products[:10])}",
        sub_note, "",
        f"CONTROLS TO ASSESS ({n} across multiple products):", "",
    ]
    for _, row in sub_controls.iterrows():
        lines += ["─"*60, build_short_control_text(row), ""]
    lines += [
        "─"*60, "",
        "TASK — CROSS-PRODUCT ASSESSMENT WITHIN CONTROL OBJECTIVE GROUP",
        "Controls share the same CT Reference but come from different products",
        "and may be owned by different business areas.",
        "Do NOT compare controls across different Control Objective Groups.",
        "Assess for Redundant Controls, Process-Split Fragmentation, and",
        "Common Control Opportunities where similar controls could be",
        "consolidated into a single shared control capability.", "",
        CLASSIFICATION_DEFINITIONS, "",
        RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_key: "{batch_key}".',
    ]
    return "\n".join(lines)

