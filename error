  focus:
    - Reconcile schema
    - Reconcile Cross Ref
    - Profile history feasibility
    - Profile Holocentric coverage
    - Profile data readiness
    - Generate pilot-domain scorecard inputs

  do_not_expand_scope:
    - controls_assurance
    - enterprise_pattern_clustering
    - prediction
    - digital_twin
    - causal_modelling
