#  CHECKPOINT
# ─────────────────────────────────────────────────────────────────────────────

def load_checkpoint(path: Path) -> set[str]:
    """Return set of already-processed 'scope_id::batch_id' keys."""
    done = set()
    if not path.exists():
        return done
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
                key = f"{rec['scope_id']}::{rec['batch_id']}"
                done.add(key)
            except (json.JSONDecodeError, KeyError):
                continue
    return done


def write_checkpoint(rec: dict, path: Path) -> None:
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=True) + "\n")

# ─────────────────────────────────────────────────────────────────────────────
#  LLM CALL
# ─────────────────────────────────────────────────────────────────────────────

def parse_llm_response(text: str) -> dict:
    """Parse and validate the LLM JSON response."""
    text = re.sub(r'^```(?:json)?\s*', '', text.strip())
    text = re.sub(r'\s*```$', '', text).strip()
    try:
        result = json.loads(text)
    except json.JSONDecodeError:
        m = re.search(r'\{.*\}', text, re.DOTALL)
        if m:
            result = json.loads(m.group(0))
        else:
            raise
    if "assessments" not in result:
        raise ValueError("Response missing 'assessments' key")
    return result


def call_llm(client: AzureOpenAI, prompt: str,
             scope_id: str, batch_id: int,
             log: logging.Logger) -> tuple[dict | None, dict]:
    """
    Call GPT-5.4 with medium reasoning. Returns (parsed_result, usage).
    Returns (None, usage) if all retries fail.
    """
    usage = {"input_tokens": 0, "output_tokens": 0,
             "reasoning_tokens": 0, "latency_ms": 0}

    for attempt in range(1, RETRY_COUNT + 1):
        try:
            t0 = time.time()
            resp = client.chat.completions.create(
                model=LLM_MODEL,
                messages=[
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user",   "content": prompt},
                ],
                reasoning_effort="medium",
                max_completion_tokens=8000,
            )
            latency = int((time.time() - t0) * 1000)
            text    = resp.choices[0].message.content or ""

            u = resp.usage if hasattr(resp, "usage") else None
            if u:
                usage["input_tokens"]  = getattr(u, "prompt_tokens", 0)
                usage["output_tokens"] = getattr(u, "completion_tokens", 0)
                d = getattr(u, "completion_tokens_details", None)
                if d:
                    usage["reasoning_tokens"] = getattr(d, "reasoning_tokens", 0)
            usage["latency_ms"] = latency

            parsed = parse_llm_response(text)
            parsed["scope_id"] = scope_id
            parsed["batch_id"] = batch_id
            return parsed, usage

        except Exception as exc:
            if attempt < RETRY_COUNT:
                wait = min(RETRY_BASE_SECS * 2 ** (attempt - 1)
                           + random.uniform(0, 2), 60)
                log.warning(f"  Attempt {attempt} failed for {scope_id}::{batch_id}: "
                            f"{exc}. Retrying in {wait:.0f}s...")
                time.sleep(wait)
            else:
                log.error(f"  All retries failed for {scope_id}::{batch_id}: {exc}")
                return None, usage

# ─────────────────────────────────────────────────────────────────────────────
#  PROCESSING LOOP
# ─────────────────────────────────────────────────────────────────────────────

def process_scopes(client: AzureOpenAI,
                   scope_type: str,
                   scope_df: pd.DataFrame,
                   pairs_df: pd.DataFrame,
                   expanded_df: pd.DataFrame,
                   checkpoint_path: Path,
                   done_keys: set[str],
                   config: dict,
                   log: logging.Logger) -> tuple[int, int, float]:
    """
    Process all scopes of one type (within_product or cross_product).
    Returns (n_processed, n_skipped, cost_aud).
    """
    max_per_batch = config.get("max_controls_per_llm_call", 20)
    total_in_tok  = total_out_tok = 0
    n_processed   = n_skipped = n_errors = 0
    total_scopes  = len(scope_df)
    run_start     = time.time()

    for row_idx, scope_row in scope_df.iterrows():
        scope_id   = scope_row["scope_id"]
        send_all   = bool(scope_row.get("send_all", True))
        n_controls = int(scope_row.get("n_controls", 0))
        n_batches  = int(scope_row.get("n_batches", 1))
        skip_reason= scope_row.get("skip_reason", "")

        # Skip single-control scopes
        if skip_reason == "single_control" or n_controls < 2:
            n_skipped += 1
            write_checkpoint({
                "scope_id":    scope_id,
                "scope_type":  scope_type,
                "batch_id":    0,
                "skipped":     True,
                "skip_reason": "single_control",
                "assessments": [],
            }, checkpoint_path)
            continue

        # Progress display
        elapsed  = time.time() - run_start
        pct      = (row_idx + 1) / total_scopes * 100
        eta_s    = (elapsed / (row_idx + 1)) * (total_scopes - row_idx - 1) \
                   if row_idx > 0 else 0
        eta_str  = (f"{int(eta_s//3600)}h {int((eta_s%3600)//60)}m"
                    if eta_s > 60 else f"{int(eta_s)}s")
        cost_aud = ((total_in_tok / 1e6 * INPUT_PRICE_PER_M +
                     total_out_tok / 1e6 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
        print(f"\r  [{pct:5.1f}%] {scope_id[:55]:<55} "
              f"ETA {eta_str}  A${cost_aud:.2f}", end="")

        # Get candidate pairs for this scope to build batch assignments
        scope_pairs = pairs_df[pairs_df["scope_id"] == scope_id]

        # Determine which controls are in each batch
        if send_all:
            batches = {0: expanded_df[expanded_df["Control_ID"].isin(
                scope_pairs["control_id_a"].tolist() +
                scope_pairs["control_id_b"].dropna().tolist()
            )].drop_duplicates(subset=["Control_ID"])}
            # For send_all, all controls in scope — use scope pairs to find them
            all_ctrl_ids_in_scope = set(scope_pairs["control_id_a"].tolist())
            all_ctrl_ids_in_scope.update(
                c for c in scope_pairs["control_id_b"].dropna().tolist()
                if c
            )
            batches = {0: expanded_df[
                expanded_df["Control_ID"].isin(all_ctrl_ids_in_scope)
            ].drop_duplicates(subset=["Control_ID"])}
        else:
            # Build batch dict from pair batch_id assignments
            batch_assignments = {}
            for _, pair in scope_pairs.iterrows():
                bid = int(pair.get("batch_id", 0))
                cid = pair["control_id_a"]
                if cid not in batch_assignments:
                    batch_assignments[cid] = bid
            batches = {}
            for cid, bid in batch_assignments.items():
                if bid not in batches:
                    batches[bid] = []
                batches[bid].append(cid)
            batches = {
                bid: expanded_df[expanded_df["Control_ID"].isin(cids)]
                         .drop_duplicates(subset=["Control_ID"])
                for bid, cids in batches.items()
            }

        # Process each batch
        for batch_id, batch_controls in sorted(batches.items()):
            ck_key = f"{scope_id}::{batch_id}"
            if ck_key in done_keys:
                n_skipped += 1
                continue

            if len(batch_controls) == 0:
                continue

            # Build prompt
            if scope_type == "within_product":
                scope_meta = {
                    "Product":            scope_row.get("Product", ""),
                    "Payment Category":   scope_row.get("Payment Category", ""),
                    "Consolidated Stage": scope_row.get("Consolidated Stage", ""),
                    "ct_ref_norm":        scope_row.get("ct_ref_norm", ""),
                    "Expected Control":   scope_row.get("Expected Control", ""),
                } if hasattr(scope_row, "get") else {}
                # Try to get scope context from expanded data
                sample = expanded_df[
                    expanded_df["Control_ID"].isin(batch_controls["Control_ID"])
                ].iloc[0] if len(batch_controls) > 0 else pd.Series()
                for col in ["Product","Payment Category",
                            "Consolidated Stage","Expected Control"]:
                    if col in sample.index:
                        scope_meta[col] = sample[col]

                prompt = build_within_product_prompt(
                    scope_id, batch_id, n_batches, send_all,
                    batch_controls, scope_meta)
            else:
                ct_ref = scope_id.replace("CP|", "")
                prompt = build_cross_product_prompt(
                    scope_id, batch_id, n_batches, send_all,
                    batch_controls, ct_ref)

            # Call LLM
            result, usage = call_llm(client, prompt, scope_id, batch_id, log)
            in_tok  = usage.get("input_tokens", 0)
            out_tok = usage.get("output_tokens", 0)
            total_in_tok  += in_tok
            total_out_tok += out_tok

            if result is None:
                n_errors += 1
                write_checkpoint({
                    "scope_id":   scope_id,
                    "scope_type": scope_type,
                    "batch_id":   batch_id,
                    "error":      True,
                    "assessments": [],
                }, checkpoint_path)
            else:
                result["scope_type"]   = scope_type
                result["n_controls"]   = len(batch_controls)
                result["input_tokens"] = in_tok
                result["output_tokens"]= out_tok
                result["error"]        = False
                write_checkpoint(result, checkpoint_path)
                n_processed += 1

            done_keys.add(ck_key)
            time.sleep(SLEEP_BETWEEN)

    print()  # newline after progress display
    cost_aud = ((total_in_tok / 1e6 * INPUT_PRICE_PER_M +
                 total_out_tok / 1e6 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
    log.info(f"  Processed: {n_processed:,} | Skipped: {n_skipped:,} | "
             f"Errors: {n_errors:,} | Cost: A${cost_aud:.2f}")
    return n_processed, n_skipped, cost_aud

