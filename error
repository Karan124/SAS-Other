def build_ct_data(scope_id, p1_data, p2_data, ctrl_lookup):
    """
    Build structured data for one CT group from pass-1 and pass-2 results.
    Returns a dict with all the data needed to write the Excel sheet.
    """
    ct_ref = scope_id.replace("CT|","")
    p2     = p2_data.get(scope_id, {})

    # All pass-1 control assessments for this scope
    ctrl_assessments = {
        cid: a for (sid, cid), a in p1_data.items()
        if sid == scope_id
    }

    # Enrich with control details from expanded parquet
    def enrich(a):
        cid = a.get("control_id","")
        ctx = ctrl_lookup.get(cid, {})
        control_type = ctx.get("CTRL_TYP","") or a.get("control_type","")
        return {
            **a,
            "control_name":      a.get("control_name","") or ctx.get("CTRL_NAME",""),
            "control_objective": a.get("control_objective","") or ctx.get("Control Objective",""),
            "control_nature":    ctx.get("CTRL_NATRE","") or a.get("control_nature",""),
            "control_type":      control_type,
            "population":        a.get("population","") or (
                "Automated" if control_type == "Automated" else "Manual"
            ),
            "ctrl_nature":       ctx.get("CTRL_NATRE",""),
            "ctrl_assess_rtng":  ctx.get("CTRL_ASSESS_RTNG",""),
            "ctrl_oe_rtng":      ctx.get("CTRL_OE_RTNG",""),
            "ctrl_de_rtng":      ctx.get("CTRL_DE_RTNG",""),
            "division":          ctx.get("CTRL_FLDR_LVL_2(Division)",""),
            "business_area":     ctx.get("object_path_leaf",""),
        }

    ctrl_assessments = {cid: enrich(a)
                        for cid, a in ctrl_assessments.items()}

    # Ranked controls from Pass 2
    auto_ranked = []
    man_ranked  = []
    auto_bob    = None
    man_bob     = None

    if p2:
        auto_pop = p2.get("automated_population") or {}
        man_pop  = p2.get("manual_population") or {}

        auto_ranked = auto_pop.get("ranked_controls") or []
        man_ranked  = man_pop.get("ranked_controls") or []
        auto_bob    = auto_pop.get("best_of_breed")
        man_bob     = man_pop.get("best_of_breed")

        # Enrich ranked controls with pass-1 details
        def enrich_ranked(ranked):
            out = []
            for r in ranked:
                cid = r.get("control_id","")
                a   = ctrl_assessments.get(cid, {})
                out.append({
                    "rank":             r.get("rank",""),
                    "control_id":       cid,
                    "control_name":     a.get("control_name",""),
                    "control_nature":   a.get("control_nature","") or a.get("ctrl_nature",""),
                    "design_strength":  r.get("design_strength","") or a.get("design_strength",""),
                    "coverage_summary": r.get("coverage_summary","") or
                                        f"{a.get('n_linked_products',0)} Products • "
                                        f"{a.get('n_linked_apps',0)} Apps • "
                                        f"{a.get('n_linked_processes',0)} Processes",
                    "objective_alignment": r.get("objective_alignment",""),
                    "nature_alignment":   r.get("nature_alignment",""),
                    "control_type":       a.get("control_type","") or r.get("control_type",""),
                    "population":         a.get("population",""),
                    "ranking_rationale":  r.get("ranking_rationale",""),
                    "is_best_of_breed":   bool(r.get("is_best_of_breed",False)),
                    "rationale":        a.get("rationale",""),
                    "design_principles_evaluation":
                        a.get("design_principles_evaluation",[]),
                    "red_flags_identified":
                        a.get("red_flags_identified",[]),
                    "n_products":   a.get("n_linked_products",0),
                    "n_apps":       a.get("n_linked_apps",0),
                    "n_processes":  a.get("n_linked_processes",0),
                    "ctrl_assess_rtng": a.get("ctrl_assess_rtng",""),
                    "ctrl_oe_rtng":     a.get("ctrl_oe_rtng",""),
                    "ctrl_de_rtng":     a.get("ctrl_de_rtng",""),
                    "division":         a.get("division",""),
                    "business_area":    a.get("business_area",""),
                })
            return out

        auto_ranked = enrich_ranked(auto_ranked)
        man_ranked  = enrich_ranked(man_ranked)

        def enrich_best_of_breed(best_of_breed):
            if not best_of_breed:
                return best_of_breed
            assessment = ctrl_assessments.get(
                best_of_breed.get("control_id", ""), {}
            )
            return {
                **best_of_breed,
                "control_nature": assessment.get("control_nature", ""),
            }

        auto_bob = enrich_best_of_breed(auto_bob)
        man_bob = enrich_best_of_breed(man_bob)

    fragmentation = p2.get("fragmentation") or []
    redundancy    = p2.get("redundancy") or []

    return {
        "ct_ref":           ct_ref,
        "scope_id":         scope_id,
        "n_controls":       len(ctrl_assessments),
        "auto_ranked":      auto_ranked,
        "man_ranked":       man_ranked,
        "auto_bob":         auto_bob,
        "man_bob":          man_bob,
        "fragmentation":    fragmentation,
        "redundancy":       redundancy,
        "ctrl_assessments": ctrl_assessments,
    }

# ─────────────────────────────────────────────────────────────────────────────
#  WRITE EXCEL — one sheet per CT group
