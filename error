* Yesterday's reporting snapshot */
%let td_date_eom = %sysfunc(
    intnx(day,%sysfunc(today()),-1,e),
    YYMMDD10.
);

proc sql;
    connect using sipsst;

    create table w._incidents_ as
    select *
    from connection to sipsst
    (
        SELECT
            INC_ID,
            INC_DESC,
            INC_NAME,
            INC_INCDNT_CAUSE,
            INC_DT_INCDNT_OCCRD,
            INC_PRD_LVL_2,
            INC_BASE_EVNT_TYP_2,
            NUM_OF_CUST_IMPCTD,
            INC_BULK_INC,
            NEAR_MISS,
            INC_PRCSS,
            INC_ROOT_CAUSE_LVL_1,
            INC_ROOT_CAUSE_LVL_2,
            INC_THRD_PRTY_SUPPLR_CAUSED_OR_IMPCTD,
            INC_PRMRY_CAUSED_BU

        FROM BIP1ViewA.A008E1_DIM_INCIDENT_R

        WHERE CAST(REPORTING_DATE AS DATE)
              = DATE%str(%')&td_date_eom.%str(%')

          AND CAST(INC_ENTRY_DT AS DATE)
              BETWEEN ADD_MONTHS(
                  DATE%str(%')&td_date_eom.%str(%'),
                  -6
              )
              AND DATE%str(%')&td_date_eom.%str(%')
			  AND INC_STUS <> 'Rejected'
			  AND INC_POTNL_COMPL_IMPCT = 'Yes'
    );

    disconnect from sipsst;
quit;
