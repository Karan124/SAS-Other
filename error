<script>
// ═══════════ DECK CONTROLLER ═══════════════════════════════════════
const slides = Array.from(document.querySelectorAll('.slide'));
const dotsEl = document.getElementById('dots');
let cur = 0;

slides.forEach((_, i) => {
  const d = document.createElement('div');
  d.className = 'dot' + (i === 0 ? ' on' : '');
  d.onclick = () => goTo(i);
  dotsEl.appendChild(d);
});

function goTo(n, dir) {
  if (n === cur || n < 0 || n >= slides.length) return;
  const fwd = dir !== undefined ? dir > 0 : n > cur;
  const prev = cur;
  slides[prev].classList.remove('active');
  slides[prev].classList.add(fwd ? 'exit-up' : 'exit-down');
  cur = n;
  slides[cur].classList.add('active');
  document.querySelectorAll('.dot').forEach((d, i) => d.classList.toggle('on', i === cur));
  setTimeout(() => slides[prev].classList.remove('exit-up', 'exit-down'), 480);
  onEnter(cur);
}
function go(d) { goTo(cur + d, d); }

document.addEventListener('keydown', e => {
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown') go(1);
  if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   go(-1);
});
let tx = 0, ty = 0;
document.addEventListener('touchstart', e => { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }, {passive:true});
document.addEventListener('touchend', e => {
  const dx = e.changedTouches[0].clientX - tx, dy = e.changedTouches[0].clientY - ty;
  if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 40) go(dy < 0 ? 1 : -1);
  else if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
}, {passive:true});

// ═══════════ ON-ENTER TRIGGERS ════════════════════════════════════
const doneMap = {};
function onEnter(n) {
  if (doneMap[n]) return;
  doneMap[n] = true;
  if (n === 2) animatePipeline();
  if (n === 3) animateEmbeddings();
  if (n === 4) animateCT();
  if (n === 5) animateLifecycle();
  if (n === 8) animateFunnel();
}
onEnter(0);

// ═══════════ PIPELINE ═════════════════════════════════════════════
function animatePipeline() {
  const nodes = document.querySelectorAll('.pv-node');
  const arrows = document.querySelectorAll('.pv-arrow[data-arrow]');
  nodes.forEach((n, i) => {
    setTimeout(() => {
      n.classList.add('lit');
      if (arrows[i]) arrows[i].classList.add('lit');
    }, parseInt(n.dataset.delay) || 0);
  });
}

// ═══════════ EMBEDDING SIMILARITY ANIMATION ══════════════════════
function animateEmbeddings() {
  // build embedding vector vis
  const vec = document.getElementById('sim-vec');
  if (vec) {
    for (let i = 0; i < 28; i++) {
      const d = document.createElement('div');
      d.className = 'sim-dim';
      vec.appendChild(d);
    }
    // animate dims lighting up with random heights/colours
    const dims = vec.querySelectorAll('.sim-dim');
    dims.forEach((dim, i) => {
      setTimeout(() => {
        const h = 8 + Math.random() * 20;
        dim.style.height = h + 'px';
        const v = Math.random();
        if (v > .6) dim.style.background = 'var(--wb-teal)';
        else if (v > .3) dim.style.background = 'var(--wb-navy2)';
        else dim.style.background = 'var(--wb-red)';
      }, i * 40);
    });
  }

  // animate similarity bars after a delay
  const scores = [{id:'sb1',pct:92,pid:'sp1'},{id:'sb2',pct:87,pid:'sp2'},{id:'sb3',pct:31,pid:'sp3'}];
  scores.forEach((s, i) => {
    setTimeout(() => {
      const bar = document.getElementById(s.id);
      const pct = document.getElementById(s.pid);
      if (bar) bar.style.width = s.pct + '%';
      // count up the percentage
      let v = 0;
      const step = () => {
        v = Math.min(v + 2, s.pct);
        if (pct) pct.textContent = v + '%';
        if (v < s.pct) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      // highlight matched cards
      if (s.pct > 80) {
        setTimeout(() => {
          const cards = [document.getElementById('ec-c1'), document.getElementById('ec-c2')];
          if (cards[i]) cards[i].classList.add('matched');
        }, 400);
      }
    }, 600 + i * 300);
  });
}

