function animateCT() {
  const grid = document.getElementById('ct-grid');
  const llm  = document.getElementById('ct-llm-box');
  if (!grid) return;

  const cts = [
    'CT1 Authorisation','CT2 Maker/Checker','CT3 Segregation of duties','CT4 System access',
    'CT5 Reconciliation','CT6 Monitoring','CT7 Reporting','CT8 Data quality',
    'CT9 Limit controls','CT10 Trade capture','CT11 Confirmation','CT12 Settlement',
    'CT13 Clearing','CT14 Fraud prevention','CT15 AML','CT16 Sanctions',
    'CT17 Regulatory','CT18 Operational risk','CT19 Credit risk','CT20 Market risk',
    'CT21 Liquidity','CT22 Change management','CT23 Business continuity','CT24 Outsourcing',
    'CT25 Data governance','CT26 Model risk','CT27 Conduct','CT28 Audit'
  ];

  grid.innerHTML = cts.map((ct, i) =>
    `<div class="ct-cell" id="ctc${i}">${ct}</div>`
  ).join('');

  // scan through each cell
  let scanIdx = 0;
  function scanNext() {
    if (scanIdx > 0) {
      const prev = document.getElementById('ctc' + (scanIdx - 1));
      if (prev) prev.classList.remove('scanning');
    }
    if (scanIdx < cts.length) {
      const cell = document.getElementById('ctc' + scanIdx);
      if (cell) cell.classList.add('scanning');
      if (llm) llm.innerHTML = `<span style="color:var(--fg3);font-style:italic">Evaluating ${cts[scanIdx]}...</span>`;
      scanIdx++;
      setTimeout(scanNext, scanIdx < 5 ? 120 : 60);
    } else {
      // land on CT2
      const target = document.getElementById('ctc1');
      if (target) { target.classList.remove('scanning'); target.classList.add('active'); }
      if (llm) llm.innerHTML = `Objective text matches a system-enforced segregation and authorisation pattern.<div class="verdict">CT2 — Maker/Checker controls</div>`;
    }
  }
  setTimeout(scanNext, 500);
}

