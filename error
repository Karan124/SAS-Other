# ─────────────────────────────────────────────────────────────────────────────

def load_checkpoint(log: logging.Logger) -> pd.DataFrame | None:
    """Load checkpoint file if it exists and has data."""
    if not CHECKPOINT_FILE.exists():
        return None
    try:
        df = pd.read_excel(CHECKPOINT_FILE, engine="openpyxl")
        if df.empty:
            return None
        log.info(
            f"Checkpoint loaded: {len(df):,} rows from {CHECKPOINT_FILE.name}"
        )
        return df
    except Exception as exc:
        log.warning(f"Checkpoint load failed ({exc}) — starting fresh.")
        return None


def save_checkpoint(
    results: list[dict],
    source_df: pd.DataFrame,
    log: logging.Logger,
) -> None:
    """Save current results to checkpoint file."""
    try:
        df = build_assessment_df(results, source_df)
        df.to_excel(CHECKPOINT_FILE, index=False, engine="openpyxl")
        log.debug(f"Checkpoint saved: {len(df):,} rows")
    except Exception as exc:
        log.warning(f"Checkpoint save failed: {exc}")


# ─────────────────────────────────────────────────────────────────────────────
#  OUTPUT CONSTRUCTION
# ─────────────────────────────────────────────────────────────────────────────

def build_assessment_df(
    results: list[dict],
    source_df: pd.DataFrame,
) -> pd.DataFrame:
    """Merge LLM assessment results back onto the source dataframe."""
    results_df = pd.DataFrame(results)
    # Align on zero-based row index
    out = source_df.copy()
    out["Manual Control Activities"]       = None
    out["Automated Control Activities"]    = None
    out["Process Steps (Non-Control Activities)"] = None
    out["Classification"]                  = None
    out["Rationale"]                       = None
    out["Confidence Level"]                = None
    out["Key Assumptions"]                 = None

    for rec in results:
        idx = rec.get("_row_index")
        if idx is None:
            continue
        out.at[idx, "Manual Control Activities"]            = rec.get("manual_control_activities", "")
        out.at[idx, "Automated Control Activities"]         = rec.get("automated_control_activities", "")
        out.at[idx, "Process Steps (Non-Control Activities)"] = rec.get("process_steps", "")
        out.at[idx, "Classification"]                       = rec.get("classification", "")
        out.at[idx, "Rationale"]                            = rec.get("rationale", "")
        out.at[idx, "Confidence Level"]                     = rec.get("confidence_level", "")
        out.at[idx, "Key Assumptions"]                      = rec.get("key_assumptions", "")
    return out


def write_output(
    all_results: list[dict],
    audit_log: list[dict],
    source_df: pd.DataFrame,
    run_stats: dict,
    log: logging.Logger,
) -> None:
    """Write the three-sheet output workbook."""
    OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)

    assessment_df = build_assessment_df(all_results, source_df)

    # ── Sheet 2: LLM Audit Log ────────────────────────────────────────────────
    audit_df = pd.DataFrame(audit_log)

    # ── Sheet 3: Run Metrics ─────────────────────────────────────────────────
    clf_counts = assessment_df["Classification"].value_counts()
    conf_counts = assessment_df["Confidence Level"].value_counts()
    total_in    = run_stats.get("prompt_tokens", 0)
    total_out   = run_stats.get("completion_tokens", 0)
    n_processed = run_stats.get("controls_processed", 0)
    est_cost_usd = (
        total_in  / 1_000_000 * INPUT_PRICE_PER_M +
        total_out / 1_000_000 * OUTPUT_PRICE_PER_M
    )
    est_cost_aud = est_cost_usd / AUD_USD_RATE

    metrics_rows = [
        ("Total Controls in Input",   len(source_df)),
        ("Controls Processed",         n_processed),
        ("Total ITDMC",                int(clf_counts.get("ITDMC", 0))),
        ("Total MAC",                  int(clf_counts.get("MAC", 0))),
        ("High Confidence",            int(conf_counts.get("High", 0))),
        ("Medium Confidence",          int(conf_counts.get("Medium", 0))),
        ("Low Confidence",             int(conf_counts.get("Low", 0))),
        ("Prompt Tokens",              total_in),
        ("Completion Tokens",          total_out),
        ("Total Tokens",               total_in + total_out),
        ("Avg Tokens per Control",     round((total_in + total_out) / max(n_processed, 1), 1)),
        ("Estimated Cost (USD)",       f"${est_cost_usd:.4f}"),
        ("Estimated Cost (AUD)",       f"A${est_cost_aud:.4f}"),
        ("Total API Calls (batches)",  run_stats.get("api_calls", 0)),
        ("Runtime",                    run_stats.get("runtime", "")),
        ("Batch Size",                 BATCH_SIZE),
        ("Model",                      MODEL),
        ("Completed At",               datetime.now().strftime("%Y-%m-%d %H:%M:%S")),
    ]
    metrics_df = pd.DataFrame(metrics_rows, columns=["Metric", "Value"])

    with pd.ExcelWriter(OUTPUT_FILE, engine="openpyxl") as writer:
        assessment_df.to_excel(writer, index=False, sheet_name="Control Assessment")
        audit_df.to_excel(     writer, index=False, sheet_name="LLM Audit Log")
        metrics_df.to_excel(   writer, index=False, sheet_name="Run Metrics")

    log.info(f"Output written: {OUTPUT_FILE}")
    log.info(
        f"  ITDMC: {int(clf_counts.get('ITDMC',0)):,}  |  "
        f"MAC: {int(clf_counts.get('MAC',0)):,}  |  "
        f"Cost: A${est_cost_aud:.4f}"
    )


# ─────────────────────────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Control Automation Method Assessment"
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Ignore existing checkpoint and restart from scratch.",
    )
    args = parser.parse_args()

    log = setup_logging()
    start_time = datetime.now()
    log.info("=" * 70)
    log.info("  Control Automation Assessment — starting")
    log.info(f"  Model      : {MODEL}")
    log.info(f"  Batch size : {BATCH_SIZE}")
    log.info(f"  Started    : {start_time.strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    # ── Load input ────────────────────────────────────────────────────────────
    if not INPUT_FILE.exists():
        log.error(f"Input file not found: {INPUT_FILE}")
        sys.exit(1)

    source_df = pd.read_excel(INPUT_FILE, engine="openpyxl", dtype=str)
    source_df = source_df.fillna("")

    # Normalise column names (the spec uses A/B/C/D but actual names may vary)
    cols = source_df.columns.tolist()
    col_map: dict[str, str] = {}
    if len(cols) >= 4:
        col_map = {
            cols[0]: "control_id",
            cols[1]: "control_name",
            cols[2]: "control_objective",
            cols[3]: "description",
        }
        source_df = source_df.rename(columns=col_map)

    log.info(f"Input loaded: {len(source_df):,} controls from {INPUT_FILE.name}")

    # ── Resume from checkpoint ────────────────────────────────────────────────
    completed_indices: set[int] = set()
    all_results: list[dict]     = []

    if not args.force:
        checkpoint_df = load_checkpoint(log)
        if checkpoint_df is not None:
            # Identify which rows already have a classification
            clf_col = "Classification"
            if clf_col in checkpoint_df.columns:
                done_mask = checkpoint_df[clf_col].isin(VALID_CLASSIFICATIONS)
                completed_indices = set(checkpoint_df.index[done_mask].tolist())
                # Re-hydrate all_results from checkpoint
                for idx in completed_indices:
                    row = checkpoint_df.iloc[idx]
                    all_results.append({
                        "_row_index":                idx,
                        "manual_control_activities": row.get("Manual Control Activities", ""),
                        "automated_control_activities": row.get("Automated Control Activities", ""),
                        "process_steps":             row.get("Process Steps (Non-Control Activities)", ""),
                        "classification":            row.get("Classification", ""),
                        "rationale":                 row.get("Rationale", ""),
                        "confidence_level":          row.get("Confidence Level", ""),
                        "key_assumptions":           row.get("Key Assumptions", ""),
                    })
                log.info(
                    f"Resuming: {len(completed_indices):,} already done, "
                    f"{len(source_df) - len(completed_indices):,} remaining"
                )

    # ── Generate mini classification framework ────────────────────────────────
    mini_framework = generate_mini_framework(log)

    # ── Build work queue (rows not yet completed) ─────────────────────────────
    pending_indices = [
        i for i in range(len(source_df))
        if i not in completed_indices
    ]
    log.info(f"Controls to process: {len(pending_indices):,}")

    if not pending_indices:
        log.info("All controls already completed. Writing output.")
        write_output(all_results, [], source_df, {
            "controls_processed": len(all_results),
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "api_calls": 0,
            "runtime": "0s",
        }, log)
        return

    # ── Batch processing ─────────────────────────────────────────────────────
    batches = [
        pending_indices[i:i + BATCH_SIZE]
        for i in range(0, len(pending_indices), BATCH_SIZE)
    ]
    total_batches   = len(batches)
    audit_log:  list[dict] = []
    total_in   = 0
    total_out  = 0
    api_calls  = 0

    log.info(f"Total batches: {total_batches:,}")

    for batch_num, batch_indices in enumerate(batches, 1):
        pct  = batch_num / total_batches * 100
        elapsed = (datetime.now() - start_time).total_seconds()
        eta_s   = (elapsed / batch_num) * (total_batches - batch_num) if batch_num > 1 else 0
        eta_str = (
            f"{int(eta_s // 3600)}h {int((eta_s % 3600) // 60)}m"
            if eta_s > 60 else f"{int(eta_s)}s"
        )
        cost = (
            (total_in  / 1_000_000 * INPUT_PRICE_PER_M +
             total_out / 1_000_000 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE
        )
        log.info(
            f"Batch {batch_num}/{total_batches} [{pct:.1f}%]  "
            f"ETA {eta_str}  A${cost:.3f}"
        )

        # Build control dicts for this batch
        controls_in_batch = []
        for idx in batch_indices:
            row = source_df.iloc[idx]
            controls_in_batch.append({
                "control_name":      str(row.get("control_name", "")),
                "control_objective": str(row.get("control_objective", "")),
                "description":       str(row.get("description", "")),
            })

        batch_ts = datetime.now().isoformat()
        results, usage = call_batch(
            controls_in_batch,
            mini_framework,
            batch_num,
            total_batches,
            log,
        )
        api_calls += 1
        total_in  += usage["prompt_tokens"]
        total_out += usage["completion_tokens"]

        # Attach row indices to results
        if results:
            for local_pos, idx in enumerate(batch_indices):
                if local_pos < len(results):
                    results[local_pos]["_row_index"] = idx
            all_results.extend(results)

        # Audit log entry
        audit_log.append({
            "Row Numbers":        str(batch_indices),
            "Batch Number":       batch_num,
            "Timestamp":          batch_ts,
            "Model Used":         MODEL,
            "Prompt Tokens":      usage["prompt_tokens"],
            "Completion Tokens":  usage["completion_tokens"],
            "Total Tokens":       usage["total_tokens"],
            "Controls in Batch":  len(batch_indices),
            "Results Returned":   len(results),
        })

        # Checkpoint after every batch
        save_checkpoint(all_results, source_df, log)

        time.sleep(SLEEP_BETWEEN)

    # ── Final output ──────────────────────────────────────────────────────────
    elapsed_total = (datetime.now() - start_time).total_seconds()
    runtime_str   = (
        f"{int(elapsed_total // 3600)}h "
        f"{int((elapsed_total % 3600) // 60)}m "
        f"{int(elapsed_total % 60)}s"
    )

    run_stats = {
        "controls_processed": len(all_results),
        "prompt_tokens":      total_in,
        "completion_tokens":  total_out,
        "api_calls":          api_calls,
        "runtime":            runtime_str,
    }

    write_output(all_results, audit_log, source_df, run_stats, log)

    log.info("=" * 70)
    log.info(f"  Complete. {len(all_results):,} controls assessed in {runtime_str}")
    log.info(f"  Output  : {OUTPUT_FILE}")
    log.info("=" * 70)


if __name__ == "__main__":
    main()
