def get_logger() -> logging.Logger:
    logger = logging.getLogger("ctrl_rat")
    if logger.handlers:
        return logger
    log_path = OUTPUT_DIR / "processing_log.txt"
    fh = logging.FileHandler(log_path, encoding="utf-8")
    fh.setLevel(logging.DEBUG)
    ch = logging.StreamHandler(sys.stdout)
    ch.setLevel(logging.INFO)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s",
                            datefmt="%Y-%m-%d %H:%M:%S")
    fh.setFormatter(fmt)
    ch.setFormatter(fmt)
    logger.addHandler(fh)
    logger.addHandler(ch)
    logger.setLevel(logging.DEBUG)
    return logger

# ─────────────────────────────────────────────────────────────────────────────
#  CHECKPOINT
# ─────────────────────────────────────────────────────────────────────────────

def load_checkpoint(path: Path) -> set:
    done = set()
    if not path.exists():
        return done
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
                key = rec.get("batch_key", "")
                if key:
                    done.add(key)
            except json.JSONDecodeError:
                continue
    return done


def write_checkpoint(rec: dict, path: Path) -> None:
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=True) + "\n")

# ─────────────────────────────────────────────────────────────────────────────
#  LLM CALL — fresh client on every attempt
# ─────────────────────────────────────────────────────────────────────────────

def parse_llm_response(text: str) -> dict:
    text = re.sub(r'^```(?:json)?\s*', '', (text or "").strip())
    text = re.sub(r'\s*```$', '', text).strip()
    if not text:
        raise ValueError("Empty response from model")
    try:
        result = json.loads(text)
    except json.JSONDecodeError:
        m = re.search(r'\{.*\}', text, re.DOTALL)
        if m:
            result = json.loads(m.group(0))
        else:
            raise
    if "assessments" not in result:
        raise ValueError("Response missing 'assessments' key")
    return result


def call_llm(prompt: str, batch_key: str,
             log: logging.Logger) -> tuple:
    """
    Call the LLM. Creates a fresh client on every attempt to guarantee
    a clean proxy connection regardless of how long the script has been running.
    Returns (parsed_result_or_None, usage_dict).
    """
    usage = {"input_tokens": 0, "output_tokens": 0,
             "reasoning_tokens": 0, "latency_ms": 0}

    for attempt in range(1, RETRY_COUNT + 1):
        is_connection_error = False
        try:
            # Fresh client on every attempt — the key fix
            client = make_client()

            t0   = time.time()
            resp = client.chat.completions.create(
                model=LLM_MODEL,
                messages=[
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user",   "content": prompt},
                ],
                reasoning_effort="low",
                max_completion_tokens=MAX_COMPLETION_TOKENS,
            )
            latency = int((time.time() - t0) * 1000)
            text    = resp.choices[0].message.content or ""

            u = getattr(resp, "usage", None)
            if u:
                usage["input_tokens"]  = getattr(u, "prompt_tokens", 0)
                usage["output_tokens"] = getattr(u, "completion_tokens", 0)
                d = getattr(u, "completion_tokens_details", None)
                if d:
                    usage["reasoning_tokens"] = getattr(d, "reasoning_tokens", 0)
            usage["latency_ms"] = latency

            parsed = parse_llm_response(text)
            return parsed, usage

        except Exception as exc:
            exc_str = str(exc).lower()
            is_connection_error = (
                "connection" in exc_str or
                "timed out" in exc_str or
                "timeout" in exc_str or
                "network" in exc_str or
                "proxy" in exc_str
            )

            if attempt < RETRY_COUNT:
                # Longer wait for connection/timeout errors to let proxy recover
                if is_connection_error:
                    wait = CONNECTION_SLEEP_SECS
                    log.warning(
                        f"  Connection/timeout error [{batch_key}] attempt {attempt}: "
                        f"{exc}. Waiting {wait}s for proxy to recover...")
                else:
                    wait = min(RETRY_BASE_SECS * 2**(attempt-1)
                               + random.uniform(0, 2), 60)
                    log.warning(
                        f"  Attempt {attempt} failed [{batch_key}]: "
                        f"{exc}. Retrying in {wait:.0f}s...")
                time.sleep(wait)
            else:
                log.error(f"  All {RETRY_COUNT} retries failed [{batch_key}]: {exc}")
                return None, usage

# ─────────────────────────────────────────────────────────────────────────────
#  SCOPE DATA HELPERS
# ─────────────────────────────────────────────────────────────────────────────

def get_scope_controls(scope_id: str,
                       pairs_df: pd.DataFrame,
                       expanded_df: pd.DataFrame) -> pd.DataFrame:
    scope_pairs = pairs_df[pairs_df["scope_id"] == scope_id]
    ctrl_ids = set(scope_pairs["control_id_a"].dropna().tolist())
    ctrl_ids.update(
        c for c in scope_pairs["control_id_b"].dropna().tolist() if c
    )
    return (expanded_df[expanded_df["Control_ID"].isin(ctrl_ids)]
            .drop_duplicates(subset=["Control_ID"])
            .reset_index(drop=True))


def get_batch_controls(scope_id: str,
                       batch_id: int,
                       send_all: bool,
                       pairs_df: pd.DataFrame,
                       expanded_df: pd.DataFrame) -> pd.DataFrame:
    if send_all:
        return get_scope_controls(scope_id, pairs_df, expanded_df)
    scope_pairs = pairs_df[pairs_df["scope_id"] == scope_id]
    batch_pairs = scope_pairs[scope_pairs["batch_id"] == batch_id]
    ctrl_ids    = set(batch_pairs["control_id_a"].dropna().tolist())
    return (expanded_df[expanded_df["Control_ID"].isin(ctrl_ids)]
            .drop_duplicates(subset=["Control_ID"])
            .reset_index(drop=True))

# ─────────────────────────────────────────────────────────────────────────────
#  PROCESSING LOOP
# ─────────────────────────────────────────────────────────────────────────────

def process_scopes(scope_type: str,
                   scope_df: pd.DataFrame,
                   pairs_df: pd.DataFrame,
                   expanded_df: pd.DataFrame,
                   checkpoint_path: Path,
                   done_keys: set,
                   log: logging.Logger) -> float:
    total_in_tok = total_out_tok = 0
    n_processed  = n_skipped = n_errors = 0
    total_scopes = len(scope_df)
    run_start    = time.time()

    for row_num, scope_row in enumerate(scope_df.itertuples(index=False), 1):
        scope_id    = scope_row.scope_id
        send_all    = bool(getattr(scope_row, "send_all", True))
        n_controls  = int(getattr(scope_row, "n_controls", 0))
        n_batches   = int(getattr(scope_row, "n_batches", 1))
        skip_reason = getattr(scope_row, "skip_reason", "")

        # Skip single-control scopes
        if skip_reason == "single_control" or n_controls < 2:
            n_skipped += 1
            bk = f"{scope_id}::0::0"
            if bk not in done_keys:
                write_checkpoint({
                    "batch_key": bk, "scope_id": scope_id,
                    "scope_type": scope_type, "skipped": True,
                    "skip_reason": "single_control", "assessments": [],
                }, checkpoint_path)
                done_keys.add(bk)
            continue

        # Progress
        elapsed = time.time() - run_start
        pct     = row_num / total_scopes * 100
        eta_s   = (elapsed / row_num) * (total_scopes - row_num) if row_num > 1 else 0
        eta_str = (f"{int(eta_s//3600)}h {int((eta_s%3600)//60)}m"
                   if eta_s > 60 else f"{int(eta_s)}s")
        cost    = ((total_in_tok / 1e6 * INPUT_PRICE_PER_M +
                    total_out_tok / 1e6 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
        print(f"\r  [{pct:5.1f}%] {scope_id[:55]:<55} "
              f"ETA {eta_str}  A${cost:.2f}", end="")

        # Scope metadata for prompt
        all_scope_ctrls = get_scope_controls(scope_id, pairs_df, expanded_df)
        n_scope_total   = len(all_scope_ctrls)
        if n_scope_total == 0:
            continue
        sample     = all_scope_ctrls.iloc[0]
        scope_meta = {col: str(sample.get(col, "") or "")
                      for col in ["Product", "Payment Category",
                                  "Consolidated Stage", "ct_ref_norm",
                                  "Expected CT Reference", "Expected Control"]}

        for batch_id in (range(n_batches) if not send_all else [0]):
            batch_ctrls = get_batch_controls(
                scope_id, batch_id, send_all, pairs_df, expanded_df)
            if len(batch_ctrls) == 0:
                continue

            # Sub-batch into groups of SUB_BATCH_SIZE
            n_sub = max(1, (len(batch_ctrls) + SUB_BATCH_SIZE - 1)
                        // SUB_BATCH_SIZE)

            for sub_idx in range(n_sub):
                sub_ctrls = batch_ctrls.iloc[
                    sub_idx * SUB_BATCH_SIZE:(sub_idx + 1) * SUB_BATCH_SIZE
                ].reset_index(drop=True)

                if len(sub_ctrls) == 0:
                    continue

                batch_key = f"{scope_id}::{batch_id}::{sub_idx}"
                if batch_key in done_keys:
                    n_skipped += 1
                    continue

                # Build prompt
                if scope_type == "within_product":
                    prompt = build_within_product_prompt(
                        scope_id, batch_key, n_scope_total,
                        sub_ctrls, scope_meta)
                else:
                    prompt = build_cross_product_prompt(
                        scope_id, batch_key, n_scope_total,
                        sub_ctrls, scope_id.replace("CP|", ""))

                # Call LLM (fresh client per attempt inside call_llm)
                result, usage = call_llm(prompt, batch_key, log)

                in_tok  = usage.get("input_tokens", 0)
                out_tok = usage.get("output_tokens", 0)
                total_in_tok  += in_tok
                total_out_tok += out_tok

                if result is None:
                    n_errors += 1
                    write_checkpoint({
                        "batch_key":  batch_key,
                        "scope_id":   scope_id,
                        "scope_type": scope_type,
                        "error":      True,
                        "assessments": [],
                        "control_ids_in_batch": sub_ctrls["Control_ID"].tolist(),
                    }, checkpoint_path)
                else:
                    result.update({
                        "batch_key":          batch_key,
                        "scope_type":         scope_type,
                        "n_controls_in_batch":len(sub_ctrls),
                        "input_tokens":       in_tok,
                        "output_tokens":      out_tok,
                        "error":              False,
                        "control_ids_in_batch": sub_ctrls["Control_ID"].tolist(),
                    })
                    write_checkpoint(result, checkpoint_path)
                    n_processed += 1

                done_keys.add(batch_key)
                time.sleep(SLEEP_BETWEEN)

    print()
    cost_aud = ((total_in_tok / 1e6 * INPUT_PRICE_PER_M +
                 total_out_tok / 1e6 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
    log.info(f"  Processed: {n_processed:,} | Skipped: {n_skipped:,} | "
             f"Errors: {n_errors:,} | Cost: A${cost_aud:.2f}")
    return cost_aud

