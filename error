"""Shared call, parse, validate, log and flatten functions for the RL run."""
import csv, json, re, time
from datetime import datetime
import yaml
from rl_config import MODEL, MAX_COMPLETION_TOKENS, REASONING_EFFORT, INPUT_PRICE_USD_PER_M, OUTPUT_PRICE_USD_PER_M

ROUTES = ["Clear RL nexus", "RL plus another pathway", "No clear RL nexus", "Insufficient to route"]
RL_ROUTES = ROUTES[:2]
Q2 = ["Reasonable confidence", "Within stated bounds", "Insufficient confidence", "Not assessable from JUNO"]
STATUSES = ["Breached", "Not breached", "Not engaged", "Requires assessor judgement",
            "Insufficient evidence", "Not assessable from JUNO"]
OVERALL = ["Multi-cluster breach", "RL breach only", "Prudential breach only", "BCoP/Licence breach only",
           "No compliance breach", "Assessor-ready", "Outside RL pathway", "Not assessable from JUNO"]
LOG_FIELDS = ["INC_ID", "step", "prompt_version", "prompt_sha", "model", "reasoning_effort", "run_at",
              "status", "attempts", "retried", "fenced", "finish_reason", "prompt_tokens",
              "completion_tokens", "reasoning_tokens", "latency_s", "cost_usd", "error"]

RE_FENCE = re.compile(r"\s*```(?:yaml|yml)?[ \t]*\n(.*?)\n\s*```\s*", re.S)


def to_str(x):
    if x is None:
        return ""
    if isinstance(x, bool):                      # YAML 1.1 reads bare Yes/No as booleans
        return "Yes" if x else "No"
    if isinstance(x, list):
        return "; ".join(to_str(i) for i in x)
    if isinstance(x, dict):
        return "; ".join(f"{k}={to_str(v)}" for k, v in x.items())
    return str(x).strip()


def canon(v, allowed):
    """Map a value to its allowed label by prefix (case-insensitive); None if no match."""
    s = to_str(v).lower()
    hits = [a for a in allowed if s.startswith(a.lower())]
    return max(hits, key=len) if hits else None


def parse_yaml(text):
    """Strip a single ```yaml fence if present (logged), else parse as-is."""
    m = RE_FENCE.fullmatch(text or "")
    body, fenced = (m.group(1), True) if m else (text or "", False)
    d = yaml.safe_load(body)
    if not isinstance(d, dict):
        raise ValueError("output is not a single YAML mapping")
    return d, fenced


def _check_keys(d, keys, inc_id):
    miss = [k for k in keys if k not in d]
    if miss:
        raise ValueError(f"missing keys {miss}")
    if to_str(d.get("incident_id")) != inc_id:
        raise ValueError("incident_id does not match INC_ID")


def validate_triage(d, inc_id):
    _check_keys(d, ["incident_id", "route", "markers", "other_pathways", "reason"], inc_id)
    r = canon(d["route"], ROUTES)
    if not r:
        raise ValueError("route not in allowed set")
    d["route"] = r
    return d


def validate_assessment(d, inc_id):
    _check_keys(d, ["incident_id", "record_basis", "q1_rl_markers", "q2_confidence", "pattern",
                    "what_changes_the_outcome", "would_change_if", "obligations", "overall"], inc_id)
    q = canon(d["q2_confidence"], Q2)
    if not q:
        raise ValueError("q2_confidence not in allowed set")
    d["q2_confidence"] = q
    ob = d["obligations"]
    if not isinstance(ob, dict):
        raise ValueError("obligations is not a mapping")
    for c in ["RL", "Prudential", "BCoP_Licence"]:
        cell = ob.get(c)
        if not isinstance(cell, dict) or canon(cell.get("status"), STATUSES) is None:
            raise ValueError(f"{c} status missing or not in allowed set")
    if canon(d["overall"], OVERALL) is None:
        raise ValueError("overall not in allowed set")
    q3 = d.get("q3_unresolved")
    if q3 not in (None, "") and not isinstance(q3, list):
        raise ValueError("q3_unresolved is not a list")
    return d


def _api_call(client, system, user, effort, max_tries=4):
    """API-level retry for transient errors only (separate from the malformed-output retry)."""
    for i in range(max_tries):
        try:
            t0 = time.time()
            r = client.chat.completions.create(
                model=MODEL,
                messages=[{"role": "system", "content": system}, {"role": "user", "content": user}],
                reasoning_effort=effort, max_completion_tokens=MAX_COMPLETION_TOKENS)
            return r, time.time() - t0, None
        except Exception as e:
            err = f"{type(e).__name__}: {str(e)[:300]}"
            if getattr(e, "status_code", None) in (400, 401, 403) or i == max_tries - 1:
                return None, 0.0, err
            time.sleep(5 * 2 ** i)


def run_one(client, step, inc_id, system, prompt_ver, prompt_sha, user_msg, validate, raw_dir, prefix=""):
    """One incident, one step. Malformed output: retry once, then flag. Raw responses always saved."""
    effort = REASONING_EFFORT[step]
    log = {"INC_ID": inc_id, "step": step, "prompt_version": prompt_ver, "prompt_sha": prompt_sha,
           "model": MODEL, "reasoning_effort": effort, "run_at": "", "status": "", "attempts": 0,
           "retried": False, "fenced": False, "finish_reason": "", "prompt_tokens": 0,
           "completion_tokens": 0, "reasoning_tokens": 0, "latency_s": 0.0, "cost_usd": 0.0, "error": ""}
    for attempt in (1, 2):
        r, lat, err = _api_call(client, system, user_msg, effort)
        run_at = datetime.now().isoformat(timespec="seconds")
        content = r.choices[0].message.content if r else None
        u = r.usage if r else None
        det = getattr(u, "completion_tokens_details", None) if u else None
        rtok = (getattr(det, "reasoning_tokens", 0) or 0) if det else 0
        raw = {"INC_ID": inc_id, "step": step, "attempt": attempt, "prompt_version": prompt_ver,
               "prompt_sha": prompt_sha, "model": MODEL, "reasoning_effort": effort, "run_at": run_at,
               "user_message": user_msg, "finish_reason": r.choices[0].finish_reason if r else None,
               "usage": {"prompt_tokens": u.prompt_tokens, "completion_tokens": u.completion_tokens,
                         "reasoning_tokens": rtok} if u else None,
               "content": content, "api_error": err}
        (raw_dir / f"{prefix}{inc_id}_{step}_a{attempt}.json").write_text(
            json.dumps(raw, ensure_ascii=False, indent=1), encoding="utf-8")

        log["run_at"], log["attempts"], log["retried"] = run_at, attempt, attempt > 1
        log["latency_s"] = round(log["latency_s"] + lat, 1)
        if u:
            log["prompt_tokens"] += u.prompt_tokens
            log["completion_tokens"] += u.completion_tokens
            log["reasoning_tokens"] += rtok
            log["finish_reason"] = r.choices[0].finish_reason
        log["cost_usd"] = round(log["prompt_tokens"] / 1e6 * INPUT_PRICE_USD_PER_M
                                + log["completion_tokens"] / 1e6 * OUTPUT_PRICE_USD_PER_M, 5)
        if r is None:
            log["status"], log["error"] = "api_error", err
            return None, log
        try:
            d, fenced = parse_yaml(content)
            d = validate(d, inc_id)
            log["status"], log["fenced"], log["error"] = "ok", fenced, ""
            return d, log
        except Exception as e:
            log["status"], log["error"] = "malformed", f"{type(e).__name__}: {str(e)[:200]}"
    log["status"] = "failed_malformed"
    return None, log


def append_log(path, rows):
    new = not path.exists()
    with open(path, "a", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=LOG_FIELDS)
        if new:
            w.writeheader()
        w.writerows(rows)


def flatten_triage(inc_id, d):
    mk = d.get("markers") or []
    mk = mk if isinstance(mk, list) else [mk]
    return {"INC_ID": inc_id, "Route": d["route"],
            "RL markers": "; ".join(to_str(m.get("marker")) if isinstance(m, dict) else to_str(m) for m in mk),
            "Marker source fields": "; ".join(to_str(m.get("source_field")) if isinstance(m, dict) else "" for m in mk),
            "Other pathways": to_str(d.get("other_pathways")), "Reason": to_str(d.get("reason"))}


def flatten_assessment(inc_id, d, route, in_window):
    p = d.get("pattern")
    pn, pb, pa = ((to_str(p.get("name")), to_str(p.get("basis")), to_str(p.get("anomaly_type")))
                  if isinstance(p, dict) else (to_str(p), "", ""))
    ob = d["obligations"]
    rl, pr, bc = ob["RL"], ob["Prudential"], ob["BCoP_Licence"]
    return {"INC_ID": inc_id, "In window (Y/N)": "Y" if in_window else "N",
            "In headline (Y/N)": "Y" if (in_window and route in RL_ROUTES) else "N",
            "CA exists": "pending CA join", "Route": route, "Q2 confidence": d["q2_confidence"],
            "Pattern": pn, "Pattern basis": pb, "Anomaly type": pa,
            "What changes the outcome": to_str(d.get("what_changes_the_outcome")),
            "Would change if": to_str(d.get("would_change_if")),
            "RL status": to_str(rl.get("status")), "RL provisions": to_str(rl.get("provisions")),
            "RL sub-lines": to_str(rl.get("sub_lines")),
            "Prudential status": to_str(pr.get("status")), "Prudential provisions": to_str(pr.get("provisions")),
            "BCoP-Licence status": to_str(bc.get("status")), "BCoP-Licence provisions": to_str(bc.get("provisions")),
            "BCoP-Licence sub-lines": to_str(bc.get("sub_lines")), "Overall": to_str(d.get("overall"))}


def flatten_unresolved(inc_id, d):
    rows = []
    for it in d.get("q3_unresolved") or []:
        it = it if isinstance(it, dict) else {"question_or_item": it}
        rows.append({"INC_ID": inc_id, "Type": to_str(it.get("type")), "Resolver": to_str(it.get("resolver")),
                     "Question or item": to_str(it.get("question_or_item")), "Fact no": to_str(it.get("fact_no")),
                     "Cluster affected": to_str(it.get("cluster_affected")),
                     "What each answer would change": to_str(it.get("what_each_answer_would_change"))})
    return rows
