    ]

    # Add principles for both populations (LLM determines which applies per control)
    lines += ["AUTOMATED POPULATION DESIGN PRINCIPLES:"]
    auto_data = CT_PRINCIPLES.get(ct_ref, FALLBACK_PRINCIPLES).get(
        "automated", FALLBACK_PRINCIPLES["automated"])
