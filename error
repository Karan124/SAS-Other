<script>
// ── THEME ──────────────────────────────────────────────────────────────────
function toggleTheme() {
  const r = document.documentElement;
  const t = r.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
  r.setAttribute('data-theme', t);
  try { localStorage.setItem('poc-theme', t); } catch(e) {}
  redrawAll();
}
try {
  const s = localStorage.getItem('poc-theme');
  if (s) document.documentElement.setAttribute('data-theme', s);
} catch(e) {}

// ── NAV ACTIVE ─────────────────────────────────────────────────────────────
function goTo(id) { document.getElementById(id).scrollIntoView({ behavior: 'smooth' }); }
const secs = document.querySelectorAll('section');
const nbtns = document.querySelectorAll('.nav-btn');
function updateNav() {
  let cur = '';
  secs.forEach(s => { if (window.scrollY >= s.offsetTop - 60) cur = s.id; });
  nbtns.forEach(b => {
    const id = b.getAttribute('onclick').match(/'([^']+)'/)?.[1];
    b.classList.toggle('active', id === cur);
  });
}
window.addEventListener('scroll', updateNav, { passive: true });
updateNav();

// ── TABS ──────────────────────────────────────────────────────────────────
function showTab(id, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('on'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('on'));
  document.getElementById('tab-' + id).classList.add('on');
  btn.classList.add('on');
}

// ── ACCORDIONS ────────────────────────────────────────────────────────────
function openCh(el) {
  const was = el.classList.contains('open');
  document.querySelectorAll('.ch.open').forEach(c => c.classList.remove('open'));
  if (!was) el.classList.add('open');
}

// ── COUNTERS ──────────────────────────────────────────────────────────────
function animNum(el) {
  const target = parseInt(el.dataset.t);
  const dur = 1600;
  const t0 = performance.now();
  (function step(now) {
    const p = Math.min((now - t0) / dur, 1);
    const e = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.floor(e * target).toLocaleString();
    if (p < 1) requestAnimationFrame(step);
    else el.textContent = target.toLocaleString();
  })(t0);
}
const counters = document.querySelectorAll('.counter');
const cObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting && !e.target.dataset.done) {
      e.target.dataset.done = '1';
      animNum(e.target);
    }
  });
}, { threshold: .3 });
counters.forEach(c => cObs.observe(c));

// ── PROGRESS BARS ─────────────────────────────────────────────────────────
const prog = document.getElementById('prog-block');
const pObs = new IntersectionObserver(es => {
  if (es[0].isIntersecting) {
    document.querySelectorAll('.prog-fill').forEach(f => f.style.width = f.dataset.w + '%');
    pObs.disconnect();
  }
}, { threshold: .2 });
if (prog) pObs.observe(prog);

// ── TIMELINE STEP REVEAL ──────────────────────────────────────────────────
const steps = document.querySelectorAll('.pl-step');
const stObs = new IntersectionObserver(es => {
  es.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: .2 });
steps.forEach((s, i) => { s.style.transitionDelay = (i * 0.1) + 's'; stObs.observe(s); });

// ── ANIMATED BAR CHART ────────────────────────────────────────────────────
const barSection = document.getElementById('outcomes');
let barDone = false;
const barObs = new IntersectionObserver(es => {
  if (es[0].isIntersecting && !barDone) {
    barDone = true;
    const H_MAX = 120;
    const dur = 1400;
    const t0 = performance.now();
    (function step(now) {
      const p = Math.min((now - t0) / dur, 1);
      const e = 1 - Math.pow(1 - p, 3);
      const hBefore = e * H_MAX;
      const hAfter  = e * H_MAX * (516/1379);
      const bB = document.getElementById('bar-before');
      const bA = document.getElementById('bar-after');
      if (bB) { bB.setAttribute('y', 140 - hBefore); bB.setAttribute('height', hBefore); }
      if (bA) { bA.setAttribute('y', 140 - hAfter);  bA.setAttribute('height', hAfter); }
      if (p > .6) {
        const a = document.getElementById('lbl-after');
        const r = document.getElementById('lbl-pct');
        const lblY = 140 - hAfter - 12;
        if (a) { a.setAttribute('y', Math.max(lblY, 10)); a.setAttribute('opacity', ((p-.6)/.4).toFixed(2)); }
        if (r) { r.setAttribute('opacity', ((p-.6)/.4).toFixed(2)); }
      }
      if (p < 1) requestAnimationFrame(step);
    })(t0);
  }
}, { threshold: .3 });
barObs.observe(barSection);

// ── HERO CANVAS (animated particles) ─────────────────────────────────────
(function() {
  const canvas = document.getElementById('hero-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, pts;
  function resize() {
    W = canvas.width  = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
  }
  function initPts() {
    pts = Array.from({length: 60}, () => ({
      x: Math.random() * W, y: Math.random() * H,
      vx: (Math.random() - .5) * .3, vy: (Math.random() - .5) * .3,
    }));
  }
  function getColor(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
  function draw() {
    ctx.clearRect(0, 0, W, H);
    const fg3 = getColor('--fg3');
    const red = getColor('--red');
    // move
    pts.forEach(p => {
      p.x = (p.x + p.vx + W) % W;
      p.y = (p.y + p.vy + H) % H;
    });
    // lines
    ctx.lineWidth = .5;
    for (let i = 0; i < pts.length; i++) {
      for (let j = i + 1; j < pts.length; j++) {
        const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
        const d = Math.sqrt(dx*dx + dy*dy);
        if (d < 100) {
          ctx.strokeStyle = `rgba(218,32,50,${.15 * (1 - d/100)})`;
          ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y); ctx.stroke();
        }
      }
    }
    // dots
    pts.forEach(p => {
      ctx.fillStyle = fg3;
      ctx.beginPath(); ctx.arc(p.x, p.y, 1.5, 0, Math.PI*2); ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  resize(); initPts();
  window.addEventListener('resize', () => { resize(); initPts(); });
  draw();
})();

// ── CONSTELLATION (problem section) ───────────────────────────────────────
(function() {
  const canvas = document.getElementById('constellation');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const nodes = [
    { label: 'JUNO',       sub: 'Control Register',     col: '#DA2032' },
    { label: 'Holocentric', sub: 'Process Models (L3)', col: '#f59e0b' },
    { label: 'Alfabet',    sub: 'App Architecture',     col: '#38bdf8' },
  ];
  const BIG = { label: 'Big Table', sub: 'Unified Control Record', col: '#ffffff' };
  let W, H, t = 0;
  function resize() {
    W = canvas.width  = canvas.offsetWidth * (window.devicePixelRatio || 1);
    H = canvas.height = canvas.offsetHeight * (window.devicePixelRatio || 1);
    canvas.style.width  = canvas.offsetWidth + 'px';
    canvas.style.height = canvas.offsetHeight + 'px';
  }
  function getVar(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
  function draw() {
    t += .008;
    ctx.clearRect(0, 0, W, H);
    const bg2 = getVar('--bg2');
    ctx.fillStyle = bg2; ctx.fillRect(0, 0, W, H);

    const scale = W / (window.devicePixelRatio || 1) < 500 ? .6 : 1;
    const cx = W / 2, cy = H / 2;
    const orbitR = Math.min(W, H) * .3 * scale;

    // positions
    const positions = nodes.map((n, i) => {
      const angle = (i / 3) * Math.PI * 2 + t * .4;
      return { x: cx + Math.cos(angle) * orbitR, y: cy + Math.sin(angle) * orbitR, ...n };
    });
    const centre = { x: cx, y: cy, ...BIG };

    // lines to centre
    const pct = (Math.sin(t * 2) + 1) / 2; // 0–1 pulse
    positions.forEach(p => {
      const grad = ctx.createLinearGradient(p.x, p.y, cx, cy);
      grad.addColorStop(0, p.col + '60');
      grad.addColorStop(1, '#ffffff40');
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1 * scale;
      ctx.setLineDash([6, 5]);
      ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(cx, cy); ctx.stroke();
      ctx.setLineDash([]);
      // moving dot on line
      const mx = p.x + (cx - p.x) * ((t * .5) % 1);
      const my = p.y + (cy - p.y) * ((t * .5) % 1);
      ctx.fillStyle = p.col;
      ctx.beginPath(); ctx.arc(mx, my, 3 * scale, 0, Math.PI*2); ctx.fill();
    });

    // draw outer nodes
    positions.forEach(p => {
      const r = 24 * scale;
      ctx.fillStyle = p.col + '20';
      ctx.strokeStyle = p.col;
      ctx.lineWidth = 1.5 * scale;
      ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI*2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = p.col;
      ctx.font = `bold ${12 * scale}px Inter,sans-serif`;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(p.label, p.x, p.y);
      ctx.fillStyle = getVar('--fg3');
      ctx.font = `${9 * scale}px Inter,sans-serif`;
      ctx.fillText(p.sub, p.x, p.y + 18 * scale);
    });

    // centre node (pulsing)
    const cr = (32 + Math.sin(t * 3) * 3) * scale;
    ctx.fillStyle = '#ffffff15';
    ctx.strokeStyle = '#ffffff60';
    ctx.lineWidth = 1.5 * scale;
    ctx.beginPath(); ctx.arc(cx, cy, cr, 0, Math.PI*2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#ffffff';
    ctx.font = `bold ${12 * scale}px Inter,sans-serif`;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('Big Table', cx, cy - 7 * scale);
    ctx.fillStyle = getVar('--fg3');
    ctx.font = `${9 * scale}px Inter,sans-serif`;
    ctx.fillText('Unified Record', cx, cy + 8 * scale);

    requestAnimationFrame(draw);
  }
  resize();
  new ResizeObserver(resize).observe(canvas.parentElement);
  draw();
})();

// ── EMBEDDING VIS ─────────────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('embed-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const clusters = [
    { label: 'Exception Monitoring', col: '#DA2032', cx: .18, cy: .38,
      pts: [[.09,.26],[.14,.22],[.12,.34],[.19,.19],[.22,.28],[.08,.40],[.16,.44],[.20,.34],[.10,.48],[.25,.22]] },
    { label: 'Maker-Checker Validation', col: '#38bdf8', cx: .65, cy: .30,
      pts: [[.56,.22],[.60,.30],[.68,.22],[.72,.28],[.58,.38],[.74,.36],[.64,.44],[.70,.48],[.52,.32],[.76,.22]] },
    { label: 'Reconciliation', col: '#22c55e', cx: .35, cy: .70,
      pts: [[.28,.64],[.32,.72],[.38,.66],[.42,.74],[.30,.78],[.36,.82],[.44,.70],[.26,.76]] },
    { label: 'Auth & Approval', col: '#f59e0b', cx: .78, cy: .70,
      pts: [[.72,.64],[.76,.72],[.82,.66],[.86,.74],[.74,.78],[.80,.82],[.88,.68]] },
  ];
  let W, H;
  function resize() {
    const dpr = window.devicePixelRatio || 1;
    W = canvas.parentElement.clientWidth;
    H = 220;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
    ctx.scale(dpr, dpr);
  }
  function getVar(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
  function drawEmbed() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = getVar('--bg3'); ctx.fillRect(0, 0, W, H);
    // faint grid
    ctx.strokeStyle = getVar('--border'); ctx.lineWidth = .5; ctx.setLineDash([2,4]);
    for (let x = 0; x < W; x += 50) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
    for (let y = 0; y < H; y += 50) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }
    ctx.setLineDash([]);
    // blobs
    clusters.forEach(c => {
      const gx = c.cx * W, gy = c.cy * H;
      const g = ctx.createRadialGradient(gx,gy,0,gx,gy,60);
      g.addColorStop(0, c.col+'30'); g.addColorStop(1, c.col+'00');
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(gx, gy, 60, 0, Math.PI*2); ctx.fill();
    });
    // dots
    clusters.forEach(c => {
      c.pts.forEach(([px,py]) => {
        ctx.fillStyle = c.col + 'cc';
        ctx.beginPath(); ctx.arc(px*W, py*H, 3.5, 0, Math.PI*2); ctx.fill();
      });
    });
    // labels
    ctx.textAlign = 'center';
    clusters.forEach(c => {
      ctx.font = `600 10px ${getVar('--mono') || 'monospace'}`;
      ctx.fillStyle = c.col;
      ctx.fillText(c.label, c.cx * W, c.cy * H - 50);
    });
  }
  resize(); drawEmbed();
  new ResizeObserver(() => { ctx.setTransform(1,0,0,1,0,0); resize(); drawEmbed(); }).observe(canvas.parentElement);
  new MutationObserver(() => { ctx.setTransform(1,0,0,1,0,0); resize(); drawEmbed(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
})();

function redrawAll() {
  // theme change — canvases redraw on next frame via their own observers
}
