#  PROCESSING
# ─────────────────────────────────────────────────────────────────────────────

def process_scope(scope_id, scope_row, pairs_df, expanded_df,
                  ck1_path, ck2_path, done_p1, done_p2, log):
    """Run Pass 1 + Pass 2 for one CT scope."""
    ct_ref    = scope_id.replace("CT|","")
    send_all  = bool(getattr(scope_row, "send_all", True))
    n_batches = int(getattr(scope_row, "n_batches", 1))
    n_ctrls   = int(getattr(scope_row, "n_controls", 0))

    all_scope = get_scope_controls(scope_id, pairs_df, expanded_df)
    if n_ctrls < 1:
        log.info(f"  {scope_id}: no controls, skipping")
        return 0, 0

    log.info(f"\n  Processing {scope_id} ({n_ctrls} controls, "
             f"{ct_ref} principles {'provided' if ct_ref in CT_PRINCIPLES else 'not provided'})")

    total_in = total_out = 0

    # ── Pass 1: per-control assessment ───────────────────────────────────────
    for batch_id in (range(n_batches) if not send_all else [0]):
        batch = get_batch_controls(
            scope_id, batch_id, send_all, pairs_df, expanded_df)
        if len(batch) == 0:
            continue

        n_sub = max(1, (len(batch) + SUB_BATCH_SIZE - 1) // SUB_BATCH_SIZE)
        for sub_idx in range(n_sub):
            sub = batch.iloc[
                sub_idx*SUB_BATCH_SIZE:(sub_idx+1)*SUB_BATCH_SIZE
            ].reset_index(drop=True)
            if len(sub) == 0:
                continue

            bk = f"p1::{scope_id}::{batch_id}::{sub_idx}"
            if bk in done_p1:
                continue

            prompt = build_pass1_prompt(scope_id, ct_ref, bk, sub)
            result, usage = call_llm(prompt, bk, log)
            total_in  += usage.get("input_tokens", 0)
            total_out += usage.get("output_tokens", 0)

            if result is None:
                write_checkpoint({
                    "batch_key": bk, "scope_id": scope_id,
                    "pass": 1, "error": True,
                    "control_assessments": [],
                    "control_ids_in_batch": sub["Control_ID"].tolist(),
                }, ck1_path)
            else:
                result.update({
                    "batch_key":   bk,
                    "scope_id":    scope_id,
                    "ct_ref":      ct_ref,
                    "pass":        1,
                    "error":       False,
                    "control_ids_in_batch": sub["Control_ID"].tolist(),
                    "input_tokens":  usage.get("input_tokens",0),
                    "output_tokens": usage.get("output_tokens",0),
                    "prompt_version": PROMPT_VERSION,
                })
                write_checkpoint(result, ck1_path)
                done_p1[bk] = result

            time.sleep(SLEEP_BETWEEN)

    # ── Gather all pass-1 assessments for this scope ─────────────────────────
    pass1_summaries = []
    expected_nature = CT_PRINCIPLES.get(
        ct_ref, FALLBACK_PRINCIPLES
    ).get("expected_nature", "")
    for key, rec in done_p1.items():
        if (f"p1::{scope_id}::" in key and
                not rec.get("error") and rec.get("pass") == 1):
            for a in rec.get("control_assessments", []):
                # Enrich with linkage metrics from expanded_df if LLM missed them
                cid = a.get("control_id","")
                row = all_scope[all_scope["Control_ID"]==cid]
                if not row.empty:
                    r = row.iloc[0]
                    a.setdefault("n_linked_products",
                                 int(r.get("n_linked_products", 0)))
                    a.setdefault("n_linked_apps",
                                 int(r.get("n_linked_apps", 0)))
                    a.setdefault("n_linked_processes",
                                 int(r.get("n_linked_processes", 0)))
                    source_nature = r.get("CTRL_NATRE", "")
                    source_type = r.get("CTRL_TYP", "")
                    source_nature = (
                        "" if pd.isna(source_nature) else str(source_nature).strip()
                    )
                    source_type = (
                        "" if pd.isna(source_type) else str(source_type).strip()
                    )
                    a["control_nature"] = source_nature
                    a["control_type"] = source_type
                    a["population"] = (
                        "Automated"
                        if source_type.casefold() == "automated"
                        else "Manual"
                    )
                    if source_nature and expected_nature:
                        a["nature_alignment"] = (
                            "Aligned"
                            if source_nature.casefold() == expected_nature.casefold()
                            else "Not Aligned"
                        )
                # Ensure new fields present with defaults
                a.setdefault("objective_alignment", "")
                a.setdefault("nature_alignment", "")
                a.setdefault("control_type", a.get("control_nature",""))
                pass1_summaries.append(a)

    if not pass1_summaries:
        log.warning(f"  {scope_id}: no pass-1 results, skipping pass 2")
        return total_in, total_out

    # ── Pass 2: ranking + rationalisation ────────────────────────────────────
    p2_key = f"p2::{scope_id}"
    if p2_key not in done_p2:
        log.info(f"  {scope_id}: running Pass 2 with "
                 f"{len(pass1_summaries)} assessed controls")
        prompt = build_pass2_prompt(scope_id, ct_ref, pass1_summaries)
        result, usage = call_llm(prompt, p2_key, log)
        total_in  += usage.get("input_tokens", 0)
        total_out += usage.get("output_tokens", 0)

        if result is None:
            write_checkpoint({
                "batch_key": p2_key, "scope_id": scope_id,
                "pass": 2, "error": True,
            }, ck2_path)
        else:
            result.update({
                "batch_key":    p2_key,
                "scope_id":     scope_id,
                "ct_ref":       ct_ref,
                "pass":         2,
                "error":        False,
                "n_controls":   len(pass1_summaries),
                "input_tokens": usage.get("input_tokens",0),
                "output_tokens":usage.get("output_tokens",0),
                "prompt_version": PROMPT_VERSION,
            })
            write_checkpoint(result, ck2_path)
            done_p2[p2_key] = result
        time.sleep(SLEEP_BETWEEN)

    return total_in, total_out

