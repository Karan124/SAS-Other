"""Phase 3 - population preflight and model-ready preparation. No model calls."""
import json
from datetime import datetime
import pandas as pd
from rl_config import ROOT
from p1_prepare_reference import (SRC, REF_IDS, SUPPLIER, PROMPT_CONTENT, TRIAGE_FIELDS, CONTROL, LATER,
                                  DATE_COLS, WIN_START, WIN_END, fmt, prep_actns, prep_upd)

OLD_SRC = ROOT / "00_source" / "incidents" / "incidents_population_20261027.xlsx"
OUT_JSONL = ROOT / "02_prepared" / "population_model_ready.jsonl"
OUT_A = ROOT / "04_outputs" / "a_population.xlsx"
OUT_PF = ROOT / "04_outputs" / "preflight.xlsx"


def build(row):
    inc = row["INC_ID"]
    v = {c: fmt(row[c]) for c in PROMPT_CONTENT}
    actns, cut = prep_actns(row["INC_ACTNS_TO_RECTFY_OR_PRVNT_REO"])
    upd, _, n_res = prep_upd(row["INC_LAST_PRCSS_UPD"])
    upd_dt, acc = row["INC_LAST_PRCSS_UPD_DT"], row["INC_OWNR_ACCEP_DT"]
    lbl = "after CA creation" if pd.notna(upd_dt) and pd.notna(acc) and upd_dt > acc else "timing unknown"
    tri = "\n".join([f"INC_ID: {inc}"] + [f"{c}: {v[c]}" for c in TRIAGE_FIELDS])
    tpl = "\n".join(
        ["record_basis: Current record", "mode: A", "triage_route: <<TRIAGE_ROUTE>>",
         "instruction: Take triage_route as Step 1 and start at Step 2.", f"INC_ID: {inc}"]
        + [f"{c}: {v[c]}" for c in PROMPT_CONTENT]
        + [f"INC_ACTNS_TO_RECTFY_OR_PRVNT_REO (timing unknown): {actns}",
           f"INC_LAST_PRCSS_UPD ({fmt(upd_dt)}, {lbl}): {upd}"])
    return tri, tpl, cut, actns == "blank", n_res


def main():
    df = pd.read_excel(SRC, dtype={"INC_ID": str})
    if SUPPLIER not in df.columns:
        alt = [c for c in df.columns if c.startswith(SUPPLIER)]
        df = df.rename(columns={alt[0]: SUPPLIER})
    df["INC_ID"] = df["INC_ID"].str.strip()
    for c in DATE_COLS:
        df[c] = pd.to_datetime(df[c], errors="coerce")
    d = df["INC_ENTRY_DT"].dt.normalize()
    df["in_population"] = (d.between(WIN_START, WIN_END)
                           & (df["INC_POTNL_COMPL_IMPCT"].astype(str).str.strip() == "Yes")
                           & (df["INC_STUS"].astype(str).str.strip() != "Rejected"))
    df["Month"] = df["INC_ENTRY_DT"].dt.strftime("%Y-%m")
    pop = df[df["in_population"]]

    print(f"Source: {SRC.name} | rows={len(df):,}")
    print(f"\n(a) POPULATION: {len(pop):,} | reference cases outside it added for assessment: "
          f"{int((~df['in_population'] & df['INC_ID'].isin(REF_IDS)).sum())} | "
          f"other rows outside: {int((~df['in_population'] & ~df['INC_ID'].isin(REF_IDS)).sum())}")
    print(f"duplicate INC_IDs: {int(pop['INC_ID'].duplicated().sum())}")

    by_month = pop["Month"].value_counts().sort_index()
    print("\nby month of INC_ENTRY_DT:\n" + by_month.to_string())
    by_folder = pop["INC_FLDR_LVL_2"].fillna("blank").value_counts()
    print(f"\nby INC_FLDR_LVL_2 ({len(by_folder)} values, top 20):\n" + by_folder.head(20).to_string())
    status = pop["INC_STUS"].fillna("blank").value_counts()
    print("\nINC_STUS:\n" + status.to_string())
    print(f"\nUnassigned: {int((pop['INC_STUS'] == 'Unassigned').sum()):,}")
    desc_len = pop["INC_DESC"].fillna("").astype(str).str.strip().str.len()
    print(f"INC_DESC under 200 chars: {int((desc_len < 200).sum()):,} (blank: {int((desc_len == 0).sum())})")
    print(f"INC_BULK_INC = Yes: {int((pop['INC_BULK_INC'].astype(str).str.strip() == 'Yes').sum()):,} | "
          f"NEAR_MISS = Yes: {int((pop['NEAR_MISS'].astype(str).str.strip() == 'Yes').sum()):,}")
    print("CA exists split: pending CA dataset (Phase 6)")

    if OLD_SRC.exists():
        old = set(pd.read_excel(OLD_SRC, usecols=["INC_ID"], dtype={"INC_ID": str})["INC_ID"].str.strip())
        new = set(pop["INC_ID"])
        print(f"\nvs earlier 15-col file: earlier={len(old):,} | in both={len(old & new):,} | "
              f"earlier only={len(old - new):,} | new only={len(new - old):,}")

    run = df[df["in_population"] | df["INC_ID"].isin(REF_IDS)]
    stamp = datetime.now().isoformat(timespec="seconds")
    n_cut = n_blank = n_res = 0
    with open(OUT_JSONL, "w", encoding="utf-8") as f:
        for _, row in run.iterrows():
            tri, tpl, cut, ablank, res = build(row)
            n_cut += cut
            n_blank += cut and ablank
            n_res += res > 0
            f.write(json.dumps({"INC_ID": row["INC_ID"], "in_population": bool(row["in_population"]),
                                "is_reference": row["INC_ID"] in REF_IDS, "INC_ENTRY_DT": fmt(row["INC_ENTRY_DT"]),
                                "source_file": SRC.name, "prepared_at": stamp,
                                "triage_user_message": tri, "assessment_user_template": tpl},
                               ensure_ascii=False) + "\n")
    print(f"\nprep: recommendation tail cut={n_cut:,} (left actions blank={n_blank:,}) | "
          f"'Updated by' residual={n_res}")

    a = pop[["INC_ID", "INC_ENTRY_DT", "Month", "INC_FLDR_LVL_2", "INC_PRD_LVL_1", "INC_PRD_LVL_2", "INC_STUS"]].copy()
    a["INC_ENTRY_DT"] = a["INC_ENTRY_DT"].dt.strftime("%Y-%m-%d")
    a["CA exists"] = "pending CA join"
    a.to_excel(OUT_A, index=False)
    with pd.ExcelWriter(OUT_PF) as w:
        by_month.rename("count").to_frame().to_excel(w, sheet_name="by_month")
        by_folder.rename("count").to_frame().to_excel(w, sheet_name="by_folder")
        pd.crosstab(pop["INC_FLDR_LVL_2"].fillna("blank"), pop["Month"]).to_excel(w, sheet_name="folder_x_month")
        status.rename("count").to_frame().to_excel(w, sheet_name="status")
    print(f"\nWrote {OUT_JSONL.name} ({len(run):,} records), {OUT_A.name}, {OUT_PF.name}")


if __name__ == "__main__":
    main()
