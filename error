def build_batch_prompt(
    controls: list[dict[str, str]],
    mini_framework: str,
    batch_number: int,
    total_batches: int,
) -> str:
    """Build the user prompt for a single batch of controls."""
    lines = [
        f"BATCH {batch_number} of {total_batches}",
        f"Controls in this batch: {len(controls)}",
        "",
        "CLASSIFICATION REFERENCE (apply consistently):",
        mini_framework,
        "",
        "CONTROLS TO ASSESS:",
        "",
    ]
    for i, ctrl in enumerate(controls, 1):
        lines += [
            f"--- Control {i} ---",
            f"Control Name:      {ctrl.get('control_name', '')}",
            f"Control Objective: {ctrl.get('control_objective', '')}",
            f"Description:       {ctrl.get('description', '')}",
            "",
        ]
    lines += [
        "Return a JSON array with one object per control, in order.",
        "control_number must match the 1-based position above.",
        "JSON only. No markdown. No code fences.",
    ]
    return "\n".join(lines)


# ─────────────────────────────────────────────────────────────────────────────
#  MINI CLASSIFICATION FRAMEWORK
# ─────────────────────────────────────────────────────────────────────────────

def generate_mini_framework(log: logging.Logger) -> str:
    """
    Call the LLM once to generate a reusable classification reference
    that is injected into every subsequent batch prompt.
    """
    log.info("Generating mini classification framework...")
    for attempt in range(1, RETRY_COUNT + 1):
        try:
            client = make_client()
            resp = client.chat.completions.create(
                model=MODEL,
                messages=[{"role": "user", "content": MINI_FRAMEWORK_PROMPT}],
                reasoning_effort=REASONING_EFFORT,
                max_completion_tokens=1000,
            )
            framework = resp.choices[0].message.content or ""
            log.info(f"  Framework generated ({len(framework.splitlines())} lines)")
            log.debug(f"  Framework:\n{framework}")
            return framework.strip()
        except Exception as exc:
            wait = min(RETRY_WAIT_BASE * 2 ** (attempt - 1), 60)
            log.warning(f"  Framework attempt {attempt}: {exc}. Wait {wait}s...")
            time.sleep(wait)
    log.warning("  Framework generation failed — using built-in fallback.")
    return (
        "System generates report reviewed by analyst -> ITDMC\n"
        "Workflow routes approval to reviewer -> ITDMC\n"
        "Dashboard reviewed monthly by manager -> ITDMC\n"
        "Alert sent to analyst who investigates -> ITDMC\n"
        "Data extract downloaded, manually reconciled -> ITDMC\n"
        "Automated transaction blocking based on rules -> MAC\n"
        "Automated exception detection + manual review and sign-off -> MAC\n"
        "System performs automated reconciliation before human review -> MAC\n"
        "Automated matching of transactions + manual resolution of breaks -> MAC\n"
        "System enforces business rule limits; reviewer approves exceptions -> MAC\n"
        "Automated duplicate payment detection + manual investigation -> MAC\n"
        "System validates mandatory fields; reviewer approves release -> MAC"
    )


# ─────────────────────────────────────────────────────────────────────────────
#  RESPONSE PARSING AND VALIDATION
# ─────────────────────────────────────────────────────────────────────────────

def strip_fences(text: str) -> str:
    """Remove markdown code fences if the model added them despite instructions."""
    import re
    text = re.sub(r"^```(?:json)?\s*", "", text.strip())
    text = re.sub(r"\s*```$", "", text)
    return text.strip()


def validate_batch_response(
    data: Any,
    expected_count: int,
) -> list[dict]:
    """
    Validate the parsed JSON response from a batch call.
    Returns the list of assessment dicts if valid.
    Raises ValueError with a descriptive message if not.
    """
    if not isinstance(data, list):
        raise ValueError(f"Expected JSON array, got {type(data).__name__}")
    if len(data) != expected_count:
        raise ValueError(
            f"Expected {expected_count} results, got {len(data)}"
        )
    for i, item in enumerate(data, 1):
        missing = REQUIRED_FIELDS - set(item.keys())
        if missing:
            raise ValueError(f"Item {i} missing fields: {missing}")
        clf = item.get("classification", "")
        if clf not in VALID_CLASSIFICATIONS:
            raise ValueError(
                f"Item {i} has invalid classification '{clf}' "
                f"(must be ITDMC or MAC)"
            )
    return data


# ─────────────────────────────────────────────────────────────────────────────
#  BATCH API CALL WITH RETRY
# ─────────────────────────────────────────────────────────────────────────────

def call_batch(
    controls: list[dict[str, str]],
    mini_framework: str,
    batch_number: int,
    total_batches: int,
    log: logging.Logger,
) -> tuple[list[dict], dict]:
    """
    Send one batch to the LLM and return (assessments, usage_dict).
    Retries up to RETRY_COUNT times on failure or invalid response.
    """
    prompt = build_batch_prompt(
        controls, mini_framework, batch_number, total_batches
    )
    usage: dict = {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0}

    for attempt in range(1, RETRY_COUNT + 1):
        try:
            client = make_client()
            resp = client.chat.completions.create(
                model=MODEL,
                messages=[
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user",   "content": prompt},
                ],
                reasoning_effort=REASONING_EFFORT,
                max_completion_tokens=MAX_COMPLETION_TOKENS,
                temperature=0,
            )
            raw_text = resp.choices[0].message.content or ""

            # Token usage
            u = getattr(resp, "usage", None)
            if u:
                usage = {
                    "prompt_tokens":     getattr(u, "prompt_tokens", 0),
                    "completion_tokens": getattr(u, "completion_tokens", 0),
                    "total_tokens":      getattr(u, "total_tokens", 0),
                }

            # Parse and validate
            cleaned = strip_fences(raw_text)
            parsed  = json.loads(cleaned)
            results = validate_batch_response(parsed, len(controls))

            log.debug(
                f"  Batch {batch_number} OK — "
                f"tokens: {usage['total_tokens']:,}"
            )
            return results, usage

        except (json.JSONDecodeError, ValueError) as exc:
            wait = min(RETRY_WAIT_BASE * 2 ** (attempt - 1), 60)
            log.warning(
                f"  Batch {batch_number} validation error (attempt {attempt}): "
                f"{exc}. Retrying in {wait}s..."
            )
            time.sleep(wait)

        except Exception as exc:
            is_conn = any(
                w in str(exc).lower()
                for w in ["connection", "timed out", "timeout", "proxy"]
            )
            wait = 90 if is_conn else min(
                RETRY_WAIT_BASE * 2 ** (attempt - 1), 60
            )
            log.warning(
                f"  Batch {batch_number} API error (attempt {attempt}): "
                f"{exc}. Retrying in {wait}s..."
            )
            time.sleep(wait)

    log.error(f"  Batch {batch_number}: all {RETRY_COUNT} retries exhausted.")
    return [], usage


# ─────────────────────────────────────────────────────────────────────────────
