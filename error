def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force",    action="store_true",
                        help="Clear checkpoints and restart.")
    parser.add_argument("--sample",   action="store_true",
                        help=f"Run sample only: {SAMPLE_CT}")
    parser.add_argument("--ct-range", nargs=2, type=int,
                        metavar=("START","END"),
                        help="Process CT scopes[START:END] only.")
    parser.add_argument("--suffix",   default="",
                        help="Checkpoint/log suffix for parallel runs.")
    args = parser.parse_args()

    log = get_logger(args.suffix)
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 3 (Dimension 2: Gold Controls)")
    log.info(f"  Model         : {LLM_MODEL} (low reasoning)")
    log.info(f"  Sub-batch     : {SUB_BATCH_SIZE} controls per Pass 1 call")
    log.info(f"  Sample mode   : {args.sample}"
             + (f" → {SAMPLE_CT}" if args.sample else ""))
    log.info(f"  Started       : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    for f in [EXPANDED_PARQUET, SCOPE_CT_PARQUET, CAND_CT_PARQUET, RUN_CONFIG]:
        if not f.exists():
            log.error(f"Required input not found: {f.name}. "
                      f"Run Scripts 1 and 2 first.")
            sys.exit(1)

    ck1_path = OUTPUT_DIR / f"llm_checkpoint_ct_pass1{args.suffix}.jsonl"
    ck2_path = OUTPUT_DIR / f"llm_checkpoint_ct_pass2{args.suffix}.jsonl"

    if args.force:
        for ck in [ck1_path, ck2_path]:
            if ck.exists():
                ck.unlink()
                log.info(f"Checkpoint cleared: {ck.name}")

    log.info("Loading data...")
    expanded = pd.read_parquet(EXPANDED_PARQUET, engine="pyarrow")
    scope_df = pd.read_parquet(SCOPE_CT_PARQUET, engine="pyarrow")
    pairs_df = pd.read_parquet(CAND_CT_PARQUET,  engine="pyarrow")
    log.info(f"  {len(expanded):,} controls | "
