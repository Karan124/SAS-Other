change_summary:
  scripts:
    - file: 03_run_llm_ct.py
      purpose: "LLM assessment and ranking prompts"

      changes:
        - change: "Reordered best-of-breed ranking priorities"
          priority_order:
            1: "Design strength, including expected control-nature alignment"
            2: "Control-objective alignment"
            3: "Coverage across products, applications, and processes"

        - change: "Corrected source-field meanings"
          CTRL_NATRE: "Control Nature, e.g. Preventative or Detective"
          CTRL_TYP: "Control Type, e.g. Automated, Manual, or Manual-Automated"
          population_rule: "Automated only when CTRL_TYP is Automated; otherwise Manual"

        - change: "Made control-nature alignment source-driven"
          behavior:
            - "Uses CTRL_NATRE rather than LLM inference."
            - "Compares source nature with the CT group's expected nature."
            - "Sets alignment to Aligned or Not Aligned."

        - change: "Added a best-of-breed eligibility gate"
          rule: >
            If at least one aligned control exists within a population,
            Partially Aligned or Not Aligned controls cannot be ranked first
            or selected as Best-of-Breed.
          exception: >
            A non-aligned control may be selected only if no aligned control
            exists in that population, and the rationale must state this.

        - change: "Improved Pass 2 ranking context"
          added_fields:
            - "Control Type"
            - "Population"
            - "Source Control Nature"
            - "Objective Alignment"
            - "Nature Alignment"
            - "Design Strength"
            - "Coverage"

        - change: "Added prompt/checkpoint versioning"
          prompt_version: "2026-08-20-nature-gated-v1"
          behavior: >
            Existing checkpoint entries without the current prompt version are
            ignored by Script 03 and regenerated on the next run.

    - file: 04_postprocess_ct.py
      purpose: "Excel workbook generation"

      changes:
        - change: "Use most recent Pass 2 checkpoint result"
          behavior: >
            When a CT group has been rerun, the later checkpoint record
            supersedes the earlier record.

        - change: "Use source control attributes in output"
          source_fields:
            - "CTRL_NATRE for Control Nature"
            - "CTRL_TYP for Control Type"
          behavior: >
            Source values take precedence over LLM-provided values in workbook
            enrichment.

        - change: "Updated Best-of-Breed summary tables"
          added_column: "Control Nature"
          position: "Between Control ID and Design Strength"

        - change: "Updated ranked control tables"
          affected_tables:
            - "AUTOMATED POPULATION — RANKED CONTROLS"
            - "MANUAL / MANUAL-AUTOMATED POPULATION — RANKED CONTROLS"
          added_column: "Control Nature"
          position: "Immediately after Control Type"

        - change: "Restructured Design Principles Evaluation Detail"
          previous_layout: "One row per control-principle assessment"
          new_layout: "One row per control, with principles as columns"
          columns:
            - "Control ID"
            - "One assessment-status column per applicable principle"
            - "Overall Comments"
          overall_comments: "Combines principle notes and identified red flags."

        - change: "Separated CT4 design-principles sections by population"
          reason: >
            Automated controls use seven CT4 principles and Manual /
            Manual-Automated controls use six different CT4 principles.
          sections:
            - "DESIGN PRINCIPLES EVALUATION DETAIL — AUTOMATED"
            - "DESIGN PRINCIPLES EVALUATION DETAIL — MANUAL / MANUAL-AUTOMATED"
          result: >
            Removes the prior mixed 13-principle layout and avoids blank,
            non-applicable principle columns for each control.

        - change: "Replaced numeric CT4 principle labels with full principle text"
          example: >
            '1' becomes 'Validate file structure, record counts, and control
            totals before processing.'
