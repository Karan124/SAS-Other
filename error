def load_checkpoint(path: Path) -> set:
    done = set()
    if not path.exists():
        return done
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
                done.add(rec.get("batch_key", ""))
            except (json.JSONDecodeError, KeyError):
                continue
    done.discard("")
    return done


def write_checkpoint(rec: dict, path: Path) -> None:
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=True) + "\n")


# ─────────────────────────────────────────────────────────────────────────────
#  LLM CALL
# ─────────────────────────────────────────────────────────────────────────────

def parse_llm_response(text: str) -> dict:
    text = re.sub(r'^```(?:json)?\s*', '', (text or "").strip())
    text = re.sub(r'\s*```$', '', text).strip()
    if not text:
        raise ValueError("Empty response from model")
    try:
        result = json.loads(text)
    except json.JSONDecodeError:
        m = re.search(r'\{.*\}', text, re.DOTALL)
        if m:
            result = json.loads(m.group(0))
        else:
            raise
    if "assessments" not in result:
        raise ValueError("Response missing 'assessments' key")
    return result


def call_llm(client: AzureOpenAI,
             prompt: str,
             batch_key: str,
             log: logging.Logger) -> tuple:
    """Returns (parsed_result_or_None, usage_dict)."""
    usage = {"input_tokens": 0, "output_tokens": 0,
             "reasoning_tokens": 0, "latency_ms": 0}

    for attempt in range(1, RETRY_COUNT + 1):
        try:
            t0   = time.time()
            resp = client.chat.completions.create(
                model=LLM_MODEL,
                messages=[
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user",   "content": prompt},
                ],
                reasoning_effort="low",
                max_completion_tokens=MAX_COMPLETION_TOKENS,
            )
            latency = int((time.time() - t0) * 1000)
            text    = resp.choices[0].message.content or ""

            u = getattr(resp, "usage", None)
            if u:
                usage["input_tokens"]  = getattr(u, "prompt_tokens", 0)
                usage["output_tokens"] = getattr(u, "completion_tokens", 0)
                d = getattr(u, "completion_tokens_details", None)
                if d:
                    usage["reasoning_tokens"] = getattr(d, "reasoning_tokens", 0)
            usage["latency_ms"] = latency

            parsed = parse_llm_response(text)
            return parsed, usage

        except Exception as exc:
            if attempt < RETRY_COUNT:
                wait = min(RETRY_BASE * 2 ** (attempt - 1) + random.uniform(0, 2), 60)
                log.warning(f"  Attempt {attempt} failed [{batch_key}]: "
                            f"{exc}. Retrying in {wait:.0f}s...")
                time.sleep(wait)
            else:
                log.error(f"  All retries failed [{batch_key}]: {exc}")
                return None, usage


# ─────────────────────────────────────────────────────────────────────────────
#  SCOPE PROCESSING
# ─────────────────────────────────────────────────────────────────────────────

def get_scope_controls(scope_id: str,
                       pairs_df: pd.DataFrame,
                       expanded_df: pd.DataFrame) -> pd.DataFrame:
    """Return all unique controls that belong to this scope."""
    scope_pairs = pairs_df[pairs_df["scope_id"] == scope_id]
    ctrl_ids = set(scope_pairs["control_id_a"].dropna().tolist())
    ctrl_ids.update(
        c for c in scope_pairs["control_id_b"].dropna().tolist() if c
    )
    return (expanded_df[expanded_df["Control_ID"].isin(ctrl_ids)]
            .drop_duplicates(subset=["Control_ID"])
            .reset_index(drop=True))


def get_batch_controls(scope_id: str,
                       batch_id: int,
                       send_all: bool,
                       pairs_df: pd.DataFrame,
                       expanded_df: pd.DataFrame) -> pd.DataFrame:
    """Return controls assigned to a specific batch within a scope."""
    scope_pairs = pairs_df[pairs_df["scope_id"] == scope_id]

    if send_all:
        return get_scope_controls(scope_id, pairs_df, expanded_df)

    batch_pairs = scope_pairs[scope_pairs["batch_id"] == batch_id]
    ctrl_ids = set(batch_pairs["control_id_a"].dropna().tolist())
    return (expanded_df[expanded_df["Control_ID"].isin(ctrl_ids)]
            .drop_duplicates(subset=["Control_ID"])
            .reset_index(drop=True))


def process_scopes(client: AzureOpenAI,
                   scope_type: str,
                   scope_df: pd.DataFrame,
                   pairs_df: pd.DataFrame,
                   expanded_df: pd.DataFrame,
                   checkpoint_path: Path,
                   done_keys: set,
                   log: logging.Logger) -> float:
    """
    Process all scopes of one type. Returns total cost in AUD.

    For each scope:
      1. Get all controls in the scope.
      2. Split by batch_id (from Script 2).
      3. Further split each batch into sub-batches of SUB_BATCH_SIZE.
      4. Send each sub-batch to the LLM as one call.
      5. Checkpoint each sub-batch with key scope_id::batch_id::sub_idx.
    """
    total_in_tok = total_out_tok = 0
    n_processed  = n_skipped = n_errors = 0
    total_scopes = len(scope_df)
    run_start    = time.time()

    for row_num, scope_row in enumerate(scope_df.itertuples(index=False), 1):
        scope_id    = scope_row.scope_id
        send_all    = bool(getattr(scope_row, "send_all", True))
        n_controls  = int(getattr(scope_row, "n_controls", 0))
        n_batches   = int(getattr(scope_row, "n_batches", 1))
        skip_reason = getattr(scope_row, "skip_reason", "")

        # Skip single-control scopes — nothing to compare
        if skip_reason == "single_control" or n_controls < 2:
            n_skipped += 1
            bk = f"{scope_id}::0::0"
            if bk not in done_keys:
                write_checkpoint({
                    "batch_key":   bk,
                    "scope_id":    scope_id,
                    "scope_type":  scope_type,
                    "skipped":     True,
                    "skip_reason": "single_control",
                    "assessments": [],
                }, checkpoint_path)
                done_keys.add(bk)
            continue

        # Progress display
        elapsed = time.time() - run_start
        pct     = row_num / total_scopes * 100
        eta_s   = (elapsed / row_num) * (total_scopes - row_num) if row_num > 1 else 0
        eta_str = (f"{int(eta_s//3600)}h {int((eta_s%3600)//60)}m"
                   if eta_s > 60 else f"{int(eta_s)}s")
        cost    = ((total_in_tok / 1e6 * INPUT_PRICE_PER_M +
                    total_out_tok / 1e6 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
        print(f"\r  [{pct:5.1f}%] {scope_id[:55]:<55} "
              f"ETA {eta_str}  A${cost:.2f}", end="")

        # Build scope-level metadata for prompt context
        all_scope_controls = get_scope_controls(scope_id, pairs_df, expanded_df)
        n_scope_total      = len(all_scope_controls)

        if n_scope_total == 0:
            continue

        # Pull scope context from first matching row in expanded data
        scope_meta = {}
        if n_scope_total > 0:
            sample = all_scope_controls.iloc[0]
            for col in ["Product", "Payment Category", "Consolidated Stage",
                        "ct_ref_norm", "Expected CT Reference", "Expected Control"]:
                scope_meta[col] = str(sample.get(col, "") or "")

        # Determine batches
        batch_ids = list(range(n_batches)) if not send_all else [0]

        for batch_id in batch_ids:
            batch_controls = get_batch_controls(
                scope_id, batch_id, send_all, pairs_df, expanded_df)

            if len(batch_controls) == 0:
                continue

            # ── Sub-batch the batch into groups of SUB_BATCH_SIZE ─────────
            n_sub = max(1, (len(batch_controls) + SUB_BATCH_SIZE - 1)
                        // SUB_BATCH_SIZE)

            for sub_idx in range(n_sub):
                sub_controls = batch_controls.iloc[
                    sub_idx * SUB_BATCH_SIZE:(sub_idx + 1) * SUB_BATCH_SIZE
                ].reset_index(drop=True)

                if len(sub_controls) == 0:
                    continue

                batch_key = f"{scope_id}::{batch_id}::{sub_idx}"

                if batch_key in done_keys:
                    n_skipped += 1
                    continue

                # Build prompt
                if scope_type == "within_product":
                    prompt = build_within_product_prompt(
                        scope_id, batch_key, n_scope_total,
                        sub_controls, scope_meta)
                else:
                    ct_ref = scope_id.replace("CP|", "")
                    prompt = build_cross_product_prompt(
                        scope_id, batch_key, n_scope_total,
                        sub_controls, ct_ref)

                # Call LLM
                result, usage = call_llm(client, prompt, batch_key, log)

                in_tok  = usage.get("input_tokens", 0)
                out_tok = usage.get("output_tokens", 0)
                total_in_tok  += in_tok
                total_out_tok += out_tok

                if result is None:
                    n_errors += 1
                    write_checkpoint({
                        "batch_key":  batch_key,
                        "scope_id":   scope_id,
                        "scope_type": scope_type,
                        "error":      True,
                        "assessments": [],
                        "control_ids_in_batch": sub_controls["Control_ID"].tolist(),
                    }, checkpoint_path)
                else:
                    result["batch_key"]             = batch_key
                    result["scope_type"]            = scope_type
                    result["n_controls_in_batch"]   = len(sub_controls)
                    result["input_tokens"]          = in_tok
                    result["output_tokens"]         = out_tok
                    result["error"]                 = False
                    result["control_ids_in_batch"]  = sub_controls["Control_ID"].tolist()
                    write_checkpoint(result, checkpoint_path)
                    n_processed += 1

                done_keys.add(batch_key)
                time.sleep(SLEEP_BETWEEN)

    print()   # newline after progress bar
    cost_aud = ((total_in_tok / 1e6 * INPUT_PRICE_PER_M +
                 total_out_tok / 1e6 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
    log.info(f"  Processed: {n_processed:,} | Skipped: {n_skipped:,} | "
             f"Errors: {n_errors:,} | Cost: A${cost_aud:.2f}")
    return cost_aud


# ─────────────────────────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force",   action="store_true",
                        help="Clear checkpoints and reprocess everything.")
    parser.add_argument("--wp-only", action="store_true",
                        help="Run within-product scopes only.")
    parser.add_argument("--cp-only", action="store_true",
                        help="Run cross-product scopes only.")
    args = parser.parse_args()

    log = get_logger()
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 3: LLM Assessment")
    log.info(f"  Model          : {LLM_MODEL} (low reasoning)")
    log.info(f"  Sub-batch size : {SUB_BATCH_SIZE} controls per LLM call")
    log.info(f"  Started        : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    # ── Validate inputs ────────────────────────────────────────────────────
    for f in [EXPANDED_PARQUET, SCOPE_WP_PARQUET, SCOPE_CP_PARQUET,
              CAND_WP_PARQUET, CAND_CP_PARQUET, RUN_CONFIG]:
        if not f.exists():
            log.error(f"Required input not found: {f.name}. "
                      f"Run Scripts 1 and 2 first.")
            sys.exit(1)

    with open(RUN_CONFIG) as f:
        config = json.load(f)

    run_wp = config.get("run_within_product", True) and not args.cp_only
    run_cp = config.get("run_cross_product",  True) and not args.wp_only

    if args.force:
        for ck in [CHECKPOINT_WP, CHECKPOINT_CP]:
            if ck.exists():
                ck.unlink()
                log.info(f"Checkpoint cleared: {ck.name}")

    log.info("Loading data...")
    expanded = pd.read_parquet(EXPANDED_PARQUET, engine="pyarrow")
    log.info(f"  Expanded rows: {len(expanded):,}")

    log.info("Initialising Azure OpenAI client...")
    client = init_client()
    log.info("Client ready.")

    total_cost = 0.0

    if run_wp:
        log.info("\nProcessing within-product scopes...")
        scope_wp = pd.read_parquet(SCOPE_WP_PARQUET, engine="pyarrow")
        pairs_wp = pd.read_parquet(CAND_WP_PARQUET, engine="pyarrow")
        done_wp  = load_checkpoint(CHECKPOINT_WP)
        log.info(f"  Total WP scopes : {len(scope_wp):,} | "
                 f"Already done keys: {len(done_wp):,}")
        cost = process_scopes(client, "within_product",
                              scope_wp, pairs_wp, expanded,
                              CHECKPOINT_WP, done_wp, log)
        total_cost += cost

    if run_cp:
        log.info("\nProcessing cross-product scopes...")
        scope_cp = pd.read_parquet(SCOPE_CP_PARQUET, engine="pyarrow")
        pairs_cp = pd.read_parquet(CAND_CP_PARQUET, engine="pyarrow")
        done_cp  = load_checkpoint(CHECKPOINT_CP)
        log.info(f"  Total CP scopes : {len(scope_cp):,} | "
                 f"Already done keys: {len(done_cp):,}")
        cost = process_scopes(client, "cross_product",
                              scope_cp, pairs_cp, expanded,
                              CHECKPOINT_CP, done_cp, log)
        total_cost += cost

    config["step3_completed_at"]    = datetime.now().isoformat()
    config["step3_total_cost_aud"]  = round(total_cost, 2)
    config["step3_sub_batch_size"]  = SUB_BATCH_SIZE
    with open(RUN_CONFIG, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)

    log.info("=" * 70)
    log.info(f"  Step 3 complete. Total cost: A${total_cost:.2f}")
    log.info("  Run 04_postprocess_outputs.py next.")
    log.info("=" * 70)


if __name__ == "__main__":
    main()
