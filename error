                        help="Run cross-product scopes only.")
    args = parser.parse_args()

    log = get_logger()
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 3: LLM Assessment")
    log.info(f"  Model    : {LLM_MODEL} (medium reasoning)")
    log.info(f"  Started  : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    # ── Validate inputs ────────────────────────────────────────────────────
    for f in [EXPANDED_PARQUET, SCOPE_WP_PARQUET, SCOPE_CP_PARQUET,
              CAND_WP_PARQUET, CAND_CP_PARQUET, RUN_CONFIG]:
        if not f.exists():
            log.error(f"Required input not found: {f.name}. "
                      f"Run Scripts 1 and 2 first.")
            sys.exit(1)

    with open(RUN_CONFIG) as f:
        config = json.load(f)

    run_wp = config.get("run_within_product", True) and not args.cp_only
    run_cp = config.get("run_cross_product",  True) and not args.wp_only

    # ── Clear checkpoints if --force ───────────────────────────────────────
    if args.force:
        for ck in [CHECKPOINT_WP, CHECKPOINT_CP]:
            if ck.exists():
                ck.unlink()
                log.info(f"Checkpoint cleared: {ck.name}")

    # ── Load data ──────────────────────────────────────────────────────────
    log.info("Loading data...")
    expanded = pd.read_parquet(EXPANDED_PARQUET, engine="pyarrow")
    log.info(f"  Expanded rows: {len(expanded):,}")

    # ── Init client ────────────────────────────────────────────────────────
    log.info("Initialising Azure OpenAI client...")
    client = init_client()
    log.info("Client ready.")

    total_cost = 0.0

    # ── Within-product ─────────────────────────────────────────────────────
    if run_wp:
        log.info("\nProcessing within-product scopes...")
        scope_wp = pd.read_parquet(SCOPE_WP_PARQUET, engine="pyarrow")
        pairs_wp = pd.read_parquet(CAND_WP_PARQUET, engine="pyarrow")
        done_wp  = load_checkpoint(CHECKPOINT_WP)

        # Merge scope metadata into scope summary
        scope_context = (expanded[["Product","Payment Category",
                                   "Consolidated Stage","ct_ref_norm",
                                   "Expected CT Reference","Expected Control"]]
                         .drop_duplicates())

        log.info(f"  Total WP scopes : {len(scope_wp):,} "
                 f"| Already done: {len(done_wp):,}")

        n_proc, n_skip, cost = process_scopes(
            client, "within_product",
            scope_wp, pairs_wp, expanded,
            CHECKPOINT_WP, done_wp, config, log)
        total_cost += cost

    # ── Cross-product ──────────────────────────────────────────────────────
    if run_cp:
        log.info("\nProcessing cross-product scopes...")
        scope_cp = pd.read_parquet(SCOPE_CP_PARQUET, engine="pyarrow")
        pairs_cp = pd.read_parquet(CAND_CP_PARQUET, engine="pyarrow")
        done_cp  = load_checkpoint(CHECKPOINT_CP)

        log.info(f"  Total CP scopes : {len(scope_cp):,} "
                 f"| Already done: {len(done_cp):,}")

        n_proc, n_skip, cost = process_scopes(
            client, "cross_product",
            scope_cp, pairs_cp, expanded,
            CHECKPOINT_CP, done_cp, config, log)
        total_cost += cost

    # Update config
    config["step3_completed_at"] = datetime.now().isoformat()
    config["step3_total_cost_aud"] = round(total_cost, 2)
    with open(RUN_CONFIG, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)

    log.info("=" * 70)
    log.info(f"  Step 3 complete. Total cost: A${total_cost:.2f}")
    log.info("  Run 04_postprocess_outputs.py next.")
    log.info("=" * 70)


if __name__ == "__main__":
    main()
