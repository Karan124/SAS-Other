"""Shared settings for the RL compliance run. No secrets in this file."""
import os, hashlib, textwrap
from pathlib import Path

ROOT = Path(r"C:\Users\M061400\ai-test\rl_compliance")

AZURE_ENDPOINT = "https://ai.eng.azure.srv.westpac.com.au"
API_VERSION = "2024-10-21"
MODEL = "gpt-5.4"
MAX_COMPLETION_TOKENS = 12000

# Fixed for the run once confirmed at the Phase 0 checkpoint.
REASONING_EFFORT = {"triage": "medium", "assessment": "medium"}

INPUT_PRICE_USD_PER_M = 1.75
OUTPUT_PRICE_USD_PER_M = 14.00

PROMPT_FILES = {
    "triage": ("triage_v0.3.txt", "triage_v0.3"),
    "assessment": ("assessment_v0.4.txt", "assessment_v0.4"),
}


def load_prompt(step):
    """Return (text, version, sha256[:12]). Text is dedented and stripped only."""
    fname, ver = PROMPT_FILES[step]
    txt = textwrap.dedent((ROOT / "01_prompt" / fname).read_text(encoding="utf-8")).strip()
    return txt, ver, hashlib.sha256(txt.encode("utf-8")).hexdigest()[:12]


def get_client():
    """Return (client, auth_method). Uses an env key if present, else Azure AD sign-in."""
    from openai import AzureOpenAI
    key = os.environ.get("AZURE_OPENAI_API_KEY")
    if key:
        return AzureOpenAI(azure_endpoint=AZURE_ENDPOINT, api_version=API_VERSION, api_key=key), "api_key_env"
    try:
        from azure.identity import DefaultAzureCredential, get_bearer_token_provider
    except ImportError:
        raise SystemExit("AUTH: no AZURE_OPENAI_API_KEY and azure-identity not installed. "
                         "Paste the client-creation lines from your existing script (no secrets).")
    tp = get_bearer_token_provider(DefaultAzureCredential(),
                                   "https://cognitiveservices.azure.com/.default")
    return AzureOpenAI(azure_endpoint=AZURE_ENDPOINT, api_version=API_VERSION,
                       azure_ad_token_provider=tp), "azure_ad"



