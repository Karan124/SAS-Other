import json
import logging
import re
import sys
from datetime import datetime
from pathlib import Path

import pandas as pd

# ─────────────────────────────────────────────────────────────────────────────
#  CONFIGURATION — update paths here if they change
# ─────────────────────────────────────────────────────────────────────────────

FILE_CTRL_DETAILS    = Path(r"C:\Users\M061400\ai-test\big_table\duplicates\product\raw\ctrl_details.xlsx")
FILE_PRODUCT_CLUSTERS= Path(r"C:\Users\M061400\ai-test\big_table\duplicates\product\raw\product_clusters.xlsx")
OUTPUT_DIR           = Path(r"C:\Users\M061400\ai-test\big_table\duplicates\product\output")

# Similarity threshold used in Script 2 (saved to run_config.json)
SIMILARITY_THRESHOLD        = 0.78
MAX_CONTROLS_PER_LLM_CALL   = 20   # groups larger than this are chunked in Script 2
LLM_TEMPERATURE             = 0
RETRY_COUNT                 = 3
FORCE_REFRESH_EMBEDDINGS    = False
INCLUDE_CTRL_OWNER          = False   # exclude owner from embedding / LLM payloads
RUN_WITHIN_PRODUCT          = True
RUN_CROSS_PRODUCT           = True

# ─────────────────────────────────────────────────────────────────────────────
#  REQUIRED COLUMNS
# ─────────────────────────────────────────────────────────────────────────────

CTRL_REQUIRED_COLS = [
    "Control_ID", "CTRL_NAME",
]

CTRL_OPTIONAL_COLS = [
    "CTRL_NATRE", "CTRL_STUS", "CTRL_OWNER", "CTRL_FREQ", "CTRL_KEY_CONTRL",
    "Control Objective", "CTRL_TYP", "CTRL_ASSESS_RTNG",
    "CTRL_CTGRY_1", "CTRL_CTGRY_2", "CTRL_OE_RTNG", "CTRL_DE_RTNG",
    "CTRL_LOC_LIST", "CTRL_EVDNCD", "CTRL_MNTRD", "CTRL_CATEGORY",
    "Control Description", "CTRL_FLDR", "object_path_leaf",
    "CTRL_FLDR_LVL_2(Division)", "gold_control",
]

CLUSTER_REQUIRED_COLS = [
    "Product", "Payment Category", "Consolidated Stage",
    "Expected CT Reference", "Expected Control", "Unique Control IDs",
]

# ─────────────────────────────────────────────────────────────────────────────
#  LOGGING
# ─────────────────────────────────────────────────────────────────────────────

def setup_logging() -> logging.Logger:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    log_path = OUTPUT_DIR / "processing_log.txt"
    logger = logging.getLogger("ctrl_rat")
    logger.setLevel(logging.DEBUG)
    # File handler — append so all four scripts share one log
    fh = logging.FileHandler(log_path, encoding="utf-8")
    fh.setLevel(logging.DEBUG)
    # Console handler
    ch = logging.StreamHandler(sys.stdout)
    ch.setLevel(logging.INFO)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s",
                            datefmt="%Y-%m-%d %H:%M:%S")
    fh.setFormatter(fmt)
    ch.setFormatter(fmt)
    if not logger.handlers:
        logger.addHandler(fh)
        logger.addHandler(ch)
    return logger

# ─────────────────────────────────────────────────────────────────────────────
#  HELPERS
# ─────────────────────────────────────────────────────────────────────────────

def safe_str(val, default: str = "") -> str:
    if pd.isna(val):
        return default
    s = str(val).replace("\t", " ").replace("\r", " ").replace("\n", " ")
    return re.sub(r" {2,}", " ", s).strip()

def is_blank(val) -> bool:
    return safe_str(val) == ""

def normalise_ct_reference(val) -> str | None:
    """
    Normalise CT reference to canonical form: CT1, CT2, ... CT28.
    Handles: 'CT1', 'CT 1', 'CT-1', 'ct1', ' CT 1 ', 'CT01'.
    Returns None for unrecognisable values.
    """
    if pd.isna(val) or safe_str(val) == "":
        return None
    s = safe_str(val).upper()
    m = re.match(r'^CT\s*[-]?\s*0*(\d+)$', s)
    if m:
        n = int(m.group(1))
        return f"CT{n}" if 1 <= n <= 28 else None
    return None

def clean_cols(df: pd.DataFrame) -> pd.DataFrame:
    """Strip whitespace from column names only. Preserve original names."""
    df.columns = df.columns.str.strip()
    return df

# ─────────────────────────────────────────────────────────────────────────────
#  LOAD AND VALIDATE
# ─────────────────────────────────────────────────────────────────────────────

def load_inputs(log: logging.Logger) -> tuple[pd.DataFrame, pd.DataFrame]:
    for f in [FILE_CTRL_DETAILS, FILE_PRODUCT_CLUSTERS]:
        if not f.exists():
            log.error(f"Input file not found: {f}")
            sys.exit(1)

    log.info(f"Loading ctrl_details: {FILE_CTRL_DETAILS.name}")
    ctrl = clean_cols(pd.read_excel(FILE_CTRL_DETAILS, dtype=str, engine="openpyxl"))
    log.info(f"  Rows: {len(ctrl):,} | Columns: {len(ctrl.columns)}")

    log.info(f"Loading product_clusters: {FILE_PRODUCT_CLUSTERS.name}")
    clusters = clean_cols(pd.read_excel(FILE_PRODUCT_CLUSTERS, dtype=str, engine="openpyxl"))
    log.info(f"  Rows: {len(clusters):,} | Columns: {len(clusters.columns)}")

    return ctrl, clusters

def validate_columns(ctrl: pd.DataFrame, clusters: pd.DataFrame,
                     log: logging.Logger) -> None:
    missing_ctrl = [c for c in CTRL_REQUIRED_COLS if c not in ctrl.columns]
    missing_clus = [c for c in CLUSTER_REQUIRED_COLS if c not in clusters.columns]
    if missing_ctrl:
        log.error(f"ctrl_details missing required columns: {missing_ctrl}")
        sys.exit(1)
    if missing_clus:
        log.error(f"product_clusters missing required columns: {missing_clus}")
        sys.exit(1)

    optional_missing = [c for c in CTRL_OPTIONAL_COLS if c not in ctrl.columns]
    if optional_missing:
        log.warning(f"ctrl_details optional columns not found (will be blank): "
                    f"{optional_missing}")
    log.info("Column validation passed.")

# ─────────────────────────────────────────────────────────────────────────────
#  NORMALISE
# ─────────────────────────────────────────────────────────────────────────────

def normalise_ctrl_details(ctrl: pd.DataFrame, log: logging.Logger) -> pd.DataFrame:
    ctrl["Control_ID"] = ctrl["Control_ID"].apply(safe_str)
    # Normalise gold_control to canonical CT form
    if "gold_control" in ctrl.columns:
        ctrl["gold_control_norm"] = ctrl["gold_control"].apply(normalise_ct_reference)
    else:
        ctrl["gold_control_norm"] = None
    # Normalise all text fields
    for col in ctrl.columns:
        if col not in ["Control_ID", "gold_control_norm"]:
            ctrl[col] = ctrl[col].apply(safe_str)
    # Dedup on Control_ID
    dups = ctrl[ctrl["Control_ID"].duplicated(keep=False)]["Control_ID"].unique()
    if len(dups):
        log.warning(f"{len(dups)} duplicate Control_ID(s) in ctrl_details: "
                    f"{list(dups)[:5]}")
    ctrl = ctrl.drop_duplicates(subset=["Control_ID"], keep="first")
    log.info(f"ctrl_details after dedup: {len(ctrl):,} unique controls")
    return ctrl

def normalise_clusters(clusters: pd.DataFrame, log: logging.Logger) -> pd.DataFrame:
    for col in clusters.columns:
        clusters[col] = clusters[col].apply(safe_str)
    clusters["ct_ref_norm"] = clusters["Expected CT Reference"].apply(
        normalise_ct_reference)
    n_bad_ct = clusters["ct_ref_norm"].isna().sum()
    if n_bad_ct:
        log.warning(f"{n_bad_ct} cluster rows with unrecognisable CT reference — "
                    f"they will be excluded from assessment.")
    return clusters

# ─────────────────────────────────────────────────────────────────────────────
#  EXPAND PRODUCT CLUSTERS
# ─────────────────────────────────────────────────────────────────────────────

def expand_product_clusters(clusters: pd.DataFrame,
                            log: logging.Logger) -> pd.DataFrame:
    """
    Expand comma-separated Unique Control IDs into one row per
    Product + Payment Category + Consolidated Stage + CT Reference + Control_ID.
    """
    log.info("Expanding product cluster Control IDs...")
    rows = []
    n_no_ids = 0

    for _, row in clusters.iterrows():
        ct_norm = row.get("ct_ref_norm", None)
        if not ct_norm:
            continue   # already warned above

        raw_ids = safe_str(row.get("Unique Control IDs", ""))
        ctrl_ids = [c.strip() for c in raw_ids.split(",") if c.strip()]

        if not ctrl_ids:
            n_no_ids += 1
            continue

        for ctrl_id in ctrl_ids:
            rows.append({
                "Product":              row["Product"],
                "Payment Category":     row["Payment Category"],
                "Consolidated Stage":   row["Consolidated Stage"],
                "Expected CT Reference":row["Expected CT Reference"],
                "ct_ref_norm":          ct_norm,
                "Expected Control":     row["Expected Control"],
                "Unique Control Count": row.get("Unique Control Count", ""),
                "Control_ID":           ctrl_id,
            })

    if n_no_ids:
        log.warning(f"{n_no_ids} cluster rows had no valid Control IDs — skipped.")

    expanded = pd.DataFrame(rows)
    log.info(f"Expanded rows: {len(expanded):,} "
             f"| Unique controls: {expanded['Control_ID'].nunique():,}")
    return expanded

# ─────────────────────────────────────────────────────────────────────────────
#  JOIN CONTROL DETAILS
# ─────────────────────────────────────────────────────────────────────────────

def join_control_details(expanded: pd.DataFrame, ctrl: pd.DataFrame,
                         log: logging.Logger) -> pd.DataFrame:
    log.info("Joining control details onto expanded product cluster rows...")
    n_before = len(expanded)

    joined = expanded.merge(ctrl, on="Control_ID", how="left")

    matched = joined["CTRL_NAME"].notna().sum()
    unmatched_ids = joined[joined["CTRL_NAME"].isna()]["Control_ID"].unique()
    n_unmatched = len(unmatched_ids)

    log.info(f"  Expanded rows        : {n_before:,}")
    log.info(f"  Matched to ctrl_details: {matched:,}")
    log.info(f"  Unmatched Control_IDs  : {n_unmatched:,}")
    if n_unmatched > 0:
        log.warning(f"  Unmatched IDs (first 10): {list(unmatched_ids[:10])}")

    return joined

# ─────────────────────────────────────────────────────────────────────────────
#  BUILD EMBEDDING TEXT
# ─────────────────────────────────────────────────────────────────────────────

def build_embedding_text(row: pd.Series) -> str:
    """
    Clean semantic text for embedding generation.
    Excludes CTRL_OWNER by default (configurable via INCLUDE_CTRL_OWNER).
    Fields included per specification.
    """
    def f(field: str, label: str) -> str:
        val = safe_str(row.get(field, ""))
        return f"{label}:\n{val}" if val else ""

    parts = [
        f("Control_ID",              "Control ID"),
        f("CTRL_NAME",               "Control Name"),
        f("Control Objective",       "Control Objective"),
        f("Control Description",     "Control Description"),
        f("CTRL_NATRE",              "Control Nature"),
        f("CTRL_FREQ",               "Frequency"),
        f("CTRL_TYP",                "Control Type"),
        f("CTRL_KEY_CONTRL",         "Key Control"),
        f("CTRL_CTGRY_1",            "Category 1"),
        f("CTRL_CTGRY_2",            "Category 2"),
        f("CTRL_EVDNCD",             "Evidence"),
        f("CTRL_MNTRD",              "Monitoring"),
        f("CTRL_CATEGORY",           "Control Category"),
        f("CTRL_LOC_LIST",           "Location"),
        f("CTRL_FLDR_LVL_2(Division)","Division"),
        f("object_path_leaf",        "Business Area"),
        f("gold_control",            "Gold Control"),
    ]
    if INCLUDE_CTRL_OWNER:
        parts.append(f("CTRL_OWNER", "Control Owner"))

    return "\n\n".join(p for p in parts if p)

def build_llm_payload_text(row: pd.Series) -> str:
    """
    Richer text for LLM reasoning — includes product cluster context
    on top of the embedding fields.
    """
    def f(field: str, label: str) -> str:
        val = safe_str(row.get(field, ""))
        return f"{label}: {val}" if val else ""

    lines = [
        "=== PRODUCT CONTEXT ===",
        f("Product",              "Product"),
        f("Payment Category",     "Payment Category"),
        f("Consolidated Stage",   "Payment Stage"),
        f("Expected CT Reference","Expected CT Reference"),
        f("Expected Control",     "Expected Control"),
        "",
        "=== CONTROL DETAILS ===",
        f("Control_ID",           "Control ID"),
        f("CTRL_NAME",            "Control Name"),
        f("Control Objective",    "Control Objective"),
        f("Control Description",  "Control Description"),
        f("CTRL_NATRE",           "Control Nature"),
        f("CTRL_FREQ",            "Frequency"),
        f("CTRL_TYP",             "Control Type"),
        f("CTRL_KEY_CONTRL",      "Key Control"),
        f("CTRL_CTGRY_1",         "Category 1"),
        f("CTRL_CTGRY_2",         "Category 2"),
        f("CTRL_EVDNCD",          "Evidence"),
        f("CTRL_MNTRD",           "Monitoring"),
        f("CTRL_CATEGORY",        "Control Category"),
        f("CTRL_LOC_LIST",        "Location"),
        f("CTRL_FLDR_LVL_2(Division)", "Division"),
        f("object_path_leaf",     "Business Area"),
        f("gold_control",         "Gold Control"),
    ]
    if INCLUDE_CTRL_OWNER:
        lines.append(f("CTRL_OWNER", "Control Owner"))

    return "\n".join(line for line in lines if line != "" or line == "")

# ─────────────────────────────────────────────────────────────────────────────
#  DATA QUALITY REPORT
# ─────────────────────────────────────────────────────────────────────────────

def create_data_quality_report(ctrl_raw: pd.DataFrame, clusters_raw: pd.DataFrame,
                               expanded: pd.DataFrame, joined: pd.DataFrame,
                               log: logging.Logger) -> pd.DataFrame:
    log.info("Building data quality report...")

    def col_blank(df, col):
        return int(df[col].apply(is_blank).sum()) if col in df.columns else "n/a"

    cluster_no_ids = 0
    for _, row in clusters_raw.iterrows():
        raw_ids = safe_str(row.get("Unique Control IDs", ""))
        ids = [c.strip() for c in raw_ids.split(",") if c.strip()]
        if not ids:
            cluster_no_ids += 1

    unmatched_ids = joined[joined["CTRL_NAME"].apply(is_blank)]["Control_ID"].unique()

    rows = [
        ("── INPUT COUNTS ───────────────────────────────────────", ""),
        ("ctrl_details input rows",          len(ctrl_raw)),
        ("ctrl_details unique Control_IDs",  ctrl_raw["Control_ID"].nunique()),
        ("product_clusters input rows",      len(clusters_raw)),
        ("── AFTER EXPANSION ────────────────────────────────────", ""),
        ("Expanded cluster rows (one per control)", len(expanded)),
        ("Unique Control_IDs in expanded set",      expanded["Control_ID"].nunique()),
        ("── JOIN RESULTS ───────────────────────────────────────", ""),
        ("Expanded rows matched to ctrl_details",
         int(joined["CTRL_NAME"].apply(lambda x: not is_blank(x)).sum())),
        ("Expanded rows unmatched (Control_ID not in ctrl_details)",
         int(joined["CTRL_NAME"].apply(is_blank).sum())),
        ("Unmatched unique Control_IDs",     len(unmatched_ids)),
        ("── DATA QUALITY ───────────────────────────────────────", ""),
        ("Duplicate Control_IDs in ctrl_details",
         int(ctrl_raw["Control_ID"].duplicated().sum())),
        ("Blank Control Description in ctrl_details",
         col_blank(ctrl_raw, "Control Description")),
        ("Blank Control Objective in ctrl_details",
         col_blank(ctrl_raw, "Control Objective")),
        ("Blank CTRL_EVDNCD in ctrl_details",
         col_blank(ctrl_raw, "CTRL_EVDNCD")),
        ("Blank CTRL_MNTRD in ctrl_details",
         col_blank(ctrl_raw, "CTRL_MNTRD")),
        ("Product cluster rows with no valid Control IDs", cluster_no_ids),
        ("── SCOPE COUNTS ────────────────────────────────────────", ""),
        ("Unique (Product + CT ref) groups for within-product assessment",
         joined.groupby(["Product","ct_ref_norm"]).ngroups),
        ("Unique CT ref groups for cross-product assessment",
         joined["ct_ref_norm"].nunique()),
    ]

    dq_df = pd.DataFrame(rows, columns=["Metric", "Value"])

    # Unmatched IDs detail sheet
    unmatched_df = pd.DataFrame({"Unmatched_Control_ID": unmatched_ids})
    return dq_df, unmatched_df

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true",
                        help="Overwrite existing preprocessed output.")
    args = parser.parse_args()

    log = setup_logging()
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 1: Preprocessing")
    log.info(f"  Started: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    output_parquet = OUTPUT_DIR / "expanded_product_control_mapping.parquet"
    if output_parquet.exists() and not args.force:
        log.info(f"Preprocessed output already exists: {output_parquet.name}")
        log.info("Use --force to regenerate. Exiting Step 1.")
        return

    # ── Load and validate ──────────────────────────────────────────────────
    ctrl_raw, clusters_raw = load_inputs(log)
    validate_columns(ctrl_raw, clusters_raw, log)

    # ── Normalise ──────────────────────────────────────────────────────────
    ctrl     = normalise_ctrl_details(ctrl_raw.copy(), log)
    clusters = normalise_clusters(clusters_raw.copy(), log)

    # ── Expand and join ────────────────────────────────────────────────────
    expanded = expand_product_clusters(clusters, log)
    joined   = join_control_details(expanded, ctrl, log)

    # ── Build text payloads ────────────────────────────────────────────────
    log.info("Building embedding text and LLM payload text...")
    joined["embedding_text"] = joined.apply(build_embedding_text, axis=1)
    joined["llm_payload_text"] = joined.apply(build_llm_payload_text, axis=1)

    avg_emb_len = joined["embedding_text"].str.len().mean()
    avg_llm_len = joined["llm_payload_text"].str.len().mean()
    log.info(f"  Avg embedding text length : {avg_emb_len:.0f} chars")
    log.info(f"  Avg LLM payload length    : {avg_llm_len:.0f} chars")

    # ── Data quality report ────────────────────────────────────────────────
    dq_df, unmatched_df = create_data_quality_report(
        ctrl_raw, clusters_raw, expanded, joined, log)

    dq_path = OUTPUT_DIR / "data_quality_report.xlsx"
    with pd.ExcelWriter(dq_path, engine="openpyxl") as w:
        dq_df.to_excel(w, index=False, sheet_name="summary")
        if not unmatched_df.empty:
            unmatched_df.to_excel(w, index=False, sheet_name="unmatched_control_ids")
    log.info(f"Data quality report: {dq_path.name}")
    for _, row in dq_df.iterrows():
        if row["Metric"].startswith("──"):
            continue
        log.info(f"  {row['Metric']}: {row['Value']}")

    # ── Save expanded dataset ──────────────────────────────────────────────
    joined.to_parquet(output_parquet, index=False, engine="pyarrow")
    log.info(f"Expanded dataset saved: {output_parquet.name} "
             f"({len(joined):,} rows, {len(joined.columns)} cols)")

    # ── Save run config ────────────────────────────────────────────────────
    config = {
        "script": "01_preprocess_control_data.py",
        "run_at": datetime.now().isoformat(),
        "file_ctrl_details":    str(FILE_CTRL_DETAILS),
        "file_product_clusters":str(FILE_PRODUCT_CLUSTERS),
        "output_dir":           str(OUTPUT_DIR),
        "similarity_threshold":      SIMILARITY_THRESHOLD,
        "max_controls_per_llm_call": MAX_CONTROLS_PER_LLM_CALL,
        "llm_temperature":           LLM_TEMPERATURE,
        "retry_count":               RETRY_COUNT,
        "force_refresh_embeddings":  FORCE_REFRESH_EMBEDDINGS,
        "include_ctrl_owner":        INCLUDE_CTRL_OWNER,
        "run_within_product":        RUN_WITHIN_PRODUCT,
        "run_cross_product":         RUN_CROSS_PRODUCT,
        "expanded_rows":             len(joined),
        "unique_controls":           int(joined["Control_ID"].nunique()),
    }
    config_path = OUTPUT_DIR / "run_config.json"
    with open(config_path, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)
    log.info(f"Run config saved: {config_path.name}")

    log.info("=" * 70)
    log.info("  Step 1 complete. Run 02_generate_embeddings_and_candidates.py next.")
    log.info("=" * 70)


if __name__ == "__main__":
    main()
