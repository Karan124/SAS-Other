def get_scope_controls(scope_id, pairs_df, expanded_df):
    return (expanded_df[expanded_df["scope_id"] == scope_id]
            .drop_duplicates(subset=["Control_ID"])
            .reset_index(drop=True))


def get_batch_controls(scope_id, batch_id, send_all, pairs_df, expanded_df):
    all_in = (expanded_df[expanded_df["scope_id"] == scope_id]
              .drop_duplicates(subset=["Control_ID"]))
    if send_all:
        return all_in.reset_index(drop=True)
    sp        = pairs_df[pairs_df["scope_id"] == scope_id]
    batch_ids = set(sp[sp["batch_id"].astype(int)==batch_id]["control_id_a"].dropna())
    if batch_id == 0:
        paired   = set(sp["control_id_a"].dropna())
        orphans  = set(all_in["Control_ID"]) - paired
        batch_ids = batch_ids | orphans
    return (all_in[all_in["Control_ID"].isin(batch_ids)]
            .reset_index(drop=True))

