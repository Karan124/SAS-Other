def load_pass1(files, log):
    """Load all Pass 1 assessments keyed by (scope_id, control_id)."""
    p1 = {}
    for fname in files:
        path = OUTPUT_DIR / fname
        if not path.exists():
            continue
        log.info(f"  Loading P1: {fname}")
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if rec.get("error"):
                    continue
                scope_id = rec.get("scope_id","")
                for a in rec.get("control_assessments", []):
                    cid = a.get("control_id","")
                    if cid:
                        key = (scope_id, cid)
                        if key not in p1:
                            p1[key] = a
                        else:
                            # Keep most recent (later file wins)
                            p1[key] = a
    log.info(f"  Pass 1 assessments: {len(p1):,}")
    return p1


def load_pass2(files, log):
    """Load all Pass 2 results keyed by scope_id."""
    p2 = {}
    for fname in files:
        path = OUTPUT_DIR / fname
        if not path.exists():
            continue
        log.info(f"  Loading P2: {fname}")
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if rec.get("error"):
                    continue
                scope_id = rec.get("scope_id","")
                if scope_id:
                    # Later checkpoint entries supersede prior reruns for a CT group.
                    p2[scope_id] = rec
    log.info(f"  Pass 2 results: {len(p2):,} CT groups")
    return p2

