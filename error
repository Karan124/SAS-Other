def build_within_product_prompt(scope_id: str, batch_id: int,
                                n_batches: int, send_all: bool,
                                controls_df: pd.DataFrame,
                                scope_meta: dict) -> str:
    """Build the user message for a within-product scope batch."""
    product    = scope_meta.get("Product", "")
    pay_cat    = scope_meta.get("Payment Category", "")
    stage      = scope_meta.get("Consolidated Stage", "")
    ct_ref     = scope_meta.get("ct_ref_norm", "") or scope_meta.get("Expected CT Reference", "")
    exp_ctrl   = scope_meta.get("Expected Control", "")
    n_controls = len(controls_df)

    batch_note = ""
    if not send_all:
        batch_note = (
            f"\nNOTE: This is batch {batch_id + 1} of {n_batches} for this scope. "
            f"Only {n_controls} of the total controls are shown in this batch. "
            f"Assess duplicates within this batch only."
        )

    lines = [
        "SCOPE CONTEXT",
        f"Scope type      : Within-Product Assessment",
        f"Scope ID        : {scope_id}",
        f"Product         : {product}",
        f"Payment Category: {pay_cat}",
        f"Lifecycle Stage : {stage}",
        f"Expected CT Ref : {ct_ref}",
        f"Expected Control: {exp_ctrl}",
        batch_note,
        "",
        f"CONTROLS TO ASSESS ({n_controls} controls):",
        "",
    ]

    for _, row in controls_df.iterrows():
        lines.append("─" * 60)
        lines.append(row.get("llm_payload_text", f"Control_ID: {row['Control_ID']}"))
        lines.append("")

    lines += [
        "─" * 60,
        "",
        "TASK — WITHIN-PRODUCT ASSESSMENT",
        "All controls above share the same Product, Payment Category,",
        "Lifecycle Stage, and Expected CT Reference.",
        "Step 1: For each pair of controls, assess whether they are",
        "Redundant, Process-Split Fragmented, or a Common Control",
        "Opportunity. Step 2: Classify each control with one primary",
        "outcome. Focus on the underlying control objective, activity,",
        "and risk outcome — not surface wording differences.",
        "",
        CLASSIFICATION_DEFINITIONS,
        "",
        RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_id: {batch_id} in your response.',
    ]
    return "\n".join(lines)


def build_cross_product_prompt(scope_id: str, batch_id: int,
                               n_batches: int, send_all: bool,
                               controls_df: pd.DataFrame,
                               ct_ref: str) -> str:
    """Build the user message for a cross-product scope batch."""
    n_controls = len(controls_df)
    products   = controls_df["Product"].dropna().unique().tolist() \
                 if "Product" in controls_df.columns else []

    batch_note = ""
    if not send_all:
        batch_note = (
            f"\nNOTE: This is batch {batch_id + 1} of {n_batches} for this scope. "
            f"Only {n_controls} controls are shown. Assess duplicates and common "
            f"control opportunities within this batch only."
        )

    lines = [
        "SCOPE CONTEXT",
        f"Scope type      : Cross-Product Assessment",
        f"Scope ID        : {scope_id}",
        f"CT Reference    : {ct_ref}",
        f"Products covered: {', '.join(products[:10])}",
        batch_note,
        "",
        f"CONTROLS TO ASSESS ({n_controls} controls across multiple products):",
        "",
    ]

    for _, row in controls_df.iterrows():
        lines.append("─" * 60)
        lines.append(row.get("llm_payload_text", f"Control_ID: {row['Control_ID']}"))
        lines.append("")

    lines += [
        "─" * 60,
        "",
        "TASK — CROSS-PRODUCT ASSESSMENT WITHIN CONTROL OBJECTIVE GROUP",
        "These controls share the same CT Reference (Control Objective Group)",
        "but come from different products and may be owned by different",
        "business areas. Do NOT compare controls across different Control",
        "Objective Groups.",
        "Step 1: Assess for Redundant Controls across products.",
        "Step 2: Assess for Process-Split Fragmentation across products.",
        "Step 3: Assess for Common Control Opportunities where substantially",
        "similar controls operate independently across products and could be",
        "consolidated into a single shared control capability.",
        "Focus on underlying objective, activity, and risk outcome —",
        "not wording, ownership, system, or product differences.",
        "",
        CLASSIFICATION_DEFINITIONS,
        "",
        RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_id: {batch_id} in your response.',
    ]
    return "\n".join(lines)

