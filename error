const slides=[...document.querySelectorAll('.slide')],dots=document.getElementById('dots');let cur=0;slides.forEach((_,i)=>{let d=document.createElement('div');d.className='dot'+(i===0?' on':'');d.onclick=()=>show(i);dots.appendChild(d)});
