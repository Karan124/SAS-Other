def get_logger(suffix: str = "") -> logging.Logger:
    name = f"ctrl_rat{suffix}"
    logger = logging.getLogger(name)
    if logger.handlers:
        return logger
    log_path = OUTPUT_DIR / f"processing_log{suffix}.txt"
    fh = logging.FileHandler(log_path, encoding="utf-8")
    fh.setLevel(logging.DEBUG)
    ch = logging.StreamHandler(sys.stdout)
    ch.setLevel(logging.INFO)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s",
                            datefmt="%Y-%m-%d %H:%M:%S")
    fh.setFormatter(fmt)
    ch.setFormatter(fmt)
    logger.addHandler(fh)
    logger.addHandler(ch)
    logger.setLevel(logging.DEBUG)
    return logger

# ─────────────────────────────────────────────────────────────────────────────
#  CHECKPOINT
# ─────────────────────────────────────────────────────────────────────────────

def load_checkpoint(path: Path) -> set:
    done = set()
    if not path.exists():
        return done
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                key = json.loads(line).get("batch_key", "")
                if key:
                    done.add(key)
            except json.JSONDecodeError:
                continue
    return done


def write_checkpoint(rec: dict, path: Path) -> None:
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=True) + "\n")

# ─────────────────────────────────────────────────────────────────────────────
#  LLM CALL
# ─────────────────────────────────────────────────────────────────────────────

def parse_response(text: str) -> dict:
    text = re.sub(r'^```(?:json)?\s*', '', (text or "").strip())
    text = re.sub(r'\s*```$', '', text).strip()
    if not text:
        raise ValueError("Empty response from model")
    try:
        result = json.loads(text)
    except json.JSONDecodeError:
        m = re.search(r'\{.*\}', text, re.DOTALL)
        if m:
            result = json.loads(m.group(0))
        else:
            raise
    if "assessments" not in result:
        raise ValueError("Missing 'assessments' key")
    return result


def call_llm(prompt: str, batch_key: str,
             log: logging.Logger) -> tuple:
    usage = {"input_tokens": 0, "output_tokens": 0,
             "reasoning_tokens": 0, "latency_ms": 0}

    for attempt in range(1, RETRY_COUNT + 1):
        try:
            client = make_client()   # fresh connection every attempt
            t0     = time.time()
            resp   = client.chat.completions.create(
                model=LLM_MODEL,
                messages=[
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user",   "content": prompt},
                ],
                reasoning_effort="low",
                max_completion_tokens=MAX_COMPLETION_TOKENS,
            )
            latency = int((time.time() - t0) * 1000)
            text    = resp.choices[0].message.content or ""

            u = getattr(resp, "usage", None)
            if u:
                usage["input_tokens"]  = getattr(u, "prompt_tokens", 0)
                usage["output_tokens"] = getattr(u, "completion_tokens", 0)
                d = getattr(u, "completion_tokens_details", None)
                if d:
                    usage["reasoning_tokens"] = getattr(d, "reasoning_tokens", 0)
            usage["latency_ms"] = latency

            return parse_response(text), usage

        except Exception as exc:
            exc_str = str(exc).lower()
            is_conn = any(w in exc_str for w in
                          ["connection", "timed out", "timeout",
                           "network", "proxy"])
            if attempt < RETRY_COUNT:
                wait = CONNECTION_SLEEP_SECS if is_conn else min(
                    RETRY_BASE_SECS * 2**(attempt-1) + random.uniform(0, 2), 60)
                log.warning(f"  Attempt {attempt} failed [{batch_key}]: "
                            f"{exc}. {'Connection error — ' if is_conn else ''}"
                            f"waiting {wait:.0f}s...")
                time.sleep(wait)
            else:
                log.error(f"  All {RETRY_COUNT} retries failed [{batch_key}]: {exc}")
                return None, usage

# ─────────────────────────────────────────────────────────────────────────────
#  SCOPE DATA HELPERS
# ─────────────────────────────────────────────────────────────────────────────

def get_scope_controls(scope_id, pairs_df, expanded_df):
    sp = pairs_df[pairs_df["scope_id"] == scope_id]
    ids = set(sp["control_id_a"].dropna().tolist())
    ids.update(c for c in sp["control_id_b"].dropna().tolist() if c)
    return (expanded_df[expanded_df["Control_ID"].isin(ids)]
            .drop_duplicates(subset=["Control_ID"])
            .reset_index(drop=True))


def get_batch_controls(scope_id, batch_id, send_all, pairs_df, expanded_df):
    if send_all:
        return get_scope_controls(scope_id, pairs_df, expanded_df)
    sp = pairs_df[(pairs_df["scope_id"] == scope_id) &
                  (pairs_df["batch_id"] == batch_id)]
    ids = set(sp["control_id_a"].dropna().tolist())
    return (expanded_df[expanded_df["Control_ID"].isin(ids)]
            .drop_duplicates(subset=["Control_ID"])
            .reset_index(drop=True))

# ─────────────────────────────────────────────────────────────────────────────
#  PROCESSING LOOP
# ─────────────────────────────────────────────────────────────────────────────

def process_scopes(scope_type, scope_df, pairs_df, expanded_df,
                   ck_path, done_keys, log) -> float:
    total_in  = total_out = 0
    n_proc    = n_skip = n_err = 0
    n_total   = len(scope_df)
    t_start   = time.time()

    for row_num, sr in enumerate(scope_df.itertuples(index=False), 1):
        scope_id    = sr.scope_id
        send_all    = bool(getattr(sr, "send_all", True))
        n_controls  = int(getattr(sr, "n_controls", 0))
        n_batches   = int(getattr(sr, "n_batches", 1))
        skip_reason = getattr(sr, "skip_reason", "")

        if skip_reason == "single_control" or n_controls < 2:
            n_skip += 1
            bk = f"{scope_id}::0::0"
            if bk not in done_keys:
                write_checkpoint({"batch_key": bk, "scope_id": scope_id,
                                  "scope_type": scope_type, "skipped": True,
                                  "skip_reason": "single_control",
                                  "assessments": []}, ck_path)
                done_keys.add(bk)
            continue

        elapsed = time.time() - t_start
        pct     = row_num / n_total * 100
        eta_s   = (elapsed / row_num) * (n_total - row_num) if row_num > 1 else 0
        eta_str = (f"{int(eta_s//3600)}h {int((eta_s%3600)//60)}m"
                   if eta_s > 60 else f"{int(eta_s)}s")
        cost    = ((total_in / 1e6 * INPUT_PRICE_PER_M +
                    total_out / 1e6 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
        print(f"\r  [{pct:5.1f}%] {scope_id[:55]:<55} "
              f"ETA {eta_str}  A${cost:.2f}", end="")

        all_ctrls = get_scope_controls(scope_id, pairs_df, expanded_df)
        n_scope   = len(all_ctrls)
        if n_scope == 0:
            continue

        sample = all_ctrls.iloc[0]
        scope_meta = {c: str(sample.get(c, "") or "")
                      for c in ["Product", "Payment Category",
                                 "Consolidated Stage", "ct_ref_norm",
                                 "Expected CT Reference", "Expected Control"]}

        for batch_id in (range(n_batches) if not send_all else [0]):
            batch = get_batch_controls(
                scope_id, batch_id, send_all, pairs_df, expanded_df)
            if len(batch) == 0:
                continue

            n_sub = max(1, (len(batch) + SUB_BATCH_SIZE - 1) // SUB_BATCH_SIZE)

            for sub_idx in range(n_sub):
                sub = batch.iloc[
                    sub_idx * SUB_BATCH_SIZE:(sub_idx + 1) * SUB_BATCH_SIZE
                ].reset_index(drop=True)

                if len(sub) == 0:
                    continue

                bk = f"{scope_id}::{batch_id}::{sub_idx}"
                if bk in done_keys:
                    n_skip += 1
                    continue

                prompt = (build_wp_prompt(scope_id, bk, n_scope,
                                          sub, scope_meta)
                          if scope_type == "within_product"
                          else build_cp_prompt(scope_id, bk, n_scope,
                                               sub, scope_id.replace("CP|","")))

                result, usage = call_llm(prompt, bk, log)
                total_in  += usage.get("input_tokens", 0)
                total_out += usage.get("output_tokens", 0)

                if result is None:
                    n_err += 1
                    write_checkpoint({
                        "batch_key": bk, "scope_id": scope_id,
                        "scope_type": scope_type, "error": True,
                        "assessments": [],
                        "control_ids_in_batch": sub["Control_ID"].tolist(),
                    }, ck_path)
                else:
                    result.update({
                        "batch_key":   bk,
                        "scope_type":  scope_type,
                        "input_tokens":  usage.get("input_tokens", 0),
                        "output_tokens": usage.get("output_tokens", 0),
                        "error":       False,
                        "control_ids_in_batch": sub["Control_ID"].tolist(),
                    })
                    write_checkpoint(result, ck_path)
                    n_proc += 1

                done_keys.add(bk)
                time.sleep(SLEEP_BETWEEN)

    print()
    cost_aud = ((total_in / 1e6 * INPUT_PRICE_PER_M +
                 total_out / 1e6 * OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
    log.info(f"  Processed: {n_proc:,} | Skipped: {n_skip:,} | "
             f"Errors: {n_err:,} | Cost: A${cost_aud:.2f}")
    return cost_aud

