"""
01_preprocess_ct.py
─────────────────────────────────────────────────────────────────────────────
Control Rationalisation — Step 1 of 4 (Dimension 2: Gold Controls)

Scope: one scope per gold control group (CT|CT1, CT|CT2 ... CT|CT28).
All 708 payment controls are included.

Reads:
  ctrl_details.xlsx                    — 708 controls with gold_control mapping
  consolidated_linkage_by_product.xlsx — control-to-process linkage for
                                         best of breed enrichment

Computes per-control linkage metrics (controls with no linkage get 0):
  n_linked_processes — distinct count of l3_process_UUID
  n_linked_products  — distinct count of product
  n_linked_apps      — distinct count of Alfabet apps (semicolon-separated)

Outputs:
  expanded_ct_control_mapping.parquet
  data_quality_report_ct.xlsx
  processing_log_ct.txt
  run_config_ct.json

Run:
  python 01_preprocess_ct.py
  python 01_preprocess_ct.py --force
"""

import argparse
import json
import logging
import re
import sys
from datetime import datetime
from pathlib import Path

import pandas as pd

# ─────────────────────────────────────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────────────────────────────────────

DATA_DIR   = Path(r"C:\Users\M061400\ai-test\big_table\duplicates\ct\data")
OUTPUT_DIR = Path(r"C:\Users\M061400\ai-test\big_table\duplicates\ct")

FILE_CTRL_DETAILS = DATA_DIR / "ctrl_details.xlsx"
FILE_LINKAGE      = DATA_DIR / "consolidated_linkage_by_product.xlsx"

SIMILARITY_THRESHOLD      = 0.58
MAX_CONTROLS_PER_LLM_CALL = 20
RETRY_COUNT               = 5

CTRL_OPTIONAL_COLS = [
    "CTRL_NATRE", "CTRL_STUS", "CTRL_OWNER", "CTRL_FREQ",
    "CTRL_KEY_CONTRL", "Control Objective", "CTRL_TYP",
    "CTRL_ASSESS_RTNG", "CTRL_OE_RTNG", "CTRL_DE_RTNG",
    "CTRL_CTGRY_1", "CTRL_CTGRY_2", "CTRL_LOC_LIST",
    "CTRL_EVDNCD", "CTRL_MNTRD", "CTRL_CATEGORY",
    "Control_Description", "CTRL_FLDR", "object_path_leaf",
    "CTRL_FLDR_LVL_2(Division)", "gold_control",
    "COMMON_CTRL_TYP", "COMMON_CTRL_REFERENCE",
]

# ─────────────────────────────────────────────────────────────────────────────
#  HELPERS
# ─────────────────────────────────────────────────────────────────────────────

def safe_str(val):
    if pd.isna(val):
        return ""
    return re.sub(r"\s+", " ",
                  str(val).replace("\t"," ").replace("\r"," ")
                          .replace("\n"," ")).strip()

def is_blank(val):
    return safe_str(val) == ""

def clean_cols(df):
    df.columns = df.columns.str.strip()
    return df

def setup_logging():
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    logger = logging.getLogger("ctrl_rat_ct")
    if logger.handlers:
        return logger
    fh = logging.FileHandler(OUTPUT_DIR / "processing_log_ct.txt",
                             encoding="utf-8")
    ch = logging.StreamHandler(sys.stdout)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s",
                            datefmt="%Y-%m-%d %H:%M:%S")
    fh.setFormatter(fmt); ch.setFormatter(fmt)
    fh.setLevel(logging.DEBUG); ch.setLevel(logging.INFO)
    logger.addHandler(fh); logger.addHandler(ch)
    logger.setLevel(logging.DEBUG)
    return logger

# ─────────────────────────────────────────────────────────────────────────────
#  LOAD
# ─────────────────────────────────────────────────────────────────────────────

def load_inputs(log):
    for f in [FILE_CTRL_DETAILS, FILE_LINKAGE]:
        if not f.exists():
            log.error(f"Not found: {f}")
            sys.exit(1)

    log.info(f"Loading ctrl_details...")
    ctrl = clean_cols(pd.read_excel(FILE_CTRL_DETAILS, dtype=str,
                                    engine="openpyxl"))
    log.info(f"  {len(ctrl):,} rows")

    log.info(f"Loading consolidated_linkage_by_product...")
    linkage = clean_cols(pd.read_excel(FILE_LINKAGE, dtype=str,
                                       engine="openpyxl"))
    log.info(f"  {len(linkage):,} rows | "
             f"{linkage.get('Control_ID', pd.Series()).nunique():,} unique controls")

    # Validate required columns
    if "Control_ID" not in ctrl.columns:
        log.error("ctrl_details missing Control_ID")
        sys.exit(1)
    if "gold_control" not in ctrl.columns:
        log.error("ctrl_details missing gold_control")
        sys.exit(1)
    if "Control_ID" not in linkage.columns:
        log.error("consolidated_linkage missing Control_ID")
        sys.exit(1)

    missing_opt = [c for c in CTRL_OPTIONAL_COLS if c not in ctrl.columns]
    if missing_opt:
        log.warning(f"Optional columns not in ctrl_details: {missing_opt}")

    return ctrl, linkage

# ─────────────────────────────────────────────────────────────────────────────
#  LINKAGE METRICS
# ─────────────────────────────────────────────────────────────────────────────

def compute_linkage_metrics(linkage, log):
    """
    For each Control_ID compute:
      n_linked_processes — distinct l3_process_UUID values
      n_linked_products  — distinct product values
      n_linked_apps      — distinct Alfabet apps (semicolon-separated per row)
    Controls absent from the linkage file get 0 for all metrics.
    """
    log.info("Computing linkage metrics...")

    linkage["Control_ID"] = linkage["Control_ID"].apply(safe_str)

    # 1. Distinct processes
    proc = (linkage[linkage["l3_process_UUID"].apply(
                lambda x: not is_blank(x))]
            .groupby("Control_ID")["l3_process_UUID"]
            .nunique()
            .reset_index()
            .rename(columns={"l3_process_UUID": "n_linked_processes"}))

    # 2. Distinct products
    prod = (linkage[linkage["product"].apply(
                lambda x: not is_blank(x))]
            .groupby("Control_ID")["product"]
            .nunique()
            .reset_index()
            .rename(columns={"product": "n_linked_products"}))

    # 3. Distinct Alfabet apps — split semicolons, explode, count distinct
    app_rows = []
    for _, row in linkage.iterrows():
        ctrl_id  = row["Control_ID"]
        apps_str = safe_str(row.get("alphabet_app", ""))
        if apps_str:
            for app in apps_str.split(";"):
                app = app.strip()
                if app:
                    app_rows.append({"Control_ID": ctrl_id, "app": app})

    if app_rows:
        app_df = pd.DataFrame(app_rows)
        apps = (app_df.groupby("Control_ID")["app"]
                .nunique()
                .reset_index()
                .rename(columns={"app": "n_linked_apps"}))
    else:
        apps = pd.DataFrame(columns=["Control_ID", "n_linked_apps"])
        log.warning("  No Alfabet app data found in linkage file")

    # Merge all metrics
    metrics = (proc
               .merge(prod,  on="Control_ID", how="outer")
               .merge(apps,  on="Control_ID", how="outer")
               .fillna(0))
    for col in ["n_linked_processes", "n_linked_products", "n_linked_apps"]:
        if col in metrics.columns:
            metrics[col] = metrics[col].astype(int)

    log.info(f"  Controls with linkage data : {len(metrics):,}")
    log.info(f"  Max processes per control  : "
             f"{metrics['n_linked_processes'].max()}")
    log.info(f"  Max products per control   : "
             f"{metrics['n_linked_products'].max()}")
    log.info(f"  Max apps per control       : "
             f"{metrics['n_linked_apps'].max()}")
    return metrics

# ─────────────────────────────────────────────────────────────────────────────
#  BUILD SCOPES
# One scope per gold control group: CT|CT1, CT|CT2 etc.
# ─────────────────────────────────────────────────────────────────────────────

def build_scopes(ctrl, log):
    """
    Normalise gold_control values and assign scope IDs.
    Handles values like 'CT1', 'CT 1', 'ct1', '1' etc.
    Controls with a blank gold_control are placed in scope CT|UNASSIGNED.
    """
    log.info("Building CT scopes...")

    def norm_ct(val):
        v = safe_str(val).upper().replace(" ", "")
        if not v:
            return "UNASSIGNED"
        if not v.startswith("CT"):
            v = "CT" + v
        return v

    ctrl["ct_ref_norm"] = ctrl["gold_control"].apply(norm_ct)
    ctrl["scope_id"]    = "CT|" + ctrl["ct_ref_norm"]

    scope_counts = ctrl["scope_id"].value_counts().sort_index()
    log.info(f"  CT groups found: {len(scope_counts):,}")
    for scope, n in scope_counts.items():
        log.info(f"    {scope}: {n} controls")

    return ctrl

# ─────────────────────────────────────────────────────────────────────────────
#  TEXT PAYLOADS
# ─────────────────────────────────────────────────────────────────────────────

def build_embedding_text(row):
    """Semantic text for embeddings — focuses on control content."""
    def f(field, label):
        val = safe_str(row.get(field, ""))
        return f"{label}:\n{val}" if val else ""
    parts = [
        f("Control_ID",               "Control ID"),
        f("CTRL_NAME",                "Control Name"),
        f("Control Objective",        "Control Objective"),
        f("Control_Description",      "Control Description"),
        f("CTRL_NATRE",               "Nature"),
        f("CTRL_FREQ",                "Frequency"),
        f("CTRL_TYP",                 "Type"),
        f("CTRL_KEY_CONTRL",          "Key Control"),
        f("CTRL_CTGRY_1",             "Category 1"),
        f("CTRL_CTGRY_2",             "Category 2"),
        f("CTRL_EVDNCD",              "Evidence"),
        f("CTRL_MNTRD",               "Monitoring"),
        f("CTRL_CATEGORY",            "Control Category"),
        f("CTRL_FLDR_LVL_2(Division)","Division"),
        f("object_path_leaf",         "Business Area"),
        f("gold_control",             "Gold Control"),
    ]
    return "\n\n".join(p for p in parts if p)


def build_llm_text(row):
    """Enriched text for LLM — includes linkage metrics for best of breed."""
    def f(field, label):
        val = safe_str(row.get(field, ""))
        return f"{label}: {val}" if val else ""
    lines = [
        f("gold_control",             "Gold Control Group"),
        f("ct_ref_norm",              "CT Reference"),
        "",
        f("Control_ID",               "Control ID"),
        f("CTRL_NAME",                "Control Name"),
        f("Control Objective",        "Control Objective"),
        f("Control_Description",      "Control Description"),
        f("CTRL_NATRE",               "Nature"),
        f("CTRL_FREQ",                "Frequency"),
        f("CTRL_TYP",                 "Type"),
        f("CTRL_KEY_CONTRL",          "Key Control"),
        f("CTRL_ASSESS_RTNG",         "Assessment Rating"),
        f("CTRL_OE_RTNG",             "Operating Effectiveness Rating"),
        f("CTRL_DE_RTNG",             "Design Effectiveness Rating"),
        f("CTRL_CTGRY_1",             "Category 1"),
        f("CTRL_CTGRY_2",             "Category 2"),
        f("CTRL_EVDNCD",              "Evidence"),
        f("CTRL_MNTRD",               "Monitoring"),
        f("CTRL_CATEGORY",            "Control Category"),
        f("COMMON_CTRL_TYP",          "Common Control Type"),
        f("COMMON_CTRL_REFERENCE",    "Common Control Reference"),
        f("CTRL_FLDR_LVL_2(Division)","Division"),
        f("object_path_leaf",         "Business Area"),
        "",
        "=== LINKAGE METRICS (for best of breed assessment) ===",
        f"Linked Holocentric Processes: {int(row.get('n_linked_processes', 0))}",
        f"Linked Products: {int(row.get('n_linked_products', 0))}",
        f"Linked Alfabet Applications: {int(row.get('n_linked_apps', 0))}",
    ]
    return "\n".join(l for l in lines if l != "" or l == "")

# ─────────────────────────────────────────────────────────────────────────────
#  DATA QUALITY
# ─────────────────────────────────────────────────────────────────────────────

def create_dq_report(ctrl_raw, metrics, expanded, log):
    n_with_linkage = expanded["Control_ID"].isin(metrics["Control_ID"]).sum()
    n_no_linkage   = len(expanded) - n_with_linkage

    dq = pd.DataFrame([
        ("── INPUT ─────────────────────────────────────────────", ""),
        ("ctrl_details rows",               len(ctrl_raw)),
        ("ctrl_details unique Control_IDs", ctrl_raw["Control_ID"].nunique()),
        ("Linkage file rows",               "see linkage file"),
        ("Controls with linkage data",      n_with_linkage),
        ("Controls with no linkage (0s)",   n_no_linkage),
        ("── SCOPES ────────────────────────────────────────────", ""),
        ("CT groups (scopes)",              expanded["scope_id"].nunique()),
        ("Total control rows",              len(expanded)),
        ("── DATA QUALITY ──────────────────────────────────────", ""),
        ("Blank gold_control",
         int(ctrl_raw["gold_control"].apply(is_blank).sum())
         if "gold_control" in ctrl_raw.columns else "n/a"),
        ("Blank Control Objective",
         int(ctrl_raw["Control Objective"].apply(is_blank).sum())
         if "Control Objective" in ctrl_raw.columns else "n/a"),
        ("Blank Control_Description",
         int(ctrl_raw["Control_Description"].apply(is_blank).sum())
         if "Control_Description" in ctrl_raw.columns else "n/a"),
        ("── LINKAGE METRICS ───────────────────────────────────", ""),
        ("Max processes per control",
         int(metrics["n_linked_processes"].max()) if len(metrics) else 0),
        ("Max products per control",
         int(metrics["n_linked_products"].max()) if len(metrics) else 0),
        ("Max apps per control",
         int(metrics["n_linked_apps"].max()) if len(metrics) else 0),
    ], columns=["Metric","Value"])
    return dq

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args()

    log = setup_logging()
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 1 (Dimension 2: Gold Controls)")
    log.info("  Scope: CT|CT1 ... CT|CT28  (one scope per gold control group)")
    log.info(f"  Started: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    output_parquet = OUTPUT_DIR / "expanded_ct_control_mapping.parquet"
    if output_parquet.exists() and not args.force:
        log.info("Output exists. Use --force to regenerate.")
        return

    ctrl_raw, linkage = load_inputs(log)

    # Clean ctrl_details
    ctrl = ctrl_raw.copy()
    ctrl["Control_ID"] = ctrl["Control_ID"].apply(safe_str)
    for col in ctrl.columns:
        ctrl[col] = ctrl[col].apply(safe_str)
    ctrl = ctrl.drop_duplicates(subset=["Control_ID"], keep="first")
    log.info(f"Unique controls after dedup: {len(ctrl):,}")

    # Linkage metrics
    metrics = compute_linkage_metrics(linkage, log)

    # Merge metrics onto ctrl (0 for controls with no linkage)
    ctrl = ctrl.merge(metrics, on="Control_ID", how="left")
    for col in ["n_linked_processes","n_linked_products","n_linked_apps"]:
        ctrl[col] = ctrl[col].fillna(0).astype(int)

    # Build scopes
    ctrl = build_scopes(ctrl, log)

    # Text payloads
    log.info("Building text payloads...")
    ctrl["embedding_text"]   = ctrl.apply(build_embedding_text, axis=1)
    ctrl["llm_payload_text"] = ctrl.apply(build_llm_text, axis=1)

    # Save parquet
    ctrl.to_parquet(output_parquet, index=False, engine="pyarrow")
    log.info(f"Saved: {output_parquet.name} ({len(ctrl):,} rows)")

    # DQ report
    dq = create_dq_report(ctrl_raw, metrics, ctrl, log)
    dq_path = OUTPUT_DIR / "data_quality_report_ct.xlsx"
    with pd.ExcelWriter(dq_path, engine="openpyxl") as w:
        dq.to_excel(w, index=False, sheet_name="summary")
        # Per-CT breakdown
        ct_breakdown = (ctrl.groupby("scope_id")
                        .agg(
                            n_controls         =("Control_ID","count"),
                            avg_processes      =("n_linked_processes","mean"),
                            avg_products       =("n_linked_products","mean"),
                            avg_apps           =("n_linked_apps","mean"),
                            controls_no_linkage=("n_linked_processes",
                                                 lambda x: (x==0).sum()),
                        )
                        .round(1)
                        .reset_index()
                        .sort_values("n_controls", ascending=False))
        ct_breakdown.to_excel(w, index=False, sheet_name="by_ct_group")
    log.info(f"DQ report: {dq_path.name}")

    # Config
    config = {
        "dimension":           2,
        "scope_definition":    "One scope per gold control group (CT|CT1 etc.)",
        "run_at":              datetime.now().isoformat(),
        "file_ctrl_details":   str(FILE_CTRL_DETAILS),
        "file_linkage":        str(FILE_LINKAGE),
        "output_dir":          str(OUTPUT_DIR),
        "similarity_threshold":      SIMILARITY_THRESHOLD,
        "max_controls_per_llm_call": MAX_CONTROLS_PER_LLM_CALL,
        "retry_count":               RETRY_COUNT,
        "total_controls":            len(ctrl),
        "total_scopes":              int(ctrl["scope_id"].nunique()),
    }
    with open(OUTPUT_DIR / "run_config_ct.json", "w") as f:
        json.dump(config, f, indent=2)

    for _, r in dq.iterrows():
        if not str(r["Metric"]).startswith("──"):
            log.info(f"  {r['Metric']}: {r['Value']}")

    log.info("=" * 70)
    log.info("  Step 1 complete. Run 02_generate_embeddings_ct.py next.")
    log.info("=" * 70)

if __name__ == "__main__":
    main()
