/* Yesterday's reporting snapshot */
%let td_date_eom = %sysfunc(intnx(day,%sysfunc(today()),-1,e), YYMMDD10.);

proc sql;
    connect using sipsst;

    create table w._incidents_ as
    select *
    from connection to sipsst
    (
        SELECT
            INC_ID,
            INC_DESC,
            INC_NAME,
            INC_INCDNT_CAUSE,
            INC_DT_INCDNT_OCCRD,
            INC_PRD_LVL_1,
            INC_PRD_LVL_2,
            INC_BASE_EVNT_TYP_2,
            NUM_OF_CUST_IMPCTD,
            INC_BULK_INC,
            NEAR_MISS,
            INC_PRCSS,
            INC_ROOT_CAUSE_LVL_1,
            INC_ROOT_CAUSE_LVL_2,
            INC_THRD_PRTY_SUPPLR_CAUSED_OR_IMPCTD,
            INC_PRMRY_CAUSED_BU,
            INC_IDENTFCTN_SRC_TYP,
            INC_ACTNS_TO_RECTFY_OR_PRVNT_REO,
            INC_LAST_PRCSS_UPD,
            INC_LAST_PRCSS_UPD_DT,
            INC_ENTRY_DT,
            INC_POTNL_COMPL_IMPCT,
            INC_STUS,
            INC_FLDR_LVL_2,
            INC_OWNR_ACCEP_DT

        FROM BIP1ViewA.A008E1_DIM_INCIDENT_R

        WHERE CAST(REPORTING_DATE AS DATE) = DATE%str(%')&td_date_eom.%str(%')
          AND (
                (     CAST(INC_ENTRY_DT AS DATE) BETWEEN DATE '2026-04-20' AND DATE '2026-10-20'
                  AND INC_STUS <> 'Rejected'
                  AND INC_POTNL_COMPL_IMPCT = 'Yes'
                )
             OR INC_ID IN ('INC000365033','INC000374212','INC000366466','INC000366530','INC000341409',
                           'INC000358150','INC000372012','INC000369888','INC000357929','INC000362030')
              )
    );

    disconnect from sipsst;
quit;
