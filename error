project:
  name: Outcome-Informed Remediation Assurance Triage
  version: input_data_v1
  status: use_case_scope_frozen
  objective: >
    Provide all currently available metadata, schemas, value dictionaries,
    operating model data and known constraints needed to produce Artefact 1A
    (Logical-to-Physical Mapping) and Artefact 1B (Executable Data Profiling Specification).

known_constraints:

  payments_population_methodology:
    status: unavailable
    comment: >
      No documented Payments population methodology currently exists or is
      unavailable at this stage.
      This should not be treated as a blocking dependency.

  source_system_change_documentation:
    status: unavailable
    comment: >
      No formal documentation currently available describing source-system
      changes, taxonomy changes or field-definition changes.
      History feasibility must therefore be derived from:
      - REPORTING_DATE
      - EFF_START_DT
      - EFF_END_DT
      - LAST_UPDATED_DT
      - object lifecycle dates

  historical_snapshots:
    available: true
    basis: REPORTING_DATE
    warning: >
      Repeated snapshots provide first observed date, not necessarily business
      event date.

cross_reference_table:

  table_name: A008E1_DIM_CROSS_REFERENCE_2_R

  columns:
    - REPORTING_DATE
    - DAILY_FLAG
    - WEEKLY_FLAG
    - MONTHLY_FLAG
    - LATEST_DWM_FLAG
    - OBJECT_SYSTEM_ID
    - PARENT_SYSTEM_ID
    - CROSS_REF_2_KEY
    - OBJECT_TYPE
    - OBJECT_ID
    - PARENT_OBJECT_TYPE
    - PARENT_ID
    - FILE_AS_OF_DT
    - LAST_UPDATED_DT

  notes:
    - Treat as candidate authoritative relationship source.
    - Must be profiled before assuming authority.
    - Must be reconciled against:
      - ISS_INC_ASSOC_LIST
      - ISS_CTRL_ASSOC_LIST
      - ACTN_ID
    - Relationship directionality unknown.
    - Relationship status field unavailable.
    - Effective dating unavailable.

holocentric_schema:

  description: >
    Holocentric process hierarchy, business capability, value stream,
    product, application and task metadata.

  columns:

    - l3_activity_uuid
    - Flag
    - l3_activity_name
    - l3_activity_description
    - l3_master_activity_uuid

    - l3_activity_applications
    - l3_activity_channels
    - l3_activity_customer_segments

    - l3_activity_component_uuid
    - l3_activity_component_id
    - l3_activity_component_name
    - l3_activity_component_description
    - l3_activity_component_channels
    - l3_activity_component_customer_segments
    - l3_activity_component_products

    - l2_process_uuid
    - l2_process_id
    - l2_process_name
    - l2_process_description

    - value_stream_uuid
    - value_stream_order
    - value_stream_name

    - vcm_library_id
    - vcm_library_name
    - vcm_library_type

    - Value_Chain
    - Value_Chain_Uuid

    - Business_Capability_ID_BCM
    - Business_Capability_Name_BCM

    - Application_Name

    - Task_Uuid
    - Task_Name

    - l3_activity_product_service

  important_notes:

    application_reference:
      authoritative_field: Application_Name

    process_hierarchy:
      available: true
      levels:
        - value_stream
        - l2_process
        - l3_activity
        - task

    product_information:
      available: true
      sources:
        - l3_activity_product_service
        - l3_activity_component_products

