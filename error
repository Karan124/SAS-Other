"""
STEP 1: Profile the three source files. No API calls.

Answers four questions before we spend any tokens:
  1. Which text fields are worth embedding (fill rate, length, boilerplate)?
  2. Does the linkage file join cleanly to controls and processes?
  3. How many master/instance families exist (our duplicate ground truth)?
  4. Do control IDs leak into text fields?

Run:
  python 01_profile.py

Output:
  C:\\Users\\M061400\\ai-test\\experiments\\output\\profile.xlsx
  and a summary printed to the console.
"""
import re
import html
from collections import Counter
from pathlib import Path
import pandas as pd

DATA_DIR = Path(r"C:\Users\M061400\ai-test\experiments\data")
OUT_DIR = Path(r"C:\Users\M061400\ai-test\experiments\output")
OUT_DIR.mkdir(parents=True, exist_ok=True)

TEXT_FIELDS = ["CTRL_NAME", "CTRL_DESC", "CTRL_DESC_OF_CTRL", "CTRL_EVDNCD", "CTRL_MNTRD"]
CODED_FIELDS = ["CTRL_NATRE", "CTRL_STUS", "CTRL_FREQ", "CTRL_KEY_CONTRL", "CTRL_TYP",
                "CTRL_CTGRY_1", "CTRL_CTGRY_2", "CTRL_CATEGORY", "COMMON_CTRL_TYP",
                "CTRL_OE_RTNG", "CTRL_DE_RTNG"]

UUID_RE = re.compile(r"([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})")
CTRL_ID_RE = re.compile(r"\bCTL\d{6,}\b")
HTML_RE = re.compile(r"<[^>]+>")


def clean(v):
    """Strip HTML tags, collapse whitespace. Returns '' for blank/missing."""
    if not isinstance(v, str) or v.strip().lower() in {"", "nan", "none", "null"}:
        return ""
    return re.sub(r"\s+", " ", html.unescape(HTML_RE.sub(" ", v))).strip()


def uuid_of(v):
    m = UUID_RE.search(v) if isinstance(v, str) else None
    return m.group(1).upper() if m else None


# ---------- load ----------
controls = pd.read_excel(DATA_DIR / "juno_controls.xlsx", dtype=str)
processes = pd.read_excel(DATA_DIR / "holocentric_processes.xlsx", dtype=str)
linkage = pd.read_excel(DATA_DIR / "ctl_holo_linkage.xlsx", dtype=str)
for df in (controls, processes, linkage):
    df.columns = [c.strip() for c in df.columns]
controls["CTRL_ID"] = controls["CTRL_ID"].str.strip()
print(f"controls {len(controls)}  processes {len(processes)}  linkage rows {len(linkage)}")

# ---------- 1. text fields ----------
rows = []
for f in TEXT_FIELDS:
    if f not in controls.columns:
        rows.append({"field": f, "note": "COLUMN NOT FOUND"}); continue
    txt = controls[f].map(clean)
    nb = txt[txt != ""]
    rows.append({"field": f, "fill_rate": round(len(nb) / len(txt), 3), "distinct": nb.nunique(),
                 "median_chars": nb.str.len().median() if len(nb) else 0,
                 "p95_chars": nb.str.len().quantile(0.95) if len(nb) else 0,
                 "approx_tokens_total": int(nb.str.len().sum() / 4),
                 "rows_containing_ctrl_id": int(controls[f].map(lambda v: bool(CTRL_ID_RE.search(v)) if isinstance(v, str) else False).sum())})
text_profile = pd.DataFrame(rows)

boiler = []
for f in TEXT_FIELDS:
    if f not in controls.columns:
        continue
    txt = controls[f].map(clean).str.lower()
    txt = txt[txt != ""]
    for t, n in Counter(txt).most_common(25):
        if n > 1:
            boiler.append({"field": f, "repeat_count": n, "share": round(n / len(txt), 4), "text": t[:250]})
boilerplate = pd.DataFrame(boiler, columns=["field", "repeat_count", "share", "text"])

# ---------- 2. linkage ----------
linkage["uuid"] = linkage["L3_Activity_UUID"].map(uuid_of)
linkage["Control_ID"] = linkage["Control_ID"].str.strip()
processes["uuid"] = processes["l3_activity_uuid"].map(uuid_of)
valid = linkage[linkage["uuid"].notna()].drop_duplicates(["Control_ID", "uuid"])
in_ctrl = valid["Control_ID"].isin(set(controls["CTRL_ID"]))
in_proc = valid["uuid"].isin(set(processes["uuid"].dropna()))
matched = valid[in_ctrl & in_proc]
deg = matched.groupby("Control_ID").size()
pdeg = matched.groupby("uuid").size()
link_profile = pd.DataFrame([
    ("linkage rows total", len(linkage)),
    ("rows with a UUID", len(valid)),
    ("rows whose control is in controls file", int(in_ctrl.sum())),
    ("rows whose process is in processes file", int(in_proc.sum())),
    ("rows matching both sides", len(matched)),
    ("controls with at least one link", int(deg.shape[0])),
    ("controls with no link", int(len(controls) - deg.shape[0])),
    ("links per control: median / p95 / max", f"{deg.median()} / {deg.quantile(0.95)} / {deg.max()}" if len(deg) else "n/a"),
    ("processes with at least one control", int(pdeg.shape[0])),
    ("processes with no control", int(processes["uuid"].notna().sum() - pdeg.shape[0])),
    ("controls per process: median / p95 / max", f"{pdeg.median()} / {pdeg.quantile(0.95)} / {pdeg.max()}" if len(pdeg) else "n/a"),
], columns=["metric", "value"])

# ---------- 3. master / instance families ----------
ids = set(controls["CTRL_ID"])
edges = []
for cid, ref in zip(controls["CTRL_ID"], controls["COMMON_CTRL_REFERENCE"]):
    for r in set(CTRL_ID_RE.findall(ref)) if isinstance(ref, str) else []:
        edges.append({"CTRL_ID": cid, "master_id": r, "master_in_corpus": r in ids, "self_reference": r == cid})
edges = pd.DataFrame(edges, columns=["CTRL_ID", "master_id", "master_in_corpus", "self_reference"])
good = edges[edges["master_in_corpus"] & ~edges["self_reference"]]
fam_sizes = good.groupby("master_id")["CTRL_ID"].nunique() + 1  # +1 for the master itself
pairs = int(sum(s * (s - 1) / 2 for s in fam_sizes))
has_ref = controls["COMMON_CTRL_REFERENCE"].map(lambda v: isinstance(v, str) and v.strip() != "")
family_profile = pd.DataFrame([
    ("controls with a COMMON_CTRL_REFERENCE", int(has_ref.sum())),
    ("reference edges parsed", len(edges)),
    ("edges pointing to a control in the corpus", int(edges["master_in_corpus"].sum())),
    ("edges pointing to a control NOT in corpus", int((~edges["master_in_corpus"]).sum())),
    ("families (distinct masters)", int(fam_sizes.shape[0])),
    ("controls inside a family incl. masters", int(good["CTRL_ID"].nunique() + fam_sizes.shape[0])),
    ("family size: median / max", f"{fam_sizes.median()} / {fam_sizes.max()}" if len(fam_sizes) else "n/a"),
    ("ground-truth duplicate pairs", pairs),
    ("COMMON_CTRL_TYP values", str(controls["COMMON_CTRL_TYP"].fillna("<blank>").value_counts().to_dict())),
    ("CTRL_CATEGORY values", str(controls["CTRL_CATEGORY"].fillna("<blank>").value_counts().to_dict())),
], columns=["metric", "value"])

# ---------- 4. coded fields ----------
coded = []
for f in CODED_FIELDS:
    if f in controls.columns:
        for v, n in controls[f].fillna("<blank>").value_counts().head(12).items():
            coded.append({"field": f, "value": v, "count": int(n), "share": round(n / len(controls), 3)})
coded = pd.DataFrame(coded)

# ---------- write ----------
out = OUT_DIR / "profile.xlsx"
with pd.ExcelWriter(out, engine="openpyxl") as xw:
    text_profile.to_excel(xw, sheet_name="text_fields", index=False)
    boilerplate.to_excel(xw, sheet_name="boilerplate", index=False)
    link_profile.to_excel(xw, sheet_name="linkage", index=False)
    family_profile.to_excel(xw, sheet_name="families", index=False)
    edges.to_excel(xw, sheet_name="family_edges", index=False)
    coded.to_excel(xw, sheet_name="coded_fields", index=False)

pd.set_option("display.width", 200, "display.max_colwidth", 80)
print("\n== TEXT FIELDS ==\n", text_profile.to_string(index=False))
print("\n== LINKAGE ==\n", link_profile.to_string(index=False))
print("\n== FAMILIES ==\n", family_profile.to_string(index=False))
print(f"\nwritten: {out}")
