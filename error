# ─────────────────────────────────────────────────────────────────────────────
#  FRESH CLIENT — created on every retry to avoid stale proxy connections
# ─────────────────────────────────────────────────────────────────────────────

def make_client() -> AzureOpenAI:
    """
    Create a fresh AzureOpenAI client with a new httpx connection.
    Called on every API attempt so stale proxy sessions never block retries.
    DefaultAzureCredential caches tokens internally — repeated calls are fast.
    """
    token_provider = get_bearer_token_provider(
        DefaultAzureCredential(),
        "https://cognitiveservices.azure.com/.default"
    )
    http_client = httpx.Client(
        proxy=PROXY_URL,
        verify=CA_BUNDLE,
        timeout=httpx.Timeout(HTTP_TIMEOUT, connect=30.0),
        # Disable connection pooling — prevents stale connection reuse
        limits=httpx.Limits(
            max_keepalive_connections=0,
            max_connections=1,
        ),
    )
    return AzureOpenAI(
        azure_endpoint=AZURE_ENDPOINT,
        api_version=API_VERSION,
        azure_ad_token_provider=token_provider,
        http_client=http_client,
    )

