"""Phase 7 - headline results package from frozen outputs. CA split and validation pending."""
import json, random
import pandas as pd
from rl_config import ROOT, MODEL, REASONING_EFFORT, load_prompt
from rl_core import canon, OVERALL, STATUSES

O = ROOT / "04_outputs"
A, B, C, U = O / "a_population.xlsx", O / "b_rl_identification.xlsx", O / "c_preliminary_ca.xlsx", O / "c_unresolved.xlsx"
ROUTES = ROOT / "03_runs" / "triage" / "triage_routes.csv"
TLOG = ROOT / "03_runs" / "triage" / "run_log_population.csv"
ALOG = ROOT / "03_runs" / "assessment" / "run_log_population.csv"
PJSONL = ROOT / "02_prepared" / "population_model_ready.jsonl"
OUT = O / "rl_headline_results.xlsx"
SPOT = ROOT / "05_validation" / "spot_checks" / "spot_check_sample.xlsx"

PATTERNS = ["Full breach", "Threshold", "Exception", "Policy only", "Hindsight", "Didn't proceed",
            "Permitted reassessment", "Misconduct / fraud"]
TYPES = {"missing fact": "Missing fact", "conflicting evidence": "Conflicting evidence",
         "interpretive judgement or anomaly": "Interpretive judgement or anomaly",
         "interpretive judgement": "Interpretive judgement or anomaly", "anomaly": "Interpretive judgement or anomaly",
         "missing or unclear criterion": "Missing or unclear criterion", "held outside juno": "Held outside JUNO"}
DEFINITE = ["Multi-cluster breach", "RL breach only", "Prudential breach only", "BCoP/Licence breach only",
            "No compliance breach"]


def rd(p):
    return pd.read_excel(p, dtype=str, keep_default_na=False)


def norm_pattern(p):
    s = str(p).strip()
    if not s:
        return "Failed"
    if s.lower().startswith("unmatched"):
        return "Unmatched"
    if "/" in s and not s.lower().startswith("misconduct"):
        return "Mixed (treated as unmatched)"
    return canon(s, PATTERNS) or "Other"


def norm_resolver(r):
    s = str(r).strip()
    return "Source owner" if s.lower().startswith("source owner") else (
        canon(s, ["Incident raiser", "Assessor", "Method owner"]) or "Other")


def expected_overall(st):
    if all(s == "Not assessable from JUNO" for s in st):
        return "Not assessable from JUNO"
    if any(s in ("Requires assessor judgement", "Insufficient evidence", "Not assessable from JUNO", "") for s in st):
        return "Assessor-ready"
    br = [n for n, s in zip(["RL", "Prudential", "BCoP/Licence"], st) if s == "Breached"]
    return "No compliance breach" if not br else (f"{br[0]} breach only" if len(br) == 1 else "Multi-cluster breach")


def pct(n, d):
    return f"{n / d:.1%}" if d else ""


def main():
    a, c, u = rd(A), rd(C), rd(U)
    rt = pd.read_csv(ROUTES, dtype=str, keep_default_na=False)
    rt["in_population"] = rt["in_population"].str.lower().eq("true")
    pop = rt[rt["in_population"]].merge(a[["INC_ID", "Month", "INC_FLDR_LVL_2"]], on="INC_ID", how="left")

    n_a = len(a)
    n_nt = int(pop["Route"].str.startswith("Failed").sum())
    n_clear, n_plus = int((pop["Route"] == "Clear RL nexus").sum()), int((pop["Route"] == "RL plus another pathway").sum())
    n_b = n_clear + n_plus

    h = c[c["In headline (Y/N)"] == "Y"].merge(a[["INC_ID", "Month"]], on="INC_ID", how="left")
    h["Q2"] = h["Q2 confidence"]
    h["Pattern (norm)"] = h["Pattern"].map(norm_pattern)
    h["Overall (norm)"] = h["Overall"].map(lambda s: canon(s, OVERALL) or ("Failed" if not s.strip() else "Other"))
    for col, src in [("RL_s", "RL status"), ("Prud_s", "Prudential status"), ("BCoP_s", "BCoP-Licence status")]:
        h[col] = h[src].map(lambda s: canon(s, STATUSES) or "")
    n_c = int((h["Q2"] == "Reasonable confidence").sum())

    hu = u[u["INC_ID"].isin(h["INC_ID"])].copy()
    hu["Type (norm)"] = hu["Type"].map(lambda t: TYPES.get(str(t).replace("_", " ").strip().lower(), "Other"))
    hu["Resolver (norm)"] = hu["Resolver"].map(norm_resolver)

    # Consistency flags (reported, never corrected)
    flags = []
    for _, r in h.iterrows():
        if r["Overall (norm)"] == "Failed":
            continue
        f, exp = [], expected_overall([r["RL_s"], r["Prud_s"], r["BCoP_s"]])
        if exp in DEFINITE + ["Not assessable from JUNO"] and exp != r["Overall (norm)"]:
            f.append(f"Overall '{r['Overall (norm)']}' differs from cells '{exp}'")
        if r["Q2"] == "Reasonable confidence" and (r["Pattern (norm)"] in ("Unmatched", "Mixed (treated as unmatched)", "Other")
                                                    or r["Pattern basis"].strip().lower() == "observed"):
            f.append("Reasonable confidence without an Established pattern match")
        if r["Pattern (norm)"] == "Full breach" and r["RL_s"] != "Breached":
            f.append("Full breach pattern but RL not Breached")
        if r["Overall (norm)"] == "Outside RL pathway":
            f.append("Outside RL pathway on an RL-routed record")
        if f:
            flags.append({"INC_ID": r["INC_ID"], "Q2 confidence": r["Q2"], "Pattern": r["Pattern (norm)"],
                          "Overall": r["Overall (norm)"], "RL": r["RL_s"], "Prudential": r["Prud_s"],
                          "BCoP-Licence": r["BCoP_s"], "Flags": "; ".join(f)})
    fl = pd.DataFrame(flags)
    n_flag = len(fl)

    q = h["Q2"].value_counts()
    headline = [("a. Population: eligible compliance incidents", n_a, "", "CA split pending"),
                ("   of which not triaged (Azure content filter)", n_nt, pct(n_nt, n_a), "share of a"),
                ("b. RL identified", n_b, pct(n_b, n_a), "share of a"),
                ("   Clear RL nexus", n_clear, pct(n_clear, n_b), "share of b"),
                ("   RL plus another pathway", n_plus, pct(n_plus, n_b), "share of b"),
                ("c. Assessable with reasonable confidence", n_c, pct(n_c, n_b), "share of b")]
    for lvl in ["Reasonable confidence", "Within stated bounds", "Insufficient confidence", "Not assessable from JUNO"]:
        headline.append((f"   Q2: {lvl}", int(q.get(lvl, 0)), pct(int(q.get(lvl, 0)), n_b), "share of b"))
    n_fail = int(h["Q2"].str.startswith("Failed").sum())
    headline.append(("   Assessment failed (malformed output after retry)", n_fail, pct(n_fail, n_b), "share of b"))
    hd = pd.DataFrame(headline, columns=["Measure", "Count", "Share", "Denominator / note"])

    # Run summary
    tl, al = pd.read_csv(TLOG, dtype=str, keep_default_na=False), pd.read_csv(ALOG, dtype=str, keep_default_na=False)
    run = []
    for name, lg, step in [("Triage", tl, "triage"), ("Assessment", al, "assessment")]:
        txt, ver, sha = load_prompt(step)
        run.append({"Step": name, "Prompt": ver, "Prompt sha256[:12]": sha, "Model": MODEL,
                    "Reasoning effort": REASONING_EFFORT[step], "Calls (records)": len(lg),
                    "ok": int((lg["status"] == "ok").sum()), "Not ok": int((lg["status"] != "ok").sum()),
                    "Retried once": int(lg["retried"].str.lower().eq("true").sum()),
                    "Cost USD": round(pd.to_numeric(lg["cost_usd"], errors="coerce").sum(), 2),
                    "First call": lg["run_at"].replace("", None).min(), "Last call": lg["run_at"].replace("", None).max()})
    run = pd.DataFrame(run)

    refs = c[c["In headline (Y/N)"].isin(["Y", "N"]) & ~c["INC_ID"].isin(h["INC_ID"]) | c["INC_ID"].isin(
        ["INC000365033", "INC000374212", "INC000366466", "INC000366530", "INC000341409", "INC000358150",
         "INC000372012", "INC000369888", "INC000357929", "INC000362030"])][
        ["INC_ID", "In window (Y/N)", "In headline (Y/N)", "Route", "Q2 confidence", "Pattern", "Overall"]]

    limitations = [
        "CA split and validation (Phase 6) not yet performed: (c) is the model's own confidence rating and is not yet tested against completed Compliance Assessments.",
        f"{n_nt} incidents were blocked by the Azure content filter at triage and are not triaged; {n_fail} RL incident failed assessment (malformed output after one retry).",
        "Record basis is the current record (reporting snapshot 26 Oct 2026). Later facts (actions, last progress update) were included, so the run does not reflect what was known when each CA was created.",
        "The actions field has no line breaks in the extract, so the compliance-recommendation exclusion cuts from the first mention of the phrase. Some factual text after a passing mention may have been excluded.",
        "gpt-5.4 is a reasoning model; temperature is not settable. Reasoning effort was fixed at medium. A re-run may not reproduce every individual result.",
        "Model labels for pattern, overall, resolver and type varied in wording. They were normalised for reporting only; c_preliminary_ca.xlsx and c_unresolved.xlsx are unchanged model output.",
        f"{n_flag} assessed incidents carry internal consistency flags (see consistency_flags). These were reported, not corrected.",
        "Bulk incidents (720 in the population) are assessed on the exemplar only, which contributes to 'Not assessable from JUNO'.",
        "Population is the spec window 20 Apr to 20 Oct 2026; an earlier rolling-window extract (6,157 rows) was superseded.",
        "The Phase 2 reference test used an earlier preparation of the actions field; reported reference results are from the final Phase 5 run.",
    ]

    with pd.ExcelWriter(OUT) as w:
        hd.to_excel(w, sheet_name="headline", index=False)
        pd.crosstab(pop["Route"], pop["Month"], margins=True).to_excel(w, sheet_name="b_route_by_month")
        pd.crosstab(pop["INC_FLDR_LVL_2"], pop["Route"], margins=True).to_excel(w, sheet_name="b_route_by_folder")
        pd.crosstab(h["Q2"], h["Route"], margins=True).to_excel(w, sheet_name="c_q2_by_route")
        pd.crosstab(h["Q2"], h["Month"], margins=True).to_excel(w, sheet_name="c_q2_by_month")
        h["Overall (norm)"].value_counts().rename("count").to_frame().to_excel(w, sheet_name="c_overall")
        pd.crosstab(h["Pattern (norm)"], h["Overall (norm)"], margins=True).to_excel(w, sheet_name="c_pattern_x_overall")
        pd.crosstab(hu["Resolver (norm)"], hu["Type (norm)"], margins=True).to_excel(w, sheet_name="c_unresolved")
        (fl if n_flag else pd.DataFrame({"note": ["no flags"]})).to_excel(w, sheet_name="consistency_flags", index=False)
        refs.to_excel(w, sheet_name="reference_cases", index=False)
        run.to_excel(w, sheet_name="run_summary", index=False)
        pd.DataFrame({"Limitation": limitations}).to_excel(w, sheet_name="limitations", index=False)

    # Spot-check sample (spec: 10 random step-3 outputs, read for customer names / conclusion-based reasoning)
    tpl = {r["INC_ID"]: r["assessment_user_template"] for r in
           (json.loads(l) for l in PJSONL.read_text(encoding="utf-8").splitlines() if l.strip())}
    ids = random.Random(42).sample(sorted(h.loc[~h["Q2"].str.startswith("Failed"), "INC_ID"]), 10)
    sp = c[c["INC_ID"].isin(ids)].copy()
    sp["Unresolved items"] = sp["INC_ID"].map(
        lambda i: "\n".join(f"[{r['Resolver']}] {r['Question or item']}" for _, r in u[u["INC_ID"] == i].iterrows()))
    sp["Model input (assessment message)"] = sp.apply(
        lambda r: tpl.get(r["INC_ID"], "").replace("<<TRIAGE_ROUTE>>", r["Route"]), axis=1)
    sp["Customer name in output? (Y/N)"] = ""
    sp["Reasoning from conclusion text? (Y/N)"] = ""
    sp["Reviewer note"] = ""
    sp.to_excel(SPOT, index=False)

    pd.set_option("display.width", 220, "display.max_columns", 20)
    print(hd.to_string(index=False))
    print("\nOverall (norm):\n" + h["Overall (norm)"].value_counts().to_string())
    print("\nPattern (norm) x Q2:\n" + pd.crosstab(h["Pattern (norm)"], h["Q2"]).to_string())
    print("\nUnresolved (norm) resolver x type:\n" + pd.crosstab(hu["Resolver (norm)"], hu["Type (norm)"], margins=True).to_string())
    if n_flag:
        kinds = fl["Flags"].str.split("; ").explode().str.replace(r"'.*", "", regex=True).value_counts()
        print(f"\nConsistency flags: {n_flag} incidents\n" + kinds.to_string())
    print(f"\nWrote {OUT.name} and spot_checks\\{SPOT.name}")


if __name__ == "__main__":
    main()
