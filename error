def build_wp_prompt(scope_id, batch_key, n_total, sub_ctrls, scope_meta):
    n = len(sub_ctrls)
    sub_note = (
        f"\nNOTE: Sub-batch of {n} from {n_total} controls in this scope. "
        f"Assess within this sub-batch only."
        if n < n_total else ""
    )
    lines = [
        "SCOPE CONTEXT",
        "Scope type      : Within-Product Assessment",
        f"Scope ID        : {scope_id}",
        f"Product         : {scope_meta.get('Product','')}",
        f"Payment Category: {scope_meta.get('Payment Category','')}",
        f"Lifecycle Stage : {scope_meta.get('Consolidated Stage','')}",
        f"CT Reference    : {scope_meta.get('ct_ref_norm','')}",
        f"Expected Control: {scope_meta.get('Expected Control','')}",
        sub_note, "",
        f"CONTROLS TO ASSESS ({n}):", "",
    ]
    for _, row in sub_ctrls.iterrows():
        lines += ["─" * 60, build_control_text(row), ""]
    lines += [
        "─" * 60, "",
        "TASK — WITHIN-PRODUCT ASSESSMENT",
        "All controls share the same Product, Payment Category, Lifecycle",
        "Stage, and CT Reference. Compare each control against all others.",
        "Assess for Redundant Controls, Process-Split Fragmentation, and",
        "Common Control Opportunities.",
        "Note: controls in this scope may belong to multiple independent",
        "rationalisation groups — do not force them into a single group.",
        "", SME_INSTRUCTIONS, "", RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_key: "{batch_key}".',
    ]
    return "\n".join(lines)


def build_cp_prompt(scope_id, batch_key, n_total, sub_ctrls, ct_ref):
    n = len(sub_ctrls)
    products = (sub_ctrls["Product"].dropna().unique().tolist()
                if "Product" in sub_ctrls.columns else [])
    sub_note = (
        f"\nNOTE: Sub-batch of {n} from {n_total} controls. "
        f"Assess within this sub-batch only."
        if n < n_total else ""
    )
    lines = [
        "SCOPE CONTEXT",
        "Scope type   : Cross-Product Assessment",
        f"Scope ID     : {scope_id}",
        f"CT Reference : {ct_ref}",
        f"Products     : {', '.join(products[:10])}",
        sub_note, "",
        f"CONTROLS TO ASSESS ({n} across multiple products):", "",
    ]
    for _, row in sub_ctrls.iterrows():
        lines += ["─" * 60, build_control_text(row), ""]
    lines += [
        "─" * 60, "",
        "TASK — CROSS-PRODUCT ASSESSMENT WITHIN CONTROL OBJECTIVE GROUP",
        "Controls share the same CT Reference but come from different",
        "products and may be owned by different business areas.",
        "Do NOT compare controls across different CT References.",
        "Assess for Redundant Controls, Process-Split Fragmentation, and",
        "Common Control Opportunities.",
        "Note: controls in this scope may belong to multiple independent",
        "rationalisation groups — do not force them into a single group.",
        "", SME_INSTRUCTIONS, "", RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_key: "{batch_key}".',
    ]
    return "\n".join(lines)

