"""
STEP 5 (v2): Reasoning-model review of every collapsed candidate pair. The only script that spends reasoning tokens.

For each pair the model receives the complete record of both controls (all text fields,
coded metadata, org folder, ratings, Common Control references, linked L2/L3 processes)
and returns a structured case: verdict, confidence, what is the same, what is different,
scope difference, verbatim evidence from each control, a consolidation recommendation
with which control to keep and why, the risk of acting, and questions an SME would need
to settle. Everything is cached to JSONL by pair_id so the run can stop and resume.

Verdicts
  duplicate                      same activity, same scope, recorded more than once
  same_control_different_scope   same activity applied to a different entity, division,
                                 region, product, system or population; Common Control candidate
  overlapping_distinct           related activities or shared risk, but genuinely different controls
  unrelated                      similarity is superficial

Reads candidates_collapsed.parquet (Step 4b). Run order: paraphrase, lexical_only, verbatim,
calibration sets, then both. Verdicts cached in verdicts_v2.jsonl (the 20-pair trial under the
first rubric stays in verdicts.jsonl and is not reused).

Before running:  az login  (and the CA bundle env vars, as for Step 2)
Run:
  python 05_llm_review.py --dry-run          # counts, one rendered prompt, no API calls
  python 05_llm_review.py                    # full run (resumable)
  python 05_llm_review.py --sample-per-band 8 --seed 7   # stratified trial: 8 random pairs per band
  python 05_llm_review.py --mock             # fake verdicts, pipeline test only

Out:  experiments\\output\\review\\verdicts_v2.jsonl      raw model output, one line per pair
      experiments\\output\\review\\review_v2.xlsx         candidates merged with verdicts + summaries
"""
import argparse
import hashlib
import html
import json
import re
import time
from datetime import datetime
from pathlib import Path

import pandas as pd

DATA_DIR = Path(r"C:\Users\M061400\ai-test\experiments\data")
CAND_PATH = Path(r"C:\Users\M061400\ai-test\experiments\output\candidates\candidates_collapsed.parquet")
OUT_DIR = Path(r"C:\Users\M061400\ai-test\experiments\output\review")
OUT_DIR.mkdir(parents=True, exist_ok=True)
CACHE = OUT_DIR / "verdicts_v2.jsonl"

AZURE_ENDPOINT = "https://ai.eng.azure.srv.westpac.com.au"
API_VERSION = "2024-10-21"
MODEL = "gpt-5.4"
REASONING_EFFORT = "medium"
MAX_COMPLETION_TOKENS = 12000       # reasoning tokens count against this; generous by design
PROXY_URL = "http://127.0.0.1:9000"
CA_BUNDLE = r"C:\Users\m061400\ai-test\cacert.pem"
SLEEP_BETWEEN = 1.0
RETRY_COUNT = 5
MAX_PROCESSES_LISTED = 12

BAND_ORDER = ["paraphrase", "lexical_only", "verbatim", "calibration_known_family", "calibration_negative", "both"]
MASTER_COUNTS = {}
VERDICTS = ["duplicate", "same_control_different_scope", "overlapping_distinct", "unrelated"]

HTML_RE = re.compile(r"<[^>]+>")
UUID_RE = re.compile(r"([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})")

SYSTEM = """You are a senior operational risk and controls specialist reviewing a bank's controls register.
Your job is to compare two controls and produce a written case that a risk manager could act on
without a subject-matter expert in the room. The wider goal is to simplify the control environment:
fewer, clearer controls with no loss of coverage. Only recommend action where action would actually
simplify something.

Step 1, before anything else: check whether the register already links these two controls. Look at
the Common control type and Common reference fields, the family information supplied, and any control
IDs cited in either text that point to the other control or to its master. If the pair is already
governed by the master/instance framework, or the two texts explicitly cross-reference each other as
complementary controls with mutually exclusive populations, say so in already_linked_in_register and
recommend no_action_already_governed unless the records themselves are wrong or inconsistent.

Step 2: judge on what each control actually does, who performs it, over what population, on what
system, how often, by what mechanism, and how it is evidenced. Wording similarity is not evidence on
its own. Identical text in two different organisational folders can be a legitimate instance for
another division; near-identical text in the same folder is more likely a true duplicate. Read the
names for entity, brand, region and product qualifiers (WNZL, SGB, WIB, RAMS, Pacific, Asia, SOx and
similar).

Verdicts:
- duplicate: the same control activity, same mechanism, over the same scope, recorded more than once.
  One record could be retired and the other kept with no loss of coverage.
- same_control_different_scope: the same control design (same activity, same mechanism, same kind of
  evidence) applied to a different entity, division, region, product, system or population. Coverage
  is genuinely separate but the design is shared, so the pair is a candidate for the Common Control
  (master/instance) framework rather than for merging. This verdict requires the same mechanism: an
  automated tool-driven review and a manual review of the same objective are different controls.
- overlapping_distinct: the controls address the same or a related risk but are different activities
  or different mechanisms (for example a preventive and a detective control over the same process, or
  a tool-facilitated and a manual variant of the same objective). Both should remain.
- unrelated: the similarity is superficial.

Be direct about uncertainty. If the records do not contain enough to decide, say so, choose the most
defensible verdict, give a lower confidence and put the missing facts in questions_for_sme.

Respond with a single JSON object and nothing else:
{
 "already_linked_in_register": "yes" or "no" or "partly", followed by the evidence (which field or which cited ID),
 "verdict": one of ["duplicate","same_control_different_scope","overlapping_distinct","unrelated"],
 "confidence": number 0 to 1,
 "summary": "one sentence a manager could read on its own",
 "what_is_the_same": "the activity, purpose, mechanism, evidence, performer, system, frequency that match",
 "what_is_different": "every material difference you can find, or 'none found'",
 "scope_difference": "the specific entity/division/region/product/system/population difference, or 'none'",
 "mechanism_difference": "how the control is actually executed and evidenced in A versus B, or 'none'",
 "evidence_a": "short verbatim quotes from Control A that support the verdict",
 "evidence_b": "short verbatim quotes from Control B that support the verdict",
 "reasoning": "your full reasoning, step by step, including alternatives you rejected and why",
 "recommendation": one of ["retire_one_keep_other","merge_into_one","link_as_common_control","keep_both","no_action_already_governed","investigate"],
 "keep_which": "A, B, either, or n/a, with the reason (completeness of text, ratings, assessment date, linkage)",
 "simplification_benefit": "what the control environment gains if the recommendation is followed, or 'none'",
 "risk_of_acting": "what could go wrong if the recommendation is applied without further checks",
 "questions_for_sme": "the specific facts an owner would need to confirm, as a short list in one string"
}"""


def clean(v):
    if not isinstance(v, str) or v.strip().lower() in {"", "nan", "none", "null"}:
        return ""
    return re.sub(r"\s+", " ", html.unescape(HTML_RE.sub(" ", v))).strip()


def uuid_of(s):
    m = UUID_RE.search(s) if isinstance(s, str) else None
    return m.group(1).upper() if m else None


# ------------------------------------------------------------------ context
def load_context():
    c = pd.read_excel(DATA_DIR / "juno_controls.xlsx", dtype=str)
    c.columns = [x.strip() for x in c.columns]
    c["CTRL_ID"] = c["CTRL_ID"].str.strip()
    c = c.drop_duplicates("CTRL_ID").set_index("CTRL_ID")
    for cid, ref in zip(c.index, c["COMMON_CTRL_REFERENCE"]):
        for r in (set(re.findall(r"\bCTL\d{6,}\b", ref)) if isinstance(ref, str) else []):
            if r in c.index and r != cid:
                MASTER_COUNTS[r] = MASTER_COUNTS.get(r, 0) + 1
    p = pd.read_excel(DATA_DIR / "holocentric_processes.xlsx", dtype=str)
    p.columns = [x.strip() for x in p.columns]
    p["uuid"] = p["l3_activity_uuid"].map(uuid_of)
    p = p.dropna(subset=["uuid"]).drop_duplicates("uuid").set_index("uuid")
    l = pd.read_excel(DATA_DIR / "ctl_holo_linkage.xlsx", dtype=str)
    l.columns = [x.strip() for x in l.columns]
    l["uuid"] = l["L3_Activity_UUID"].map(uuid_of)
    l = l[l["uuid"].notna() & l["uuid"].isin(p.index)]
    proc_names = {}
    for cid, grp in l.groupby("Control_ID"):
        names = sorted({f"{p.at[u, 'l2_process_name']} > {p.at[u, 'l3_activity_name']}" for u in grp["uuid"]})
        proc_names[cid.strip()] = names
    return c, proc_names


def family_line(cid, c):
    r = c.loc[cid]
    typ, ref = clean(r.get("COMMON_CTRL_TYP")), clean(r.get("COMMON_CTRL_REFERENCE"))
    if typ.lower().startswith("master") or cid in MASTER_COUNTS:
        return f"Family: MASTER control with {MASTER_COUNTS.get(cid, 0)} declared instances"
    if ref:
        return f"Family: declared INSTANCE of master {ref}"
    return "Family: not in the Common Control framework"


def render_control(cid, c, proc_names, label):
    r = c.loc[cid]
    procs = proc_names.get(cid, [])
    proc_txt = "\n".join(f"  - {x}" for x in procs[:MAX_PROCESSES_LISTED]) if procs else "  (no process linkage recorded)"
    if len(procs) > MAX_PROCESSES_LISTED:
        proc_txt += f"\n  - ... and {len(procs) - MAX_PROCESSES_LISTED} more"
    return f"""=== CONTROL {label}: {cid} ===
Name: {clean(r.get('CTRL_NAME'))}
Org folder: {clean(r.get('CTRL_FLDR'))}
{family_line(cid, c)}
Category: {clean(r.get('CTRL_CATEGORY'))} | Common control type: {clean(r.get('COMMON_CTRL_TYP')) or 'n/a'} | Common reference: {clean(r.get('COMMON_CTRL_REFERENCE')) or 'none'}
Nature: {clean(r.get('CTRL_NATRE'))} | Type: {clean(r.get('CTRL_TYP'))} | Frequency: {clean(r.get('CTRL_FREQ'))} | Key control: {clean(r.get('CTRL_KEY_CONTRL'))}
Status: {clean(r.get('CTRL_STUS'))} | Assessment: {clean(r.get('CTRL_ASSESS_RTNG'))} ({clean(r.get('CTRL_ASSESS_DT'))}) | Design: {clean(r.get('CTRL_DE_RTNG'))} | Operating: {clean(r.get('CTRL_OE_RTNG'))}
Category 1 / 2: {clean(r.get('CTRL_CTGRY_1'))} / {clean(r.get('CTRL_CTGRY_2'))}
Linked processes ({len(procs)}):
{proc_txt}

Control objective:
{clean(r.get('CTRL_DESC'))}

Detailed description:
{clean(r.get('CTRL_DESC_OF_CTRL'))}

How evidenced:
{clean(r.get('CTRL_EVDNCD'))}

How monitored:
{clean(r.get('CTRL_MNTRD'))}
"""


def render_pair(row, c, proc_names):
    head = (f"Similarity scores (for your information only, not evidence): embedding cosine {row['cosine_embed']:.3f}, "
            f"TF-IDF cosine {row['cosine_tfidf']:.3f}. Identical name: {row['exact_name']}. Identical objective: {row['exact_desc']}. "
            f"Same org folder: {row['same_folder']}. Shared L2 processes: {row['shared_l2']}.\n")
    n_rep = row.get("n_pairs_represented") or 1
    if n_rep and n_rep > 1:
        head += (f"Note: this pair represents {int(n_rep)} similar candidate pairs between members of the same two "
                 f"control families (A side: {row.get('members_a')}; B side: {row.get('members_b')}). "
                 f"Judge the two records shown.\n")
    head += "\n"
    return head + render_control(row["ctrl_a"], c, proc_names, "A") + "\n" + render_control(row["ctrl_b"], c, proc_names, "B")


# ------------------------------------------------------------------ client
def make_client():
    import httpx
    from azure.identity import DefaultAzureCredential, get_bearer_token_provider
    from openai import AzureOpenAI
    tp = get_bearer_token_provider(DefaultAzureCredential(), "https://cognitiveservices.azure.com/.default")
    return AzureOpenAI(azure_endpoint=AZURE_ENDPOINT, api_version=API_VERSION, azure_ad_token_provider=tp,
                       http_client=httpx.Client(proxy=PROXY_URL, verify=CA_BUNDLE, timeout=httpx.Timeout(600.0, connect=30.0),
                                                limits=httpx.Limits(max_keepalive_connections=0, max_connections=1)))


def call_model(holder, user_text, mock=False):
    if mock:
        h = int(hashlib.md5(user_text.encode()).hexdigest()[:8], 16)
        v = VERDICTS[h % 4]
        return {"already_linked_in_register": ["yes", "no", "partly"][h % 3], "verdict": v, "confidence": 0.5 + (h % 50) / 100,
                "summary": "mock", "reasoning": "mock", "recommendation": "investigate", "keep_which": "n/a"}, {"prompt_tokens": 1000, "completion_tokens": 500, "reasoning_tokens": 300}, "{}"
    for attempt in range(1, RETRY_COUNT + 1):
        try:
            resp = holder["client"].chat.completions.create(
                model=MODEL, reasoning_effort=REASONING_EFFORT, max_completion_tokens=MAX_COMPLETION_TOKENS,
                response_format={"type": "json_object"},
                messages=[{"role": "system", "content": SYSTEM}, {"role": "user", "content": user_text}])
            raw = resp.choices[0].message.content or ""
            usage = {"prompt_tokens": resp.usage.prompt_tokens, "completion_tokens": resp.usage.completion_tokens,
                     "reasoning_tokens": getattr(getattr(resp.usage, "completion_tokens_details", None), "reasoning_tokens", None)}
            return json.loads(raw), usage, raw
        except json.JSONDecodeError as e:
            print(f"    bad JSON (attempt {attempt}): {e}")
            if attempt == RETRY_COUNT:
                return {"verdict": "parse_error", "raw": raw[:4000]}, usage, raw
        except Exception as e:
            wait = 5 * attempt
            print(f"    retry {attempt}/{RETRY_COUNT} after {type(e).__name__}: {str(e)[:150]} (sleep {wait}s)")
            time.sleep(wait)
            holder["client"] = make_client()
    raise RuntimeError("model call failed after retries")


# ------------------------------------------------------------------ main
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bands", nargs="*", default=BAND_ORDER)
    ap.add_argument("--limit", type=int, default=None, help="max pairs to call this run")
    ap.add_argument("--sample-per-band", type=int, default=None, help="random pairs per band (stratified trial)")
    ap.add_argument("--seed", type=int, default=7)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--mock", action="store_true")
    args = ap.parse_args()

    cand = pd.read_parquet(CAND_PATH)
    cand["band"] = pd.Categorical(cand["band"], categories=BAND_ORDER, ordered=True)
    cand = cand[cand["band"].isin(args.bands)].sort_values(["band", "cosine_embed"], ascending=[True, False]).reset_index(drop=True)
    c, proc_names = load_context()

    done = {}
    if CACHE.exists():
        for line in open(CACHE, encoding="utf-8"):
            rec = json.loads(line); done[rec["pair_id"]] = rec
    if args.sample_per_band:
        parts = [g.sample(min(len(g), args.sample_per_band), random_state=args.seed)
                 for _, g in cand.groupby("band", observed=True)]
        cand = pd.concat(parts).sort_values("band").reset_index(drop=True)
    todo = cand[~cand["pair_id"].isin(done)]
    if args.limit:
        todo = todo.head(args.limit)
    print(f"selected {len(cand)} pairs | cached {cand['pair_id'].isin(done).sum()} | to call {len(todo)}")
    print(todo["band"].value_counts().reindex(BAND_ORDER).dropna().to_string())
    if args.dry_run:
        row = todo.iloc[0]
        txt = render_pair(row, c, proc_names)
        print(f"\n--- sample prompt ({row['pair_id']}, band {row['band']}, ~{len(txt)//4} tokens) ---\n{txt[:6000]}")
        return

    holder = {"client": None if args.mock else make_client()}
    t0, n_done, tok_in, tok_out = time.time(), 0, 0, 0
    with open(CACHE, "a", encoding="utf-8") as f:
        for _, row in todo.iterrows():
            txt = render_pair(row, c, proc_names)
            out, usage, raw = call_model(holder, txt, mock=args.mock)
            rec = {"pair_id": row["pair_id"], "ctrl_a": row["ctrl_a"], "ctrl_b": row["ctrl_b"], "band": str(row["band"]),
                   "model": MODEL, "reasoning_effort": REASONING_EFFORT, "ts": datetime.now().isoformat(timespec="seconds"),
                   **{f"llm_{k}": v for k, v in out.items()}, **usage}
            f.write(json.dumps(rec, ensure_ascii=False) + "\n"); f.flush()
            done[rec["pair_id"]] = rec
            n_done += 1; tok_in += usage.get("prompt_tokens", 0) or 0; tok_out += usage.get("completion_tokens", 0) or 0
            if n_done % 10 == 0 or n_done == len(todo):
                rate = (time.time() - t0) / n_done
                print(f"  {n_done}/{len(todo)}  {rate:.1f}s/pair  eta {(len(todo)-n_done)*rate/60:.0f} min  "
                      f"tokens in {tok_in:,} out {tok_out:,}  last: {row['band']} -> {out.get('verdict')} ({out.get('confidence')})")
            time.sleep(SLEEP_BETWEEN)

    # merge and summarise everything cached so far
    v = pd.DataFrame(list(done.values()))
    full = pd.read_parquet(CAND_PATH)
    merged = full.merge(v.drop(columns=["ctrl_a", "ctrl_b", "band"]), on="pair_id", how="left")
    reviewed = merged[merged["llm_verdict"].notna()]
    print(f"\nreviewed so far: {len(reviewed)} of {len(full)}")
    xt = pd.crosstab(reviewed["band"], reviewed["llm_verdict"], margins=True)
    print("\nband x verdict\n" + xt.to_string())
    cal = reviewed[reviewed["set"].str.startswith("calibration")]
    if len(cal):
        print("\ncalibration\n" + pd.crosstab(cal["set"], cal["llm_verdict"]).to_string())
    rec_xt = pd.crosstab(reviewed["llm_verdict"], reviewed["llm_recommendation"]) if "llm_recommendation" in reviewed else None
    if rec_xt is not None:
        print("\nverdict x recommendation\n" + rec_xt.to_string())
    if "llm_already_linked_in_register" in reviewed:
        linked = reviewed["llm_already_linked_in_register"].astype(str).str.split().str[0].str.lower().str.strip(",.;:")
        print("\nalready linked in register\n" + pd.crosstab(linked, reviewed["llm_verdict"]).to_string())
    if "n_pairs_represented" in reviewed:
        rep = reviewed["n_pairs_represented"].fillna(1).astype(int)
        print(f"\npairs represented by reviewed verdicts: {int(rep.sum())}")
    for col in ["text_a", "text_b"]:
        merged[col] = merged[col].str.slice(0, 1500)
    with pd.ExcelWriter(OUT_DIR / "review_v2.xlsx", engine="openpyxl") as xw:
        merged.to_excel(xw, sheet_name="pairs", index=False)
        xt.to_excel(xw, sheet_name="band_x_verdict")
        if rec_xt is not None:
            rec_xt.to_excel(xw, sheet_name="verdict_x_recommendation")
        if len(cal):
            pd.crosstab(cal["set"], cal["llm_verdict"]).to_excel(xw, sheet_name="calibration")
    print(f"\nwritten -> {OUT_DIR}")


if __name__ == "__main__":
    main()
