"""Phase 5 - preliminary assessment for RL-routed incidents + reference cases. Parallel, resumable."""
import json, time
from concurrent.futures import ThreadPoolExecutor, as_completed
import pandas as pd
from rl_config import ROOT, MODEL, REASONING_EFFORT, load_prompt, get_client
from rl_core import (run_one, validate_assessment, flatten_assessment, flatten_unresolved,
                     LOG_FIELDS, RL_ROUTES, Q2)

WORKERS = 20
IN_JSONL = ROOT / "02_prepared" / "population_model_ready.jsonl"
ROUTES_CSV = ROOT / "03_runs" / "triage" / "triage_routes.csv"
RAW = ROOT / "03_runs" / "assessment" / "raw_responses"
CKPT = ROOT / "03_runs" / "assessment" / "assessment_checkpoint.jsonl"
LOG = ROOT / "03_runs" / "assessment" / "run_log_population.csv"
OUT_C = ROOT / "04_outputs" / "c_preliminary_ca.xlsx"
OUT_U = ROOT / "04_outputs" / "c_unresolved.xlsx"
C_COLS = ["INC_ID", "In window (Y/N)", "In headline (Y/N)", "CA exists", "Route", "Q2 confidence",
          "Pattern", "Pattern basis", "Anomaly type", "What changes the outcome", "Would change if",
          "RL status", "RL provisions", "RL sub-lines", "Prudential status", "Prudential provisions",
          "BCoP-Licence status", "BCoP-Licence provisions", "BCoP-Licence sub-lines", "Overall"]
U_COLS = ["INC_ID", "Type", "Resolver", "Question or item", "Fact no", "Cluster affected",
          "What each answer would change"]


def as_bool(s):
    return s.astype(str).str.strip().str.lower().eq("true")


def main():
    recs = {r["INC_ID"]: r for r in
            (json.loads(l) for l in IN_JSONL.read_text(encoding="utf-8").splitlines() if l.strip())}
    rt = pd.read_csv(ROUTES_CSV, dtype={"INC_ID": str})
    rt["in_population"], rt["is_reference"] = as_bool(rt["in_population"]), as_bool(rt["is_reference"])
    triaged_ok = ~rt["Route"].astype(str).str.startswith("Failed")
    sel = rt[triaged_ok & ((rt["in_population"] & rt["Route"].isin(RL_ROUTES)) | rt["is_reference"])]

    done = {}
    if CKPT.exists():
        for l in CKPT.read_text(encoding="utf-8").splitlines():
            if l.strip():
                r = json.loads(l)
                done[r["INC_ID"]] = r
    todo = [r for _, r in sel.iterrows()
            if r["INC_ID"] not in done or done[r["INC_ID"]]["status"] == "api_error"]

    system, ver, sha = load_prompt("assessment")
    client, auth = get_client()
    b_n = int((rt["in_population"] & rt["Route"].isin(RL_ROUTES)).sum())
    print(f"{MODEL} effort={REASONING_EFFORT['assessment']} | {ver} {sha} | (b) RL-routed population={b_n:,} | "
          f"selected incl. reference={len(sel):,} | already done={len(sel) - len(todo):,} | "
          f"to run={len(todo):,} | workers={WORKERS}", flush=True)

    def work(row):
        inc, route = row["INC_ID"], row["Route"]
        base = {"INC_ID": inc, "Route": route, "in_population": bool(row["in_population"]),
                "is_reference": bool(row["is_reference"])}
        try:
            user = recs[inc]["assessment_user_template"].replace("<<TRIAGE_ROUTE>>", route)
            d, log = run_one(client, "assessment", inc, system, ver, sha, user, validate_assessment, RAW,
                             prefix="pop_")
            return {**base, "status": log["status"], "parsed": d, "log": log}
        except Exception as e:
            log = {k: "" for k in LOG_FIELDS}
            log.update(INC_ID=inc, step="assessment", status="api_error", error=f"{type(e).__name__}: {e}"[:300])
            return {**base, "status": "api_error", "parsed": None, "log": log}

    t0, n, stats = time.time(), 0, {}
    with open(CKPT, "a", encoding="utf-8") as f, ThreadPoolExecutor(WORKERS) as ex:
        for fu in as_completed([ex.submit(work, r) for r in todo]):
            res = fu.result()
            f.write(json.dumps(res, ensure_ascii=False, default=str) + "\n")
            f.flush()
            done[res["INC_ID"]] = res
            n += 1
            stats[res["status"]] = stats.get(res["status"], 0) + 1
            if n % 25 == 0 or n == len(todo):
                el = time.time() - t0
                print(f"  {n:,}/{len(todo):,} {stats} elapsed={el / 60:.1f}m "
                      f"eta={el / n * (len(todo) - n) / 60:.1f}m", flush=True)

    c_rows, u_rows, logs = [], [], []
    for _, row in sel.iterrows():
        r = done.get(row["INC_ID"])
        if not r:
            continue
        logs.append(r["log"])
        if r["status"] == "ok":
            c_rows.append(flatten_assessment(r["INC_ID"], r["parsed"], r["Route"], r["in_population"]))
            u_rows += flatten_unresolved(r["INC_ID"], r["parsed"])
        else:
            fl = {c: "" for c in C_COLS}
            fl.update({"INC_ID": r["INC_ID"], "In window (Y/N)": "Y" if r["in_population"] else "N",
                       "In headline (Y/N)": "Y" if (r["in_population"] and r["Route"] in RL_ROUTES) else "N",
                       "CA exists": "pending CA join", "Route": r["Route"],
                       "Q2 confidence": f"Failed ({r['status']})"})
            c_rows.append(fl)

    pd.DataFrame(logs, columns=LOG_FIELDS).to_csv(LOG, index=False)
    c = pd.DataFrame(c_rows, columns=C_COLS)
    u = pd.DataFrame(u_rows, columns=U_COLS)
    c.to_excel(OUT_C, index=False)
    u.to_excel(OUT_U, index=False)

    h = c[c["In headline (Y/N)"] == "Y"]
    hu = u[u["INC_ID"].isin(h["INC_ID"])]
    pd.set_option("display.width", 220, "display.max_columns", 20)
    print(f"\n(b) RL identified (population): {b_n:,} | assessed rows in headline: {len(h):,}")
    q = h["Q2 confidence"].value_counts()
    rc = int(q.get("Reasonable confidence", 0))
    print(f"(c) Reasonable confidence: {rc:,} = {rc / b_n:.1%} of (b)" if b_n else "(c) n/a")
    print("\nQ2 confidence (denominator = b):\n" +
          pd.DataFrame({"count": q, "share_of_b": (q / b_n).round(3)}).to_string())
    print("\nQ2 by route:\n" + pd.crosstab(h["Q2 confidence"], h["Route"], margins=True).to_string())
    print("\nOverall:\n" + h["Overall"].value_counts().to_string())
    print("\nPattern x Overall:\n" + pd.crosstab(h["Pattern"], h["Overall"], margins=True).to_string())
    print(f"\nUnresolved items (headline): {len(hu):,} across {hu['INC_ID'].nunique():,} incidents")
    print("by Resolver:\n" + hu["Resolver"].value_counts().to_string())
    print("by Type:\n" + hu["Type"].value_counts().to_string())
    ref = c[c["INC_ID"].isin(sel.loc[sel["is_reference"], "INC_ID"])]
    print("\nReference cases:\n" + ref[["INC_ID", "In headline (Y/N)", "Route", "Q2 confidence",
                                       "Pattern", "Overall"]].to_string(index=False))
    lg = pd.DataFrame(logs)
    print(f"\nretried={int(lg['retried'].astype(str).eq('True').sum())} "
          f"fenced={int(lg['fenced'].astype(str).eq('True').sum())} "
          f"cost=US${pd.to_numeric(lg['cost_usd'], errors='coerce').sum():.2f}")
    errs = lg[lg["status"] != "ok"][["INC_ID", "status", "error"]].copy()
    errs["error"] = errs["error"].astype(str).str[:110]
    print("failures:\n" + (errs.to_string(index=False) if len(errs) else "  none"))
    print(f"\nWrote {OUT_C.name}, {OUT_U.name}, {LOG.name}. Outputs now frozen: do not rerun after the CA join.")


if __name__ == "__main__":
    main()
