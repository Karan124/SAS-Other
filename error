def build_prompt(scope_id, batch_key, product, n_total, sub_ctrls):
    n = len(sub_ctrls)
    note = (f"\nNOTE: Sub-batch of {n} from {n_total} controls in this product scope."
            f" Assess within this sub-batch only."
            if n < n_total else "")
    lines = [
        f"PRODUCT: {product}",
        f"SCOPE ID: {scope_id}",
        note, "",
        f"CONTROLS TO ASSESS ({n}):", "",
    ]
    for _, row in sub_ctrls.iterrows():
        lines.append("─" * 60)
        lines.append(str(row.get("llm_payload_text", "") or
                         f"Control ID: {row['Control_ID']}"))
        lines.append("")
    lines += [
        "─" * 60, "",
        "TASK",
        "Compare every control against all others in this group.",
        "Identify Redundant Controls, Process-Split Fragmentation,",
        "and Common Control Opportunities.",
        "Multiple independent rationalisation groups are allowed.",
        "Do NOT force all controls into a single group.",
        "", INSTRUCTIONS, "", RESPONSE_FORMAT,
        f'\nUse scope_id: "{scope_id}" and batch_key: "{batch_key}".',
    ]
    return "\n".join(lines)

# ─────────────────────────────────────────────────────────────────────────────
#  LOGGING
# ─────────────────────────────────────────────────────────────────────────────

def get_logger(suffix=""):
    name = f"ctrl_rat{suffix}"
    logger = logging.getLogger(name)
    if logger.handlers:
        return logger
    fh = logging.FileHandler(
        OUTPUT_DIR / f"processing_log{suffix}.txt", encoding="utf-8")
    ch = logging.StreamHandler(sys.stdout)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s",
                            datefmt="%Y-%m-%d %H:%M:%S")
    fh.setFormatter(fmt); ch.setFormatter(fmt)
    fh.setLevel(logging.DEBUG); ch.setLevel(logging.INFO)
    logger.addHandler(fh); logger.addHandler(ch)
    logger.setLevel(logging.DEBUG)
    return logger

# ─────────────────────────────────────────────────────────────────────────────
#  CHECKPOINT
# ─────────────────────────────────────────────────────────────────────────────

def load_checkpoint(path):
    done = set()
    if not path.exists():
        return done
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                key = json.loads(line).get("batch_key", "")
                if key:
                    done.add(key)
            except json.JSONDecodeError:
                continue
    return done


def write_checkpoint(rec, path):
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=True) + "\n")

# ─────────────────────────────────────────────────────────────────────────────
#  LLM CALL
# ─────────────────────────────────────────────────────────────────────────────

def parse_response(text):
    text = re.sub(r'^```(?:json)?\s*', '', (text or "").strip())
    text = re.sub(r'\s*```$', '', text).strip()
    if not text:
        raise ValueError("Empty response")
    try:
        result = json.loads(text)
    except json.JSONDecodeError:
        m = re.search(r'\{.*\}', text, re.DOTALL)
        if m:
            result = json.loads(m.group(0))
        else:
            raise
    if "assessments" not in result:
        raise ValueError("Missing 'assessments' key")
    return result


def call_llm(prompt, batch_key, log):
    usage = {"input_tokens": 0, "output_tokens": 0}
    for attempt in range(1, RETRY_COUNT + 1):
        try:
            client  = make_client()
            resp    = client.chat.completions.create(
                model=LLM_MODEL,
                messages=[
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user",   "content": prompt},
                ],
                reasoning_effort="low",
                max_completion_tokens=MAX_COMPLETION_TOKENS,
            )
            text = resp.choices[0].message.content or ""
            u    = getattr(resp, "usage", None)
            if u:
                usage["input_tokens"]  = getattr(u, "prompt_tokens", 0)
                usage["output_tokens"] = getattr(u, "completion_tokens", 0)
            return parse_response(text), usage
        except Exception as exc:
            is_conn = any(w in str(exc).lower()
                          for w in ["connection","timed out","timeout","proxy"])
            if attempt < RETRY_COUNT:
                wait = CONNECTION_SLEEP_SECS if is_conn else min(
                    RETRY_BASE_SECS * 2**(attempt-1) + random.uniform(0,2), 60)
                log.warning(f"  Attempt {attempt} [{batch_key}]: {exc}. "
                            f"Wait {wait:.0f}s...")
                time.sleep(wait)
            else:
                log.error(f"  All retries failed [{batch_key}]: {exc}")
                return None, usage

# ─────────────────────────────────────────────────────────────────────────────
#  SCOPE DATA HELPERS
# ─────────────────────────────────────────────────────────────────────────────

def get_scope_controls(scope_id, pairs_df, expanded_df):
    """
    Return ALL controls in this scope from the expanded parquet.
    This is the source of truth — not the pairs table.
    Controls with no similar pairs (below threshold) are included here;
    get_batch_controls assigns them to batch 0 as orphans.
    """
    return (expanded_df[expanded_df["scope_id"] == scope_id]
            .drop_duplicates(subset=["Control_ID"])
            .reset_index(drop=True))


def get_batch_controls(scope_id, batch_id, send_all, pairs_df, expanded_df):
    """
    Return controls for a specific batch.
    Script 2 now saves ALL pairs (not just above-threshold), so every
    control appears in pairs_df. Any control still missing (orphan) is
    added to batch 0 as a safety net.
    """
    all_in_scope = (expanded_df[expanded_df["scope_id"] == scope_id]
                    .drop_duplicates(subset=["Control_ID"]))

    if send_all:
        return all_in_scope.reset_index(drop=True)

    sp = pairs_df[pairs_df["scope_id"] == scope_id]

    # Controls assigned to this batch (control_id_a is the primary key)
    batch_ids = set(
        sp[sp["batch_id"].astype(int) == batch_id]["control_id_a"].dropna()
    )

    # Safety net: any control in scope but not in any pair → add to batch 0
    if batch_id == 0:
        paired_ids = set(sp["control_id_a"].dropna())
        all_ctrl_ids = set(all_in_scope["Control_ID"])
        orphan_ids = all_ctrl_ids - paired_ids
        batch_ids = batch_ids | orphan_ids

    return (all_in_scope[all_in_scope["Control_ID"].isin(batch_ids)]
            .reset_index(drop=True))

# ─────────────────────────────────────────────────────────────────────────────
#  PROCESSING LOOP
# ─────────────────────────────────────────────────────────────────────────────

def process_scopes(scope_df, pairs_df, expanded_df, ck_path, done_keys, log):
    total_in = total_out = 0
    n_proc = n_skip = n_err = 0
    n_total = len(scope_df)
    t0 = time.time()

    for row_num, sr in enumerate(scope_df.itertuples(index=False), 1):
        scope_id    = sr.scope_id
        product     = getattr(sr, "Product", "")
        send_all    = bool(getattr(sr, "send_all", True))
        n_controls  = int(getattr(sr, "n_controls", 0))
        n_batches   = int(getattr(sr, "n_batches", 1))
        skip_reason = getattr(sr, "skip_reason", "")

        # Skip single-control scopes
        if skip_reason == "single_control" or n_controls < 2:
            bk = f"{scope_id}::0::0"
            if bk not in done_keys:
                write_checkpoint({"batch_key": bk, "scope_id": scope_id,
                                  "skipped": True, "skip_reason": "single_control",
                                  "assessments": []}, ck_path)
                done_keys.add(bk)
            n_skip += 1
            continue

        # Progress
        elapsed = time.time() - t0
        pct     = row_num / n_total * 100
        eta_s   = (elapsed / row_num) * (n_total - row_num) if row_num > 1 else 0
        eta_str = (f"{int(eta_s//3600)}h {int((eta_s%3600)//60)}m"
                   if eta_s > 60 else f"{int(eta_s)}s")
        cost    = ((total_in/1e6*INPUT_PRICE_PER_M +
                    total_out/1e6*OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
        print(f"\r  [{pct:5.1f}%] {scope_id[:55]:<55} "
              f"ETA {eta_str}  A${cost:.2f}", end="")

        all_scope_ctrls = get_scope_controls(scope_id, pairs_df, expanded_df)
        n_scope         = len(all_scope_ctrls)
        if n_scope == 0:
            continue

        for batch_id in (range(n_batches) if not send_all else [0]):
            batch = get_batch_controls(
                scope_id, batch_id, send_all, pairs_df, expanded_df)
            if len(batch) == 0:
                continue

            n_sub = max(1, (len(batch) + SUB_BATCH_SIZE - 1) // SUB_BATCH_SIZE)
            for sub_idx in range(n_sub):
                sub = batch.iloc[
                    sub_idx*SUB_BATCH_SIZE:(sub_idx+1)*SUB_BATCH_SIZE
                ].reset_index(drop=True)
                if len(sub) == 0:
                    continue

                bk = f"{scope_id}::{batch_id}::{sub_idx}"
                if bk in done_keys:
                    n_skip += 1
                    continue

                prompt = build_prompt(scope_id, bk, product, n_scope, sub)
                result, usage = call_llm(prompt, bk, log)
                total_in  += usage.get("input_tokens", 0)
                total_out += usage.get("output_tokens", 0)

                if result is None:
                    n_err += 1
                    write_checkpoint({
                        "batch_key": bk, "scope_id": scope_id,
                        "error": True, "assessments": [],
                        "control_ids_in_batch": sub["Control_ID"].tolist(),
                    }, ck_path)
                else:
                    result.update({
                        "batch_key":   bk,
                        "product":     product,
                        "input_tokens":  usage.get("input_tokens", 0),
                        "output_tokens": usage.get("output_tokens", 0),
                        "error": False,
                        "control_ids_in_batch": sub["Control_ID"].tolist(),
                    })
                    write_checkpoint(result, ck_path)
                    n_proc += 1

                done_keys.add(bk)
                time.sleep(SLEEP_BETWEEN)

    print()
    cost = ((total_in/1e6*INPUT_PRICE_PER_M +
             total_out/1e6*OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
    log.info(f"  Processed: {n_proc:,} | Skipped: {n_skip:,} | "
             f"Errors: {n_err:,} | Cost: A${cost:.2f}")
    return cost

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force",    action="store_true",
                        help="Clear checkpoint and restart.")
    parser.add_argument("--sample",   action="store_true",
                        help=f"Run sample only: {SAMPLE_PRODUCTS}")
    parser.add_argument("--wp-range", nargs=2, type=int,
                        metavar=("START","END"),
                        help="Process scope rows [START:END] only.")
    parser.add_argument("--suffix",   default="",
                        help="Checkpoint/log file suffix for parallel runs.")
    args = parser.parse_args()

    log = get_logger(args.suffix)
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 3: LLM Assessment")
    log.info(f"  Model          : {LLM_MODEL} (low reasoning)")
    log.info(f"  Sub-batch size : {SUB_BATCH_SIZE} controls per call")
    log.info(f"  Suffix         : '{args.suffix}'")
    log.info(f"  Sample mode    : {args.sample}"
             + (f" → {SAMPLE_PRODUCTS}" if args.sample else ""))
    log.info(f"  Started        : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    for f in [EXPANDED_PARQUET, SCOPE_WP_PARQUET, CAND_WP_PARQUET, RUN_CONFIG]:
        if not f.exists():
            log.error(f"Required input not found: {f.name}. Run Scripts 1 and 2.")
            sys.exit(1)

    ck_path = OUTPUT_DIR / f"llm_checkpoint_within_product{args.suffix}.jsonl"

    if args.force:
        if ck_path.exists():
            ck_path.unlink()
            log.info(f"Checkpoint cleared: {ck_path.name}")

    log.info("Loading data...")
    expanded = pd.read_parquet(EXPANDED_PARQUET, engine="pyarrow")
    scope_df = pd.read_parquet(SCOPE_WP_PARQUET, engine="pyarrow")
    pairs_df = pd.read_parquet(CAND_WP_PARQUET,  engine="pyarrow")
    log.info(f"  Scopes: {len(scope_df):,} | Pairs: {len(pairs_df):,} | "
             f"Expanded rows: {len(expanded):,}")

    # Apply filters
    if args.sample:
        scope_df = scope_df[
            scope_df["Product"].isin(SAMPLE_PRODUCTS)
        ].reset_index(drop=True)
        log.info(f"  Sample: {len(scope_df):,} scopes for "
                 f"{scope_df['Product'].unique().tolist()}")
    elif args.wp_range:
        s, e = args.wp_range
        scope_df = scope_df.iloc[s:e].reset_index(drop=True)
        log.info(f"  Range [{s}:{e}]: {len(scope_df):,} scopes")

    log.info("Verifying connectivity...")
    try:
        make_client()
        log.info("  OK.")
    except Exception as e:
        log.error(f"  Failed: {e}")
        sys.exit(1)

    done_keys = load_checkpoint(ck_path)
    log.info(f"  Done keys in checkpoint: {len(done_keys):,}")

    cost = process_scopes(
        scope_df, pairs_df, expanded, ck_path, done_keys, log)

    with open(RUN_CONFIG) as f:
        config = json.load(f)
    config[f"step3{args.suffix}_completed_at"]   = datetime.now().isoformat()
    config[f"step3{args.suffix}_total_cost_aud"] = round(cost, 2)
    with open(RUN_CONFIG, "w") as f:
        json.dump(config, f, indent=2)

    log.info("=" * 70)
    log.info(f"  Step 3 complete. Cost: A${cost:.2f}")
    log.info("  Run 04_postprocess_outputs.py next.")
    log.info("=" * 70)

if __name__ == "__main__":
    main()
