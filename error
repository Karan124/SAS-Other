<title>Payments Controls PoC</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Inter:wght@300;400;500;600;700&display=swap">

<style>
/* ── Westpac brand palette + dark data aesthetic ──────────────────────────
   Layout: full-bleed sections, sticky nav, visual-first
   Type: Inter (all roles) · IBM Plex Mono (data/code)
   Color: Westpac Red #DA2032 · Deep charcoal bg · light foreground
   ───────────────────────────────────────────────────────────────────────── */
:root {
  --bg:       #111214;
  --bg2:      #1a1c1f;
  --bg3:      #242629;
  --border:   #2e3035;
  --fg:       #f0f1f3;
  --fg2:      #9499a3;
  --fg3:      #55595f;
  --red:      #DA2032;
  --red-lt:   #f5424f;
  --red-dk:   #a51827;
  --amber:    #f59e0b;
  --green:    #22c55e;
  --blue:     #38bdf8;
  --purple:   #a78bfa;
  --font:     'Inter', sans-serif;
  --mono:     'IBM Plex Mono', monospace;
  color-scheme: dark;
}
@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) {
    --bg:     #f4f4f5;
    --bg2:    #ffffff;
    --bg3:    #e9eaec;
    --border: #d1d4d9;
    --fg:     #0f1013;
    --fg2:    #454952;
    --fg3:    #8a8f99;
    --red:    #DA2032;
    --red-lt: #c01a2a;
    --red-dk: #8e0d1b;
    --amber:  #d97706;
    --green:  #16a34a;
    --blue:   #0284c7;
    --purple: #7c3aed;
    color-scheme: light;
  }
}
:root[data-theme="light"] {
  --bg:     #f4f4f5; --bg2: #ffffff; --bg3: #e9eaec; --border: #d1d4d9;
  --fg:     #0f1013; --fg2: #454952; --fg3: #8a8f99;
  --red:    #DA2032; --red-lt: #c01a2a; --red-dk: #8e0d1b;
  --amber:  #d97706; --green: #16a34a; --blue: #0284c7; --purple: #7c3aed;
  color-scheme: light;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--fg);
  line-height: 1.6;
  overflow-x: hidden;
}

/* ── NAV ───────────────────────────────────────────────────────────────── */
#nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: color-mix(in srgb, var(--bg) 92%, transparent);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center;
  overflow-x: auto; scrollbar-width: none;
}
#nav::-webkit-scrollbar { display: none; }
.nav-brand {
  display: flex; align-items: center; gap: 10px;
  padding: 0 20px; border-right: 1px solid var(--border);
  flex-shrink: 0; height: 48px;
}
/* Westpac W logo drawn inline */
.nav-w {
  width: 22px; height: 22px; flex-shrink: 0;
}
.nav-title {
  font-size: 11px; font-weight: 700; letter-spacing: .06em;
  text-transform: uppercase; color: var(--fg2); white-space: nowrap;
}
.nav-items {
  display: flex; flex: 1; overflow-x: auto; scrollbar-width: none;
}
.nav-items::-webkit-scrollbar { display: none; }
.nav-btn {
  background: none; border: none; border-bottom: 2px solid transparent;
  color: var(--fg3); font-family: var(--font); font-size: 11px;
  font-weight: 500; letter-spacing: .05em; text-transform: uppercase;
  padding: 0 14px; height: 48px; cursor: pointer; white-space: nowrap;
  transition: color .15s, border-color .15s;
}
.nav-btn:hover { color: var(--fg); }
.nav-btn.active { color: var(--red); border-bottom-color: var(--red); }
.nav-end {
  padding: 0 14px; border-left: 1px solid var(--border);
  flex-shrink: 0; height: 48px; display: flex; align-items: center;
}
.theme-btn {
  background: var(--bg3); border: 1px solid var(--border);
  color: var(--fg2); font-size: 12px; padding: 4px 10px;
  border-radius: 5px; cursor: pointer; transition: background .15s;
}
.theme-btn:hover { background: var(--border); color: var(--fg); }

/* ── SECTIONS ──────────────────────────────────────────────────────────── */
section {
  min-height: 100vh;
  padding: 100px max(28px, env(safe-area-inset-left,0px)) 72px;
  border-bottom: 1px solid var(--border);
  scroll-margin-top: 48px;
}
.inner { max-width: 1000px; margin: 0 auto; }

/* eyebrow */
.eyebrow {
  font-family: var(--mono); font-size: 10px; font-weight: 600;
  letter-spacing: .18em; text-transform: uppercase; color: var(--red);
  display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
}
.eyebrow::before {
  content: ''; width: 20px; height: 2px; background: var(--red); flex-shrink: 0;
}
h1 {
  font-size: clamp(2.2rem,5.5vw,4rem); font-weight: 700; line-height: 1.1;
  letter-spacing: -.025em; text-wrap: balance; margin-bottom: 20px;
}
h2 {
  font-size: clamp(1.6rem,3.5vw,2.6rem); font-weight: 700; line-height: 1.12;
  letter-spacing: -.02em; text-wrap: balance; margin-bottom: 16px;
}
p { color: var(--fg2); font-size: .9rem; max-width: 60ch; }

/* ── HERO ──────────────────────────────────────────────────────────────── */
#hero {
  min-height: 100vh;
  display: flex; align-items: center;
  background:
    radial-gradient(ellipse 70% 50% at 50% -10%, color-mix(in srgb, var(--red) 18%, transparent), transparent 65%),
    var(--bg);
  position: relative; overflow: hidden;
}
/* animated grid */
#hero-canvas {
  position: absolute; inset: 0; width: 100%; height: 100%;
  pointer-events: none; opacity: .35;
}
.hero-inner {
  max-width: 1000px; margin: 0 auto; position: relative; z-index: 1;
  padding: 0 max(28px, env(safe-area-inset-left,0px));
}
.hero-pill {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 10px; letter-spacing: .12em;
  text-transform: uppercase; color: var(--red);
  border: 1px solid color-mix(in srgb, var(--red) 35%, transparent);
  background: color-mix(in srgb, var(--red) 8%, transparent);
  padding: 5px 14px; border-radius: 100px; margin-bottom: 24px;
}
.pulse { width: 6px; height: 6px; border-radius: 50%; background: var(--red); animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.7)} }

.hero-title .red { color: var(--red); }
.hero-sub { font-size: 1rem; color: var(--fg2); max-width: 50ch; margin-bottom: 44px; font-weight: 300; }

/* stat strip */
.stat-strip {
  display: flex; gap: 1px; background: var(--border);
  border: 1px solid var(--border); border-radius: 10px;
  overflow: hidden; margin-bottom: 32px; flex-wrap: wrap;
}
.stat-cell {
  flex: 1 1 150px; background: var(--bg2); padding: 20px 22px;
  display: flex; flex-direction: column; gap: 4px;
}
.stat-num {
  font-size: 2.2rem; font-weight: 700; line-height: 1;
  font-variant-numeric: tabular-nums;
}
.stat-num.red    { color: var(--red); }
.stat-num.amber  { color: var(--amber); }
.stat-num.green  { color: var(--green); }
.stat-num.blue   { color: var(--blue); }
.stat-lbl {
  font-family: var(--mono); font-size: 9px; letter-spacing: .1em;
  text-transform: uppercase; color: var(--fg3);
}
.scroll-cue {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 10px; color: var(--fg3); letter-spacing: .08em;
}
.scroll-ring {
  width: 20px; height: 20px; border: 1px solid var(--border); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  animation: bob 2s ease-in-out infinite;
}
@keyframes bob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(4px)} }

/* ── PIPELINE VISUAL (approach section) ─────────────────────────────────── */
.pipeline {
  margin-top: 40px; display: flex; flex-direction: column; gap: 0;
}
.pl-step {
  display: grid; grid-template-columns: 60px 1fr; gap: 0;
  opacity: 0; transform: translateX(-16px);
  transition: opacity .5s ease, transform .5s ease;
}
.pl-step.visible { opacity: 1; transform: none; }
.pl-left {
  display: flex; flex-direction: column; align-items: center;
}
.pl-num {
  width: 44px; height: 44px; border-radius: 50%;
  border: 2px solid var(--red); background: var(--bg2);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--mono); font-size: 11px; font-weight: 600;
  color: var(--red); flex-shrink: 0; z-index: 1;
}
.pl-line {
  flex: 1; width: 2px; background: linear-gradient(var(--red-dk), var(--border));
  margin: 2px 0;
}
.pl-step:last-child .pl-line { display: none; }
.pl-body { padding: 8px 0 32px 20px; min-width: 0; }
.pl-tag {
  font-family: var(--mono); font-size: 9px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--red); margin-bottom: 3px;
}
.pl-title { font-size: 1rem; font-weight: 700; margin-bottom: 6px; }
.pl-text { font-size: .83rem; color: var(--fg2); line-height: 1.55; }

/* ── VISUAL: 4-system constellation ────────────────────────────────────── */
#constellation-wrap {
  margin-top: 32px; border: 1px solid var(--border);
  border-radius: 10px; overflow: hidden; background: var(--bg2);
}

/* ── CHIPS ─────────────────────────────────────────────────────────────── */
.chip {
  display: inline-block; font-family: var(--mono); font-size: 9px;
  font-weight: 600; padding: 2px 8px; border-radius: 100px; letter-spacing: .04em;
}
.chip-red    { background: color-mix(in srgb,var(--red)    15%,transparent); color: var(--red);    border: 1px solid color-mix(in srgb,var(--red)    30%,transparent); }
.chip-amber  { background: color-mix(in srgb,var(--amber)  15%,transparent); color: var(--amber);  border: 1px solid color-mix(in srgb,var(--amber)  30%,transparent); }
.chip-green  { background: color-mix(in srgb,var(--green)  15%,transparent); color: var(--green);  border: 1px solid color-mix(in srgb,var(--green)  30%,transparent); }
.chip-blue   { background: color-mix(in srgb,var(--blue)   15%,transparent); color: var(--blue);   border: 1px solid color-mix(in srgb,var(--blue)   30%,transparent); }
.chip-purple { background: color-mix(in srgb,var(--purple) 15%,transparent); color: var(--purple); border: 1px solid color-mix(in srgb,var(--purple) 30%,transparent); }

/* ── TECHNIQUE TABS ─────────────────────────────────────────────────────── */
.tab-row { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 14px; }
.tab-btn {
  background: var(--bg3); border: 1px solid var(--border);
  color: var(--fg2); font-family: var(--font); font-size: .78rem; font-weight: 500;
  padding: 6px 12px; border-radius: 6px; cursor: pointer; transition: all .12s;
}
.tab-btn:hover { color: var(--fg); }
.tab-btn.on { background: color-mix(in srgb,var(--red) 12%,var(--bg2)); border-color: var(--red); color: var(--red); }
.tab-panel { display: none; }
.tab-panel.on { display: block; }

/* ── CARDS ─────────────────────────────────────────────────────────────── */
.card {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 10px; padding: 22px;
}
.card + .card { margin-top: 10px; }
.card-row {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 10px; margin-top: 10px;
}
.card h3 { font-size: .9rem; font-weight: 600; margin-bottom: 8px; }
.card p { font-size: .82rem; }

/* code */
.codeblock {
  font-family: var(--mono); font-size: .75rem;
  background: var(--bg3); border: 1px solid var(--border);
  border-radius: 6px; padding: 12px 14px; margin-top: 10px;
  color: var(--blue); overflow-x: auto; white-space: pre; line-height: 1.6;
}

/* ── FINDING CARDS ─────────────────────────────────────────────────────── */
.finding-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 10px; margin-top: 28px;
}
.fc {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 10px; padding: 20px 18px; position: relative;
  overflow: hidden; transition: transform .18s, border-color .18s;
  display: flex; flex-direction: column; gap: 6px;
}
.fc::after {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
}
.fc-retain::after  { background: var(--green); }
.fc-redundant::after { background: var(--red); }
.fc-psf::after   { background: var(--amber); }
.fc-cco::after   { background: var(--purple); }
.fc-unclear::after { background: var(--fg3); }
.fc:hover { transform: translateY(-2px); border-color: var(--fg3); }
.fc-icon { font-size: 1.5rem; line-height: 1; }
.fc-name {
  font-size: .88rem; font-weight: 700; color: var(--fg); line-height: 1.2;
  /* no truncation — full text visible */
}
.fc-retain .fc-name  { color: var(--green); }
.fc-redundant .fc-name { color: var(--red); }
.fc-psf .fc-name   { color: var(--amber); }
.fc-cco .fc-name   { color: var(--purple); }
.fc-unclear .fc-name { color: var(--fg3); }
.fc-desc { font-size: .75rem; color: var(--fg2); line-height: 1.45; }

/* ── BIG NUMBERS ───────────────────────────────────────────────────────── */
.bn-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 1px; background: var(--border); border: 1px solid var(--border);
  border-radius: 10px; overflow: hidden; margin-top: 30px;
}
.bn-cell {
  background: var(--bg2); padding: 24px 20px;
  display: flex; flex-direction: column; gap: 5px;
}
.bn-num {
  font-size: 2.4rem; font-weight: 700; line-height: 1;
  font-variant-numeric: tabular-nums;
}
.bn-label { font-size: .78rem; font-weight: 600; color: var(--fg); }
.bn-sub { font-family: var(--mono); font-size: .68rem; color: var(--fg3); }

/* ── PROGRESS ───────────────────────────────────────────────────────────── */
.prog-list { display: flex; flex-direction: column; gap: 12px; margin-top: 6px; }
.prog-row { display: flex; flex-direction: column; gap: 4px; }
.prog-head { display: flex; justify-content: space-between; align-items: baseline; }
.prog-name { font-size: .78rem; font-weight: 500; color: var(--fg); }
.prog-pct { font-family: var(--mono); font-size: .72rem; color: var(--fg3); }
.prog-track { height: 7px; background: var(--bg3); border-radius: 100px; overflow: hidden; }
.prog-fill { height: 100%; border-radius: 100px; width: 0; transition: width 1.3s cubic-bezier(.4,0,.2,1); }

/* ── CHALLENGES ─────────────────────────────────────────────────────────── */
.ch-list { display: flex; flex-direction: column; gap: 8px; margin-top: 28px; }
.ch {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 10px; overflow: hidden; cursor: pointer;
}
.ch-hd {
  display: flex; align-items: center; gap: 12px;
  padding: 16px 18px; user-select: none;
}
.ch-icon {
  width: 30px; height: 30px; border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; flex-shrink: 0;
}
.ci-r { background: color-mix(in srgb,var(--red)    12%,transparent); }
.ci-a { background: color-mix(in srgb,var(--amber)  12%,transparent); }
.ci-b { background: color-mix(in srgb,var(--blue)   12%,transparent); }
.ci-p { background: color-mix(in srgb,var(--purple) 12%,transparent); }
.ci-g { background: color-mix(in srgb,var(--green)  12%,transparent); }
.ch-ttl { font-weight: 600; font-size: .88rem; flex: 1; }
.ch-caret { font-size: 11px; color: var(--fg3); transition: transform .2s; }
.ch.open .ch-caret { transform: rotate(180deg); }
.ch-body {
  display: none; padding: 0 18px 16px 60px;
  font-size: .82rem; color: var(--fg2); line-height: 1.6;
}
.ch.open .ch-body { display: block; }

/* ── NEXT STEPS ─────────────────────────────────────────────────────────── */
.horizon {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 14px; margin-top: 30px;
}
.hz {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 10px; padding: 22px;
  display: flex; flex-direction: column; gap: 8px;
}
.hz-n {
  font-size: 2.6rem; font-weight: 700; line-height: 1;
  color: var(--border); font-variant-numeric: tabular-nums;
}
.hz-title { font-weight: 700; font-size: .95rem; }
.hz-desc { font-size: .82rem; color: var(--fg2); line-height: 1.55; }
.hz-tag { margin-top: auto; }

/* ── FOOTER ─────────────────────────────────────────────────────────────── */
footer {
  padding: 24px max(28px, env(safe-area-inset-left,0px));
  background: var(--bg2); border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
}
footer span { font-family: var(--mono); font-size: 10px; color: var(--fg3); }

/* ── RESPONSIVE ─────────────────────────────────────────────────────────── */
@media (max-width: 600px) {
  section { padding-top: 80px; padding-bottom: 56px; }
  h1 { font-size: 1.9rem; }
  h2 { font-size: 1.5rem; }
  .stat-strip { flex-direction: column; }
  .bn-grid { grid-template-columns: 1fr 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
}
</style>

