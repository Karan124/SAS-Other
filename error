"""Phase 0b - API check with a synthetic record. No incident data is sent."""
import re, time
import yaml
from rl_config import (MODEL, MAX_COMPLETION_TOKENS, INPUT_PRICE_USD_PER_M,
                       OUTPUT_PRICE_USD_PER_M, load_prompt, get_client)

POP_N = 6157

SYNTH = """INC_ID: TEST000001
INC_DESC: Synthetic test record, not a real incident. A lender approved a personal loan after accepting the applicant's declared living expenses without checking them against bank statements. A later quality review found expenses were understated and the loan had been drawn.
INC_NAME: Synthetic test - expenses not verified
INC_INCDNT_CAUSE: blank
INC_PRD_LVL_1: blank
INC_PRD_LVL_2: Personal Loans
INC_BASE_EVNT_TYP_2: blank"""


def strip_fences(t):
    m = re.fullmatch(r"\s*```(?:yaml|yml)?\s*\n(.*?)\n\s*```\s*", t, flags=re.S)
    return (m.group(1), True) if m else (t, False)


def main():
    system, ver, sha = load_prompt("triage")
    print(f"Prompt {ver} sha256[:12]={sha} chars={len(system):,}")
    client, auth = get_client()
    print(f"Auth method: {auth} | model: {MODEL}")

    for effort in ["low", "medium"]:
        print(f"\n--- reasoning_effort={effort} ---")
        try:
            t0 = time.time()
            r = client.chat.completions.create(
                model=MODEL,
                messages=[{"role": "system", "content": system},
                          {"role": "user", "content": SYNTH}],
                reasoning_effort=effort,
                max_completion_tokens=MAX_COMPLETION_TOKENS,
            )
            dt = time.time() - t0
        except Exception as e:
            print(f"CALL FAILED: {type(e).__name__}: {str(e)[:400]}")
            continue

        u = r.usage
        det = getattr(u, "completion_tokens_details", None)
        rtok = getattr(det, "reasoning_tokens", None) if det else None
        cost = u.prompt_tokens / 1e6 * INPUT_PRICE_USD_PER_M + u.completion_tokens / 1e6 * OUTPUT_PRICE_USD_PER_M
        print(f"latency={dt:.1f}s finish={r.choices[0].finish_reason} "
              f"prompt_tok={u.prompt_tokens} completion_tok={u.completion_tokens} reasoning_tok={rtok}")
        print(f"cost/call=US${cost:.4f} | x{POP_N:,}: US${cost * POP_N:,.0f}, "
              f"sequential hours={dt * POP_N / 3600:.1f}")

        text = r.choices[0].message.content or ""
        print("RAW OUTPUT:\n" + text)
        body, fenced = strip_fences(text)
        try:
            d = yaml.safe_load(body)
            ok = isinstance(d, dict) and {"incident_id", "route", "markers", "other_pathways", "reason"} <= set(d)
            print(f"fenced={fenced} parsed_ok={ok} route={d.get('route') if isinstance(d, dict) else None}")
        except Exception as e:
            print(f"fenced={fenced} YAML PARSE FAILED: {e}")


if __name__ == "__main__":
    main()
