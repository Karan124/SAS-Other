<title>Payments Controls PoC</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">

<style>
/* ── WESTPAC BRAND TOKENS ─────────────────────────────────── */
:root {
  /* Westpac Group brand palette */
  --wb-red:      #DA2032;   /* Westpac Red */
  --wb-red-dk:   #A5192B;
  --wb-red-lt:   #F5B8BE;
  --wb-navy:     #002E5D;   /* Westpac Dark Navy */
  --wb-navy2:    #004B87;   /* Mid Navy */
  --wb-teal:     #00A99D;   /* Westpac Teal */
  --wb-teal-dk:  #007A73;
  --wb-gold:     #F5A623;   /* Westpac Gold / amber */
  --wb-green:    #2D9B4F;
  --wb-purple:   #6B4EA0;
  --wb-blue:     #0078D4;

  /* Page colours — dark navy theme */
  --bg:    #001A36;         /* deep navy */
  --bg2:   #002347;         /* card bg */
  --bg3:   #002E5D;         /* elevated */
  --border:#003D7A;
  --fg:    #EEF4FF;
  --fg2:   #A0B4CC;
  --fg3:   #5A7A99;

  color-scheme: dark;
  --font: 'Inter', sans-serif;
}

/* single-theme dark — no light flip */
body { background: var(--bg); color: var(--fg); }

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  font-family: var(--font);
}

/* ── DECK ───────────────────────────────────────────────────── */
#deck { width: 100%; height: 100%; position: relative; }

.slide {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  padding: max(32px, env(safe-area-inset-left,0px));
  opacity: 0; pointer-events: none;
  transition: opacity .45s ease, transform .45s ease;
  transform: translateY(28px);
  overflow: hidden;
}
.slide.active  { opacity: 1; pointer-events: all; transform: none; }
.slide.exit-up   { opacity: 0; transform: translateY(-28px); }
.slide.exit-down { opacity: 0; transform: translateY(28px); }

/* ── NAV ───────────────────────────────────────────────────── */
#nav {
  position: fixed; bottom: max(28px, env(safe-area-inset-bottom,0px));
  left: 50%; transform: translateX(-50%);
  display: flex; align-items: center; gap: 10px; z-index: 200;
  background: color-mix(in srgb, var(--bg3) 92%, transparent);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: 100px; padding: 8px 18px;
}
.dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--border); cursor: pointer;
  transition: background .2s, transform .2s;
}
.dot.on { background: var(--wb-red); transform: scale(1.35); }
.nav-arr {
  background: none; border: none; color: var(--fg3);
  font-size: 15px; cursor: pointer; padding: 2px 5px;
  transition: color .15s;
}
.nav-arr:hover { color: var(--fg); }

/* ── SHARED INNER ───────────────────────────────────────────── */
.inner { max-width: 920px; width: 100%; }

.eyebrow {
  font-size: 11px; font-weight: 600; letter-spacing: .18em;
  text-transform: uppercase; color: var(--wb-teal);
  display: flex; align-items: center; gap: 10px; margin-bottom: 18px;
}
.eyebrow::before { content:''; width: 22px; height: 2px; background: var(--wb-teal); flex-shrink:0; }

h1 {
  font-size: clamp(2.6rem, 6vw, 4.6rem);
  font-weight: 900; line-height: 1.06; letter-spacing: -.03em;
  text-wrap: balance;
}
h2 {
  font-size: clamp(1.7rem, 3.8vw, 2.8rem);
  font-weight: 800; line-height: 1.1; letter-spacing: -.025em;
  text-wrap: balance;
}
.sub {
  font-size: clamp(.95rem, 2vw, 1.1rem);
  color: var(--fg2); font-weight: 300; line-height: 1.65;
  max-width: 56ch; margin-top: 14px;
}

/* chips */
.chip {
  font-size: 10px; font-weight: 600; padding: 3px 10px;
  border-radius: 100px; letter-spacing: .04em; white-space: nowrap;
}
.chip-teal   { background: color-mix(in srgb,var(--wb-teal)   14%,transparent); color: var(--wb-teal);   border: 1px solid color-mix(in srgb,var(--wb-teal)   28%,transparent); }
.chip-red    { background: color-mix(in srgb,var(--wb-red)    14%,transparent); color: var(--wb-red);    border: 1px solid color-mix(in srgb,var(--wb-red)    28%,transparent); }
.chip-gold   { background: color-mix(in srgb,var(--wb-gold)   14%,transparent); color: var(--wb-gold);   border: 1px solid color-mix(in srgb,var(--wb-gold)   28%,transparent); }
.chip-green  { background: color-mix(in srgb,var(--wb-green)  14%,transparent); color: var(--wb-green);  border: 1px solid color-mix(in srgb,var(--wb-green)  28%,transparent); }
.chip-purple { background: color-mix(in srgb,var(--wb-purple) 14%,transparent); color: var(--wb-purple); border: 1px solid color-mix(in srgb,var(--wb-purple) 28%,transparent); }
.chip-navy   { background: color-mix(in srgb,var(--wb-blue)   14%,transparent); color: var(--wb-blue);   border: 1px solid color-mix(in srgb,var(--wb-blue)   28%,transparent); }

/* callout cards */
.co {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 10px; padding: 16px 20px;
  display: flex; gap: 12px; align-items: flex-start; flex: 1 1 220px;
}
.co-icon { font-size: 1.3rem; flex-shrink: 0; margin-top: 2px; }
.co-text { font-size: .88rem; color: var(--fg2); line-height: 1.55; }
.co-text strong { color: var(--fg); display: block; margin-bottom: 3px; font-size: .92rem; }

/* ═══════════════════════════════════════════════════════════
   SLIDE 1 — TITLE
═══════════════════════════════════════════════════════════ */
#s1 {
  background:
    radial-gradient(ellipse 70% 60% at 50% -10%, color-mix(in srgb,var(--wb-navy2) 60%,transparent), transparent 65%),
    var(--bg);
}
#s1 canvas {
  position:absolute; inset:0; width:100%; height:100%;
  pointer-events:none; opacity:.5;
}
#s1 .inner { position:relative; z-index:1; }
.hero-stat {
  font-size: clamp(5rem, 15vw, 12rem); font-weight: 900;
  line-height: .9; letter-spacing: -.04em; color: var(--wb-navy2);
  opacity: .22; position: absolute; right: -1vw; top: 50%;
  transform: translateY(-50%); pointer-events: none; user-select: none;
}
.tag-pill {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 11px; font-weight: 600; letter-spacing: .12em;
  text-transform: uppercase; color: var(--wb-teal);
  border: 1px solid color-mix(in srgb,var(--wb-teal) 35%,transparent);
  background: color-mix(in srgb,var(--wb-teal) 8%,transparent);
  padding: 6px 16px; border-radius: 100px; margin-bottom: 24px;
  width: fit-content;
}
.pulse { width:6px; height:6px; border-radius:50%; background:var(--wb-teal); animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.7)} }

/* ═══════════════════════════════════════════════════════════
   SLIDE 2 — DATA SOURCES
═══════════════════════════════════════════════════════════ */
.sys-diagram {
  display: flex; align-items: center; justify-content: center;
  gap: 0; margin-top: 32px; flex-wrap: wrap;
}
.sys-node {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 14px; padding: 22px 26px; text-align: center;
  min-width: 150px;
}
.sys-node .sn-name { font-size: 1rem; font-weight: 800; margin-bottom: 6px; }
.sys-node .sn-sub { font-size: .76rem; color: var(--fg3); line-height: 1.5; }
.sys-connector {
  display: flex; flex-direction: column; align-items: center;
  padding: 0 12px; gap: 5px;
}
.sc-line {
  width: 44px; height: 2px; background: var(--border); position: relative;
}
.sc-line.ok::after {
  content: ''; position: absolute; inset: 0; background: var(--wb-teal);
  transform-origin: left; animation: grow .9s .5s forwards ease-out; transform: scaleX(0);
}
@keyframes grow { to { transform: scaleX(1); } }
.sc-label { font-size: 9px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
.sc-label.ok { color: var(--wb-teal); }

/* ═══════════════════════════════════════════════════════════
   SLIDE 3 — PIPELINE (animated)
═══════════════════════════════════════════════════════════ */
.pipeline-row {
  display: flex; align-items: flex-start; gap: 0;
  margin-top: 36px; flex-wrap: nowrap;
  overflow-x: auto; padding-bottom: 4px;
}
.pv-node {
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  flex: 0 0 auto;
  opacity: 0; transform: translateY(16px);
  transition: opacity .4s ease, transform .4s ease;
  min-width: 120px; padding: 0 6px;
}
.pv-node.lit { opacity: 1; transform: none; }
.pv-circle {
  width: 72px; height: 72px; border-radius: 50%;
  border: 2px solid var(--border); background: var(--bg2);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.7rem; transition: border-color .4s, background .4s, box-shadow .4s;
  flex-shrink: 0;
}
.pv-node.lit .pv-circle {
  border-color: var(--wb-teal);
  background: color-mix(in srgb,var(--wb-teal) 10%,var(--bg2));
  box-shadow: 0 0 24px color-mix(in srgb,var(--wb-teal) 25%,transparent);
}
.pv-label {
  font-size: .82rem; font-weight: 600; color: var(--fg3);
  text-align: center; max-width: 100px; line-height: 1.3;
}
.pv-node.lit .pv-label { color: var(--fg); }
.pv-desc {
  font-size: .72rem; color: var(--fg3); text-align: center;
  max-width: 100px; line-height: 1.4; margin-top: -4px;
}
.pv-node.lit .pv-desc { color: var(--fg2); }
.pv-arrow {
  font-size: 20px; color: var(--border); padding: 0 2px;
  margin-top: 24px; flex-shrink: 0;
  transition: color .4s;
}
.pv-arrow.lit { color: var(--wb-teal); }

/* ═══════════════════════════════════════════════════════════
   SLIDE 4 — EMBEDDING ANIMATION
═══════════════════════════════════════════════════════════ */
#s4 { align-items: flex-start; padding-top: max(48px, 5vh); }
.embed-layout {
  display: flex; gap: 24px; margin-top: 28px; align-items: flex-start;
  flex-wrap: wrap;
}
.embed-col { flex: 1 1 220px; }
.embed-col-title {
  font-size: .78rem; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: var(--fg3); margin-bottom: 12px;
}
.ctrl-card {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 10px; padding: 14px 16px; margin-bottom: 10px;
  cursor: pointer; transition: border-color .25s, box-shadow .25s;
  position: relative;
}
.ctrl-card.selected {
  border-color: var(--wb-teal);
  box-shadow: 0 0 20px color-mix(in srgb,var(--wb-teal) 20%,transparent);
}
.ctrl-card.matched {
  border-color: var(--wb-purple);
  box-shadow: 0 0 20px color-mix(in srgb,var(--wb-purple) 20%,transparent);
}
.cc-id { font-size: 9px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--fg3); margin-bottom: 4px; }
.cc-name { font-size: .88rem; font-weight: 700; line-height: 1.3; margin-bottom: 6px; }
.cc-desc { font-size: .75rem; color: var(--fg2); line-height: 1.45; }

.sim-panel {
  flex: 0 0 220px; display: flex; flex-direction: column; gap: 10px;
}
.sim-box {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 10px; padding: 14px 16px;
}
.sim-label { font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--fg3); margin-bottom: 10px; }
.sim-vec {
  display: flex; gap: 3px; flex-wrap: wrap; margin-bottom: 10px;
}
.sim-dim {
  width: 10px; height: 20px; border-radius: 2px;
  background: var(--border); transition: background .3s, height .3s;
  flex-shrink: 0;
}
.sim-score-row {
  display: flex; align-items: center; gap: 8px; padding: 8px 0;
  border-top: 1px solid var(--border);
}
.sim-name { font-size: .78rem; font-weight: 600; flex: 1; color: var(--fg2); }
.sim-bar-wrap { flex: 1; height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; }
.sim-bar { height: 100%; width: 0%; border-radius: 4px; transition: width 1.2s ease; }
.sim-bar.high { background: var(--wb-teal); }
.sim-bar.mid  { background: var(--wb-gold); }
.sim-bar.low  { background: var(--fg3); }
.sim-pct { font-size: .82rem; font-weight: 700; min-width: 36px; text-align: right; }
.sim-pct.high { color: var(--wb-teal); }
.sim-pct.mid  { color: var(--wb-gold); }
.sim-pct.low  { color: var(--fg3); }

.embed-explain {
  font-size: .78rem; color: var(--fg2); line-height: 1.55;
  background: color-mix(in srgb,var(--wb-navy) 60%,transparent);
  border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px;
}

/* ═══════════════════════════════════════════════════════════
   SLIDE 5 — CT CLASSIFICATION
═══════════════════════════════════════════════════════════ */
#s5 { align-items: flex-start; padding-top: max(48px, 5vh); }
.ct-layout { display: flex; gap: 20px; margin-top: 28px; align-items: flex-start; flex-wrap: wrap; }
.ct-left { flex: 1 1 240px; }
.ct-right { flex: 2 1 360px; }

.ct-ctrl {
  background: var(--bg2); border: 1px solid var(--wb-teal);
  box-shadow: 0 0 24px color-mix(in srgb,var(--wb-teal) 15%,transparent);
  border-radius: 10px; padding: 16px 18px; margin-bottom: 14px;
}
.ct-ctrl .cc-id { color: var(--wb-teal); }

.ct-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 6px;
}
.ct-cell {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 7px; padding: 8px 6px;
  font-size: .72rem; font-weight: 600; text-align: center;
  color: var(--fg3); transition: all .35s ease;
  cursor: default;
}
.ct-cell.active {
  background: color-mix(in srgb,var(--wb-purple) 15%,var(--bg2));
  border-color: var(--wb-purple);
  color: var(--wb-purple);
  box-shadow: 0 0 12px color-mix(in srgb,var(--wb-purple) 20%,transparent);
}
.ct-cell.scanning {
  background: color-mix(in srgb,var(--wb-gold) 10%,var(--bg2));
  border-color: var(--wb-gold);
  color: var(--wb-gold);
}

.llm-box {
  margin-top: 14px;
  background: color-mix(in srgb,var(--wb-navy) 60%,transparent);
  border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px;
  font-size: .82rem; color: var(--fg2); line-height: 1.6;
  min-height: 60px;
}
.llm-box .verdict {
  color: var(--wb-purple); font-weight: 700; margin-top: 6px;
  font-size: .88rem;
}

/* ═══════════════════════════════════════════════════════════
   SLIDE 6 — PROCESS LIFECYCLE ANIMATION
═══════════════════════════════════════════════════════════ */
#s6 { align-items: flex-start; padding-top: max(48px, 5vh); }
.lc-layout { display: flex; gap: 20px; margin-top: 28px; align-items: flex-start; flex-wrap: wrap; }
.lc-left { flex: 1 1 240px; }
.lc-right { flex: 2 1 360px; }

.lc-process {
  background: var(--bg2); border: 1px solid var(--wb-gold);
  box-shadow: 0 0 20px color-mix(in srgb,var(--wb-gold) 15%,transparent);
  border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;
}
.lc-process .lp-id { font-size: 9px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--wb-gold); margin-bottom: 4px; }
.lc-process .lp-name { font-size: .88rem; font-weight: 700; line-height: 1.3; margin-bottom: 4px; }
.lc-process .lp-src { font-size: .72rem; color: var(--fg3); }

.lc-stages {
  display: flex; flex-direction: column; gap: 7px;
}
.lc-stage {
  display: flex; align-items: center; gap: 10px;
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 8px; padding: 10px 14px;
  transition: all .4s ease;
}
.lc-stage.active {
  border-color: var(--wb-gold);
  background: color-mix(in srgb,var(--wb-gold) 8%,var(--bg2));
}
.lc-stage-num {
  font-size: .68rem; font-weight: 800; letter-spacing: .1em;
  text-transform: uppercase; color: var(--fg3); min-width: 24px;
  transition: color .4s;
}
.lc-stage.active .lc-stage-num { color: var(--wb-gold); }
.lc-stage-name {
  font-size: .84rem; font-weight: 600; color: var(--fg3);
  transition: color .4s;
}
.lc-stage.active .lc-stage-name { color: var(--fg); }
.lc-stage-cat {
  margin-left: auto; font-size: .72rem; font-weight: 600;
  color: var(--fg3); transition: color .4s;
}
.lc-stage.active .lc-stage-cat { color: var(--wb-gold); }

.lc-explain {
  margin-top: 12px;
  font-size: .78rem; color: var(--fg2); line-height: 1.55;
  background: color-mix(in srgb,var(--wb-navy) 60%,transparent);
  border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px;
}

/* ═══════════════════════════════════════════════════════════
   SLIDE 7 — EXAMPLES (CCO)
═══════════════════════════════════════════════════════════ */
.ex-controls {
  display: flex; gap: 10px; align-items: stretch; flex-wrap: wrap;
  margin-top: 24px;
}
.ex-ctrl {
  flex: 1 1 220px; background: var(--bg2);
  border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px;
}
.ec-id { font-size: 9px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--fg3); margin-bottom: 6px; }
.ec-name { font-size: .92rem; font-weight: 700; line-height: 1.3; margin-bottom: 8px; }
.ec-obj { font-size: .8rem; color: var(--fg2); line-height: 1.5; }
.ec-tags { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 10px; }

.finding-box {
  background: var(--bg2); border-radius: 10px; padding: 18px 22px; margin-top: 14px;
}
.finding-box.cco { border: 1px solid color-mix(in srgb,var(--wb-purple) 45%,var(--border)); }
.finding-box.psf { border: 1px solid color-mix(in srgb,var(--wb-gold)   45%,var(--border)); }
.fb-eyebrow { font-size: 9px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 6px; }
.cco .fb-eyebrow { color: var(--wb-purple); }
.psf .fb-eyebrow { color: var(--wb-gold); }
.fb-title { font-size: 1rem; font-weight: 700; margin-bottom: 6px; }
.fb-reason { font-size: .84rem; color: var(--fg2); line-height: 1.6; }

/* ═══════════════════════════════════════════════════════════
   SLIDE 8 — EXAMPLES (PSF)
═══════════════════════════════════════════════════════════ */
.psf-flow {
  display: flex; align-items: stretch; gap: 0;
  margin-top: 20px; border: 1px solid var(--border);
  border-radius: 10px; overflow: hidden;
}
.psf-step {
  flex: 1; padding: 18px 16px; background: var(--bg2);
}
.psf-step + .psf-step { border-left: 1px solid var(--border); }
.psf-step .ps-num { font-size: .7rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--wb-gold); margin-bottom: 6px; }
.psf-step .ps-name { font-size: .9rem; font-weight: 700; line-height: 1.3; margin-bottom: 6px; }
.psf-step .ps-id { font-size: .7rem; color: var(--fg3); margin-bottom: 8px; }
.psf-step .ps-desc { font-size: .77rem; color: var(--fg2); line-height: 1.5; }

.psf-split-label {
  display: flex; align-items: center; gap: 8px; margin: 14px 0;
}
.psf-line { flex:1; height:1px; background: color-mix(in srgb,var(--wb-gold) 30%,var(--border)); }
.psf-split-text { font-size: 9px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--wb-gold); white-space: nowrap; }

/* ═══════════════════════════════════════════════════════════
   SLIDE 9 — OUTCOMES FUNNEL
═══════════════════════════════════════════════════════════ */
.funnel-wrap {
  margin-top: 30px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; width: 100%;
}
.funnel-row {
  display: flex; align-items: center; gap: 0; width: 100%; max-width: 680px;
  opacity: 0; transform: translateY(12px);
  transition: opacity .5s ease, transform .5s ease;
}
.funnel-row.lit { opacity: 1; transform: none; }
.fr-bar {
  height: 60px; border-radius: 8px; display: flex; align-items: center;
  padding: 0 20px; gap: 14px; overflow: hidden; position: relative;
  border: 1px solid var(--border);
}
.fr-bar::before {
  content: ''; position: absolute; inset: 0;
  transform-origin: left; transform: scaleX(0);
  transition: transform 1s .3s cubic-bezier(.4,0,.2,1);
  border-radius: 7px;
}
.funnel-row.lit .fr-bar::before { transform: scaleX(1); }
.fr-bar.total  { width: 100%;  border-color: color-mix(in srgb,var(--wb-red)    35%,var(--border)); }
.fr-bar.scope  { width: 82%;   border-color: color-mix(in srgb,var(--wb-blue)   35%,var(--border)); }
.fr-bar.data   { width: 65%;   border-color: color-mix(in srgb,var(--wb-gold)   35%,var(--border)); }
.fr-bar.result { width: 50%;   border-color: color-mix(in srgb,var(--wb-teal)   35%,var(--border)); }
.fr-bar.total::before  { background: color-mix(in srgb,var(--wb-red)  18%,transparent); }
.fr-bar.scope::before  { background: color-mix(in srgb,var(--wb-blue) 18%,transparent); }
