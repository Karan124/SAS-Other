"""
02_generate_embeddings_ct.py
─────────────────────────────────────────────────────────────────────────────
Control Rationalisation — Step 2 of 4 (Dimension 2: Gold Controls)

Generates embeddings for all 708 controls and builds candidate pairs
within each CT group scope.

Note: attempts to reuse embeddings from Dimension 1 cache
(control_embeddings.parquet in the product output folder) where the same
Control_ID exists. Only generates new embeddings for controls not already
cached, saving time and API cost.

Before running:
  az account set --subscription 6c72e6c5-ed48-4030-b29c-34e2849c9288
  python 02_generate_embeddings_ct.py
  python 02_generate_embeddings_ct.py --force
"""

import argparse
import json
import logging
import sys
import time
from datetime import datetime
from pathlib import Path

import httpx
import numpy as np
import pandas as pd
from azure.identity import DefaultAzureCredential, get_bearer_token_provider
from openai import AzureOpenAI

# ─────────────────────────────────────────────────────────────────────────────
#  CONFIG
# ─────────────────────────────────────────────────────────────────────────────

OUTPUT_DIR      = Path(r"C:\Users\M061400\ai-test\big_table\duplicates\ct")
DIM1_OUTPUT_DIR = Path(r"C:\Users\M061400\ai-test\big_table\duplicates\product\output")

AZURE_ENDPOINT  = "https://ai.eng.azure.srv.westpac.com.au"
API_VERSION     = "2024-10-21"
EMBEDDING_MODEL = "text-embedding-3-large"
EMBEDDING_DIM   = 3072
PROXY_URL       = "http://127.0.0.1:9000"
CA_BUNDLE       = r"C:\Users\m061400\ai-test\cacert.pem"

EMBED_BATCH  = 20
EMBED_SLEEP  = 2.0

EXPANDED_PARQUET   = OUTPUT_DIR / "expanded_ct_control_mapping.parquet"
EMBEDDINGS_PARQUET = OUTPUT_DIR / "control_embeddings_ct.parquet"
CAND_CT_PARQUET    = OUTPUT_DIR / "candidate_pairs_ct.parquet"
SCOPE_CT_PARQUET   = OUTPUT_DIR / "scope_summary_ct.parquet"
RUN_CONFIG         = OUTPUT_DIR / "run_config_ct.json"

# Dimension 1 embeddings cache (reuse where possible)
DIM1_EMBEDDINGS    = DIM1_OUTPUT_DIR / "control_embeddings.parquet"

# ─────────────────────────────────────────────────────────────────────────────
#  LOGGING
# ─────────────────────────────────────────────────────────────────────────────

def get_logger():
    logger = logging.getLogger("ctrl_rat_ct2")
    if logger.handlers:
        return logger
    fh = logging.FileHandler(OUTPUT_DIR / "processing_log_ct.txt",
                             encoding="utf-8")
    ch = logging.StreamHandler(sys.stdout)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s",
                            datefmt="%Y-%m-%d %H:%M:%S")
    fh.setFormatter(fmt); ch.setFormatter(fmt)
    fh.setLevel(logging.DEBUG); ch.setLevel(logging.INFO)
    logger.addHandler(fh); logger.addHandler(ch)
    logger.setLevel(logging.DEBUG)
    return logger

# ─────────────────────────────────────────────────────────────────────────────
#  CLIENT
# ─────────────────────────────────────────────────────────────────────────────

def make_embed_client():
    token_provider = get_bearer_token_provider(
        DefaultAzureCredential(),
        "https://cognitiveservices.azure.com/.default"
    )
    return AzureOpenAI(
        azure_endpoint=AZURE_ENDPOINT,
        api_version=API_VERSION,
        azure_ad_token_provider=token_provider,
        http_client=httpx.Client(
            proxy=PROXY_URL,
            verify=CA_BUNDLE,
            timeout=httpx.Timeout(120.0, connect=30.0),
            limits=httpx.Limits(
                max_keepalive_connections=0, max_connections=1),
        ),
    )

# ─────────────────────────────────────────────────────────────────────────────
#  EMBEDDINGS
# ─────────────────────────────────────────────────────────────────────────────

def generate_embeddings(texts, log):
    client = make_embed_client()
    all_embs = []
    total = len(texts)
    log.info(f"  Embedding {total:,} controls in batches of {EMBED_BATCH}...")
    for i in range(0, total, EMBED_BATCH):
        batch = [t[:24000] for t in texts[i:i+EMBED_BATCH]]
        for attempt in range(4):
            try:
                resp = client.embeddings.create(
                    model=EMBEDDING_MODEL, input=batch)
                all_embs.extend([d.embedding for d in resp.data])
                print(f"\r  {min(i+EMBED_BATCH,total):,}/{total:,}", end="")
                time.sleep(EMBED_SLEEP)
                break
            except Exception as e:
                if attempt == 3:
                    raise
                wait = min(5 * 2**attempt, 60)
                log.warning(f"  Batch {i//EMBED_BATCH+1} attempt {attempt+1}: "
                            f"{e}. Wait {wait}s...")
                time.sleep(wait)
    print(f"\r  {total:,}/{total:,} done        ")
    return np.array(all_embs, dtype=np.float32)


def load_or_generate_embeddings(df, force, log):
    """
    Load cached embeddings where available, generate only what's new.
    Tries Dimension 1 cache first, then local Dimension 2 cache.
    """
    if EMBEDDINGS_PARQUET.exists() and not force:
        log.info(f"Loading cached embeddings: {EMBEDDINGS_PARQUET.name}")
        emb_df = pd.read_parquet(EMBEDDINGS_PARQUET, engine="pyarrow")
        log.info(f"  {len(emb_df):,} embeddings loaded")
        return emb_df

    unique = (df[["Control_ID","embedding_text"]]
              .drop_duplicates(subset=["Control_ID"])
              .reset_index(drop=True))
    log.info(f"Preparing embeddings for {len(unique):,} unique controls...")

    # Try to reuse Dimension 1 embeddings
    cached = {}
    if DIM1_EMBEDDINGS.exists():
        dim1 = pd.read_parquet(DIM1_EMBEDDINGS, engine="pyarrow")
        cached = {row["Control_ID"]: row["embedding"]
                  for _, row in dim1.iterrows()}
        log.info(f"  Dimension 1 cache available: {len(cached):,} embeddings")

    need_new = unique[~unique["Control_ID"].isin(cached)]
    log.info(f"  Already cached  : {len(unique)-len(need_new):,}")
    log.info(f"  Need generation : {len(need_new):,}")

    new_embs = {}
    if len(need_new) > 0:
        texts = need_new["embedding_text"].tolist()
        embs  = generate_embeddings(texts, log)
        for cid, emb in zip(need_new["Control_ID"].tolist(), embs):
            new_embs[cid] = emb.tolist()

    # Combine
    all_embs = []
    for _, row in unique.iterrows():
        cid = row["Control_ID"]
        if cid in new_embs:
            all_embs.append({"Control_ID": cid, "embedding": new_embs[cid]})
        elif cid in cached:
            emb = cached[cid]
            all_embs.append({"Control_ID": cid,
                              "embedding": emb if isinstance(emb, list)
                              else emb.tolist()})

    emb_df = pd.DataFrame(all_embs)
    emb_df.to_parquet(EMBEDDINGS_PARQUET, index=False, engine="pyarrow")
    log.info(f"Embeddings saved: {EMBEDDINGS_PARQUET.name} ({len(emb_df):,} rows)")
    return emb_df

# ─────────────────────────────────────────────────────────────────────────────
#  COSINE SIMILARITY + BATCH ASSIGNMENT
# ─────────────────────────────────────────────────────────────────────────────

def cosine_sim(embs):
    norms  = np.linalg.norm(embs, axis=1, keepdims=True) + 1e-9
    normed = embs / norms
    return (normed @ normed.T).astype(np.float32)


def assign_batches(ctrl_ids, sim_mat, threshold, max_per_batch):
    n = len(ctrl_ids)
    neighbours = {
        i: sorted(range(n), key=lambda j: -sim_mat[i][j])
        for i in range(n)
    }
    assigned   = {}
    unassigned = set(range(n))
    batch_id   = 0

    while unassigned:
        def degree(i):
            return sum(1 for j in neighbours[i]
                       if j in unassigned and sim_mat[i][j] >= threshold)
        seed  = max(unassigned, key=degree)
        batch = [seed]
        unassigned.discard(seed)
        for j in neighbours[seed]:
            if len(batch) >= max_per_batch:
                break
            if j in unassigned:
                batch.append(j)
                unassigned.discard(j)
        for idx in batch:
            assigned[ctrl_ids[idx]] = batch_id
        batch_id += 1

    return assigned

# ─────────────────────────────────────────────────────────────────────────────
#  BUILD CANDIDATE PAIRS
# ─────────────────────────────────────────────────────────────────────────────

def build_candidates(df, emb_lookup, threshold, max_per_batch, log):
    all_pairs  = []
    all_scopes = []
    n_large = n_small = n_single = 0

    scopes = df.groupby("scope_id")
    log.info(f"  Building candidates for {len(scopes):,} CT scopes...")

    for scope_id, grp in scopes:
        ctrl_ids = grp["Control_ID"].unique().tolist()
        n        = len(ctrl_ids)

        if n < 2:
            n_single += 1
            all_scopes.append({
                "scope_id":    scope_id,
                "ct_ref":      scope_id.replace("CT|",""),
                "n_controls":  n,
                "send_all":    True,
                "n_batches":   1,
                "skip_reason": "single_control",
            })
            continue

        embs = np.array([
            emb_lookup.get(cid, np.zeros(EMBEDDING_DIM, dtype=np.float32))
            for cid in ctrl_ids
        ], dtype=np.float32)
        sim      = cosine_sim(embs)
        send_all = (n <= max_per_batch)

        if send_all:
            n_small += 1
            batch_map = {cid: 0 for cid in ctrl_ids}
        else:
            n_large += 1
            batch_map = assign_batches(ctrl_ids, sim, threshold, max_per_batch)
            log.info(f"    Large scope: {scope_id} "
                     f"({n} controls, {max(batch_map.values())+1} batches)")

        # Save ALL pairs (ensures no control is excluded)
        for i in range(n):
            for j in range(i+1, n):
                sim_val = float(sim[i, j])
                all_pairs.append({
                    "scope_id":         scope_id,
                    "control_id_a":     ctrl_ids[i],
                    "control_id_b":     ctrl_ids[j],
                    "cosine_similarity":sim_val,
                    "above_threshold":  sim_val >= threshold,
                    "batch_id":         batch_map.get(ctrl_ids[i], 0),
                    "send_all":         send_all,
                })

        all_scopes.append({
            "scope_id":    scope_id,
            "ct_ref":      scope_id.replace("CT|",""),
            "n_controls":  n,
            "send_all":    send_all,
            "n_batches":   max(batch_map.values()) + 1,
            "skip_reason": "",
        })

    log.info(f"  Small scopes (send_all): {n_small:,} | "
             f"Large (batched): {n_large:,} | Single: {n_single:,}")
    return pd.DataFrame(all_pairs), pd.DataFrame(all_scopes)

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN
# ─────────────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true",
                        help="Regenerate embeddings and candidates.")
    args = parser.parse_args()

    log = get_logger()
    log.info("=" * 70)
    log.info("  Control Rationalisation — Step 2 (Dimension 2: Gold Controls)")
    log.info(f"  Started: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log.info("=" * 70)

    if not EXPANDED_PARQUET.exists():
        log.error("expanded_ct_control_mapping.parquet not found. "
                  "Run Script 1 first.")
        sys.exit(1)
    if not RUN_CONFIG.exists():
        log.error("run_config_ct.json not found. Run Script 1 first.")
        sys.exit(1)

    outputs_exist = all(p.exists() for p in
                        [EMBEDDINGS_PARQUET, CAND_CT_PARQUET, SCOPE_CT_PARQUET])
    if outputs_exist and not args.force:
        log.info("All outputs exist. Use --force to regenerate.")
        return

    with open(RUN_CONFIG) as f:
        config = json.load(f)
    threshold     = config.get("similarity_threshold", 0.58)
    max_per_batch = config.get("max_controls_per_llm_call", 20)

    log.info("Loading expanded dataset...")
    df = pd.read_parquet(EXPANDED_PARQUET, engine="pyarrow")
    log.info(f"  {len(df):,} rows | {df['scope_id'].nunique():,} scopes | "
             f"{df['Control_ID'].nunique():,} unique controls")

    # Embeddings
    emb_df = load_or_generate_embeddings(df, args.force, log)
    emb_lookup = {
        row["Control_ID"]: np.array(row["embedding"], dtype=np.float32)
        for _, row in emb_df.iterrows()
    }
    log.info(f"Embedding lookup: {len(emb_lookup):,} controls")

    # Candidate pairs
    log.info("\nBuilding candidate pairs...")
    pairs_df, scope_df = build_candidates(
        df, emb_lookup, threshold, max_per_batch, log)

    pairs_df.to_parquet(CAND_CT_PARQUET,  index=False, engine="pyarrow")
    scope_df.to_parquet(SCOPE_CT_PARQUET, index=False, engine="pyarrow")
    log.info(f"  Candidate pairs : {len(pairs_df):,}")
    log.info(f"  Scope summary   : {len(scope_df):,} CT groups")

    config["step2_completed_at"] = datetime.now().isoformat()
    config["n_pairs"]  = len(pairs_df)
    config["n_scopes"] = int(scope_df["scope_id"].nunique())
    with open(RUN_CONFIG, "w") as f:
        json.dump(config, f, indent=2)

    log.info("=" * 70)
    log.info("  Step 2 complete. Run 03_run_llm_ct.py next.")
    log.info("=" * 70)

if __name__ == "__main__":
    main()
