def load_checkpoint(path: Path) -> set[str]:
    """Return set of already-processed 'scope_id::batch_id' keys."""
    done = set()
    if not path.exists():
        return done
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
                key = f"{rec['scope_id']}::{rec['batch_id']}"
                done.add(key)
            except (json.JSONDecodeError, KeyError):
                continue
    return done


def write_checkpoint(rec: dict, path: Path) -> None:
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=True) + "\n")

