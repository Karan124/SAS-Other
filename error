"""
STEP 2: Embed controls (four text variants) and processes, cache to parquet.

Uses the same client pattern as the rest of the project (DefaultAzureCredential,
proxy, CA bundle, text-embedding-3-large at 3072 dims).

Text is cleaned before embedding: HTML tags and URLs removed, control IDs removed
(604 detailed descriptions cite other control IDs; leaving them in would let any
text method recover master/instance families through the ID rather than the meaning).

Variants (fields concatenated in this order, blank fields skipped):
  name               CTRL_NAME
  name_desc          CTRL_NAME + CTRL_DESC
  name_desc_detail   CTRL_NAME + CTRL_DESC + CTRL_DESC_OF_CTRL
  all_text           + CTRL_EVDNCD + CTRL_MNTRD

Resumable: each variant is checkpointed every 25 batches to a .partial.parquet and
skipped entirely once its final parquet exists. Safe to rerun after a proxy drop.

Before running:
  az login
  az account set --subscription 6c72e6c5-ed48-4030-b29c-34e2849c9288
  $env:REQUESTS_CA_BUNDLE="C:\\Users\\m061400\\ai-test\\cacert.pem"
  $env:SSL_CERT_FILE="C:\\Users\\m061400\\ai-test\\cacert.pem"

Run:
  python 02_embed.py --dry-run          # build texts, print token estimate, no API calls
  python 02_embed.py                    # embed everything (about an hour)
  python 02_embed.py --variants name_desc_detail --skip-processes   # subset

Output:
  experiments\\output\\embeddings\\controls_<variant>.parquet   columns: CTRL_ID, text, vector
  experiments\\output\\embeddings\\processes.parquet            columns: uuid, text, vector
  experiments\\output\\embeddings\\manifest.json
"""
import argparse
import html
import json
import re
import sys
import time
from datetime import datetime
from pathlib import Path

import numpy as np
import pandas as pd

# ---------------------------------------------------------------- config
DATA_DIR = Path(r"C:\Users\M061400\ai-test\experiments\data")
OUT_DIR = Path(r"C:\Users\M061400\ai-test\experiments\output\embeddings")
OUT_DIR.mkdir(parents=True, exist_ok=True)

AZURE_ENDPOINT = "https://ai.eng.azure.srv.westpac.com.au"
API_VERSION = "2024-10-21"
EMBEDDING_MODEL = "text-embedding-3-large"
EMBEDDING_DIM = 3072
PROXY_URL = "http://127.0.0.1:9000"
CA_BUNDLE = r"C:\Users\m061400\ai-test\cacert.pem"

EMBED_BATCH = 20
EMBED_SLEEP = 2.0
RETRY_COUNT = 5
RETRY_BASE_SECS = 5
CHECKPOINT_EVERY = 25          # batches
MAX_CHARS = 24000              # safety cap, well under the 8191-token model limit
PRICE_PER_M_USD = 0.13         # text-embedding-3-large, for the cost line only

VARIANTS = {
    "name":             ["CTRL_NAME"],
    "name_desc":        ["CTRL_NAME", "CTRL_DESC"],
    "name_desc_detail": ["CTRL_NAME", "CTRL_DESC", "CTRL_DESC_OF_CTRL"],
    "all_text":         ["CTRL_NAME", "CTRL_DESC", "CTRL_DESC_OF_CTRL", "CTRL_EVDNCD", "CTRL_MNTRD"],
}
PROCESS_FIELDS = ["l3_activity_name", "l3_activity_description", "l2_process_name"]

# ---------------------------------------------------------------- cleaning
HTML_RE = re.compile(r"<[^>]+>")
URL_RE = re.compile(r"https?://\S+|www\.\S+")
CTRL_ID_RE = re.compile(r"\bCTL\d{6,}\b")
UUID_RE = re.compile(r"([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})")


def clean(v):
    if not isinstance(v, str) or v.strip().lower() in {"", "nan", "none", "null"}:
        return ""
    t = html.unescape(HTML_RE.sub(" ", v))
    t = URL_RE.sub(" ", t)
    t = CTRL_ID_RE.sub(" ", t)
    return re.sub(r"\s+", " ", t).strip()


def build_texts(df, fields):
    cols = [df[f].map(clean) if f in df.columns else pd.Series([""] * len(df)) for f in fields]
    return ["\n".join(p for p in row if p)[:MAX_CHARS] for row in zip(*cols)]


# ---------------------------------------------------------------- client
def make_client():
    import httpx
    from azure.identity import DefaultAzureCredential, get_bearer_token_provider
    from openai import AzureOpenAI
    token_provider = get_bearer_token_provider(DefaultAzureCredential(), "https://cognitiveservices.azure.com/.default")
    return AzureOpenAI(
        azure_endpoint=AZURE_ENDPOINT, api_version=API_VERSION, azure_ad_token_provider=token_provider,
        http_client=httpx.Client(proxy=PROXY_URL, verify=CA_BUNDLE,
                                 timeout=httpx.Timeout(180.0, connect=30.0),
                                 limits=httpx.Limits(max_keepalive_connections=0, max_connections=1)),
    )


def embed_batch(client_holder, texts):
    for attempt in range(1, RETRY_COUNT + 1):
        try:
            resp = client_holder["client"].embeddings.create(
                model=EMBEDDING_MODEL, input=[t if t else " " for t in texts], dimensions=EMBEDDING_DIM)
            vecs = np.array([d.embedding for d in resp.data], dtype=np.float32)
            return vecs, resp.usage.total_tokens
        except Exception as e:
            wait = RETRY_BASE_SECS * attempt
            print(f"    retry {attempt}/{RETRY_COUNT} after: {type(e).__name__}: {str(e)[:120]}  (sleep {wait}s)")
            time.sleep(wait)
            client_holder["client"] = make_client()     # fresh client, as in the other project scripts
    raise RuntimeError("embedding batch failed after retries")


# ---------------------------------------------------------------- embedding with checkpoints
def embed_table(client_holder, ids, texts, id_col, out_path, label):
    if out_path.exists():
        print(f"  {label}: already complete ({out_path.name})")
        return json.loads(out_path.with_suffix(".meta.json").read_text()) if out_path.with_suffix(".meta.json").exists() else {}
    partial = out_path.with_suffix(".partial.parquet")
    vectors, tokens, start = [], 0, 0
    if partial.exists():
        p = pd.read_parquet(partial)
        vectors = list(p["vector"].values); start = len(p); tokens = int(p.attrs.get("tokens", 0)) if hasattr(p, "attrs") else 0
        print(f"  {label}: resuming from {start}/{len(texts)}")
    t0 = time.time()
    n_batches = 0
    for i in range(start, len(texts), EMBED_BATCH):
        batch = texts[i:i + EMBED_BATCH]
        vecs, used = embed_batch(client_holder, batch)
        vectors.extend(list(vecs)); tokens += used; n_batches += 1
        done = i + len(batch)
        if n_batches % CHECKPOINT_EVERY == 0 or done == len(texts):
            pd.DataFrame({id_col: ids[:done], "text": texts[:done], "vector": vectors}).to_parquet(partial, index=False)
            rate = (done - start) / max(time.time() - t0, 1)
            eta = (len(texts) - done) / max(rate, 1e-6)
            print(f"  {label}: {done}/{len(texts)}  tokens {tokens:,}  eta {eta/60:.0f} min")
        time.sleep(EMBED_SLEEP)
    df = pd.DataFrame({id_col: ids, "text": texts, "vector": vectors})
    df.to_parquet(out_path, index=False)
    partial.unlink(missing_ok=True)
    meta = {"file": out_path.name, "rows": len(df), "model": EMBEDDING_MODEL, "dim": EMBEDDING_DIM,
            "tokens": tokens, "usd": round(tokens / 1e6 * PRICE_PER_M_USD, 3),
            "minutes": round((time.time() - t0) / 60, 1), "finished": datetime.now().isoformat(timespec="seconds")}
    out_path.with_suffix(".meta.json").write_text(json.dumps(meta, indent=2))
    print(f"  {label}: done  {meta}")
    return meta


# ---------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--variants", nargs="*", default=list(VARIANTS))
    ap.add_argument("--skip-processes", action="store_true")
    ap.add_argument("--dry-run", action="store_true", help="build texts and report sizes; no API calls")
    args = ap.parse_args()

    controls = pd.read_excel(DATA_DIR / "juno_controls.xlsx", dtype=str)
    controls.columns = [c.strip() for c in controls.columns]
    controls["CTRL_ID"] = controls["CTRL_ID"].str.strip()
    controls = controls.drop_duplicates("CTRL_ID").reset_index(drop=True)
    ctrl_ids = controls["CTRL_ID"].tolist()

    jobs = []
    for v in args.variants:
        texts = build_texts(controls, VARIANTS[v])
        jobs.append((f"controls_{v}", ctrl_ids, texts, "CTRL_ID", OUT_DIR / f"controls_{v}.parquet"))
    if not args.skip_processes:
        procs = pd.read_excel(DATA_DIR / "holocentric_processes.xlsx", dtype=str)
        procs.columns = [c.strip() for c in procs.columns]
        procs["uuid"] = procs["l3_activity_uuid"].map(lambda s: (UUID_RE.search(s).group(1).upper() if isinstance(s, str) and UUID_RE.search(s) else None))
        procs = procs[procs["uuid"].notna()].drop_duplicates("uuid").reset_index(drop=True)
        jobs.append(("processes", procs["uuid"].tolist(), build_texts(procs, PROCESS_FIELDS), "uuid", OUT_DIR / "processes.parquet"))

    print("\nPLAN")
    total_tokens = 0
    for label, ids, texts, _, path in jobs:
        est = sum(len(t) for t in texts) // 4
        empty = sum(1 for t in texts if not t)
        total_tokens += est
        lengths = pd.Series([len(t) for t in texts])
        print(f"  {label:26s} rows {len(ids):6d}  empty {empty:4d}  median chars {int(lengths.median()):5d}  "
              f"max chars {int(lengths.max()):6d}  ~tokens {est:>9,}  {'cached' if path.exists() else ''}")
    minutes = sum(len(j[2]) for j in jobs if not j[4].exists()) / EMBED_BATCH * (EMBED_SLEEP + 1.0) / 60
    print(f"  total ~{total_tokens:,} tokens  ~${total_tokens/1e6*PRICE_PER_M_USD:.2f} USD  ~{minutes:.0f} min at batch {EMBED_BATCH}")
    if args.dry_run:
        sample = jobs[min(2, len(jobs) - 1)][2][0]
        print("\nSAMPLE TEXT (first control, name_desc_detail or nearest variant):\n" + sample[:800])
        return

    client_holder = {"client": make_client()}
    manifest = {}
    for label, ids, texts, id_col, path in jobs:
        print(f"\n{label}")
        manifest[label] = embed_table(client_holder, ids, texts, id_col, path, label)
    (OUT_DIR / "manifest.json").write_text(json.dumps(manifest, indent=2))
    print(f"\nall done -> {OUT_DIR}")


if __name__ == "__main__":
    main()
