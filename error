MINI_FRAMEWORK_PROMPT = """
Generate a concise decision dictionary for classifying internal controls as
ITDMC or MAC. The dictionary should list 12-15 example scenarios (one per line)
in the format:
  <scenario description> -> <ITDMC or MAC>

