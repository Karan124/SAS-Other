    elif args.ct_range:
        s, e = args.ct_range
        scope_df = scope_df.iloc[s:e].reset_index(drop=True)
        log.info(f"  Range [{s}:{e}]: {len(scope_df):,} scopes")

    log.info("Verifying connectivity...")
    try:
        make_client()
        log.info("  OK.")
    except Exception as e:
        log.error(f"  Failed: {e}")
        sys.exit(1)

    done_p1 = load_checkpoint(ck1_path)
    done_p2 = load_checkpoint(ck2_path)
    done_p1 = {
        key: record for key, record in done_p1.items()
        if record.get("prompt_version") == PROMPT_VERSION
    }
    done_p2 = {
        key: record for key, record in done_p2.items()
        if record.get("prompt_version") == PROMPT_VERSION
    }
    log.info(f"  Pass 1 done keys: {len(done_p1):,}")
    log.info(f"  Pass 2 done keys: {len(done_p2):,}")

    total_in = total_out = 0
    for row_num, sr in enumerate(scope_df.itertuples(index=False), 1):
        scope_id = sr.scope_id
        pct = row_num / len(scope_df) * 100
        cost = ((total_in/1e6*INPUT_PRICE_PER_M +
                 total_out/1e6*OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
        print(f"\r  [{pct:5.1f}%] {scope_id:<30} A${cost:.2f}", end="")

        in_t, out_t = process_scope(
            scope_id, sr, pairs_df, expanded,
            ck1_path, ck2_path, done_p1, done_p2, log)
        total_in  += in_t
        total_out += out_t

    print()
    cost = ((total_in/1e6*INPUT_PRICE_PER_M +
             total_out/1e6*OUTPUT_PRICE_PER_M) / AUD_USD_RATE)
    log.info(f"  Total cost: A${cost:.2f}")

    with open(RUN_CONFIG) as f:
        config = json.load(f)
    config[f"step3{args.suffix}_completed_at"]   = datetime.now().isoformat()
    config[f"step3{args.suffix}_total_cost_aud"] = round(cost, 2)
    with open(RUN_CONFIG, "w") as f:
        json.dump(config, f, indent=2)

    log.info("=" * 70)
    log.info(f"  Step 3 complete. Cost: A${cost:.2f}")
    log.info("  Run 04_postprocess_ct.py next.")
    log.info("=" * 70)

if __name__ == "__main__":
    main()
